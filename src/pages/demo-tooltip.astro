---
// Demo page for PopoverTooltip component
// Shows various tooltip configurations and positions

import PopoverTooltip from "../components/PopoverTooltip.astro";
import Layout from "../layouts/Layout.astro";

const pageTitle = "Popover Tooltip Demo";
const pageDescription =
	"Demonstration of accessible popover tooltips using CSS Anchor Positioning with interestfor and popovertarget.";
---

<Layout title={pageTitle} description={pageDescription}>
	<main
		style="max-width: 640px; margin: 0 auto; padding: 2rem; font-family: var(--font-sans, system-ui, sans-serif); color: var(--ink, #14213d);"
	>
		<h1 style="font-size: var(--fs-title, 26px); margin-bottom: 0.5rem;">Popover Tooltip Demo</h1>
		<p style="color: var(--ink-secondary, #4b5565); margin-bottom: 2rem;">
			Accessible tooltips using CSS Anchor Positioning with the Popover API. Hover or focus the
			triggers below to see them in action.
		</p>

		<!-- Example 1: Basic tooltip on text -->
		<section style="margin-bottom: 2rem;">
			<h2 style="font-size: var(--fs-section, 18px); margin-bottom: 1rem;">1. Basic Tooltip</h2>
			<p style="line-height: 1.6;">
				This is a paragraph with an
				<span style="border-bottom: 1px dashed var(--brand, #e76f51); cursor: help;">
					important term
				</span>
				<!-- Using interestfor for hover-triggered tooltip -->
				<button
					class="tooltip-trigger-inline"
					type="button"
					style="margin-left: 0.25rem; vertical-align: middle; border: none; background: none; color: var(--brand, #e76f51); cursor: help; font-weight: 600; font-size: 0.9em;"
					{...{ interestfor: "tooltip-term" } as Record<string, string>}
					aria-label="Definition of important term"
					aria-describedby="tooltip-term"
				>
					?
				</button>
				that you can hover to learn more about.
			</p>
			<div
				id="tooltip-term"
				{...{ popover: "hint" } as Record<string, string>}
				class="popover-tooltip"
				data-position="block-start"
				role="tooltip"
			>
				<div class="popover-tooltip__content">
					This term refers to a concept that is critical for understanding the broader topic.
				</div>
			</div>
		</section>

		<!-- Example 2: Toggletip with "?" button -->
		<section style="margin-bottom: 2rem;">
			<h2 style="font-size: var(--fs-section, 18px); margin-bottom: 1rem;">
				2. Toggletip (Hover + Click)
			</h2>
			<p style="line-height: 1.6;">
				Shipping cost is calculated at checkout.
				<PopoverTooltip
					id="tooltip-shipping"
					content="Free shipping applies to orders over $50. Orders placed before 2pm ship the same day."
					triggerLabel="More about shipping"
					isToggletip={true}
					position="block-start"
				/>
			</p>
		</section>

		<!-- Example 3: Different positions -->
		<section style="margin-bottom: 2rem;">
			<h2 style="font-size: var(--fs-section, 18px); margin-bottom: 1rem;">3. Position Variants</h2>

			<div style="display: flex; flex-direction: column; gap: 1rem;">
				<div style="display: flex; align-items: center; gap: 0.5rem;">
					<span>Tooltip above:</span>
					<PopoverTooltip
						id="tooltip-above"
						content="This tooltip appears above the trigger."
						triggerLabel="Tooltip above"
						position="block-start"
					/>
				</div>

				<div style="display: flex; align-items: center; gap: 0.5rem;">
					<span>Tooltip below:</span>
					<PopoverTooltip
						id="tooltip-below"
						content="This tooltip appears below the trigger."
						triggerLabel="Tooltip below"
						position="block-end"
					/>
				</div>

				<div style="display: flex; align-items: center; gap: 0.5rem;">
					<span>Tooltip right:</span>
					<PopoverTooltip
						id="tooltip-right"
						content="This tooltip appears to the right of the trigger."
						triggerLabel="Tooltip right"
						position="inline-end"
					/>
				</div>
			</div>
		</section>

		<!-- Example 4: Icon button with tooltip -->
		<section style="margin-bottom: 2rem;">
			<h2 style="font-size: var(--fs-section, 18px); margin-bottom: 1rem;">
				4. Icon Button Tooltip
			</h2>
			<div style="display: flex; gap: 0.5rem; align-items: center;">
				<button
					type="button"
					class="demo-action-btn"
					{...{ interestfor: "tooltip-action" } as Record<string, string>}
					aria-label="Submit form"
				>
					Submit
				</button>
				<div
					id="tooltip-action"
					{...{ popover: "hint" } as Record<string, string>}
					class="popover-tooltip"
					data-position="block-start"
					role="tooltip"
				>
					<div class="popover-tooltip__content">Submit your answers to see your score.</div>
				</div>
			</div>
		</section>

		<!-- Browser support note -->
		<section
			style="
				padding: 1rem;
				background: var(--info-soft, #e8f0fa);
				border: 1px solid var(--info-border, #c5d9f0);
				border-radius: var(--radius, 8px);
				font-size: var(--fs-small, 13px);
				color: var(--ink-secondary, #4b5565);
			"
		>
			<strong>Browser Support:</strong>
			<ul style="margin: 0.5rem 0 0 1.5rem; padding: 0;">
				<li>
					<strong>Popover API:</strong> Baseline since 2025-01-27 (Chrome 116+, Edge 116+, Firefox
					125+, Safari 17+)
				</li>
				<li>
					<strong>CSS Anchor Positioning:</strong> Chrome 157+, Edge 157+, Safari 27+ (not Firefox).
					Falls back to centered placement.
				</li>
				<li>
					<strong>Interest Invokers:</strong> Chrome 149+, Edge 149+ (not Firefox/Safari).
					Polyfilled where unavailable.
				</li>
				<li>
					<strong>popover="hint":</strong> Chrome 151+, Edge 151+, Firefox 153+ (not Safari). Falls
					back to popover="auto" for toggletips.
				</li>
			</ul>
		</section>
	</main>
</Layout>

<style is:global>
/* Demo action button — uses brand-strong for 4.5:1 contrast on white text */
.demo-action-btn {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.5rem 1rem;
	font-size: var(--fs-body, 16px);
	background: var(--brand-strong, #b94d36);
	color: var(--on-brand, #ffffff);
	border: none;
	border-radius: var(--radius, 8px);
	cursor: pointer;
}

/* Inline trigger for text-based tooltips */
.tooltip-trigger-inline {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 1.25rem;
	height: 1.25rem;
	padding: 0;
	font-size: 0.65rem;
	font-weight: 600;
	line-height: 1;
	color: var(--ink-tertiary, #6b7280);
	background: var(--raised, #f0ede6);
	border: 1px solid var(--border, #e1ded7);
	border-radius: var(--radius-full, 9999px);
	cursor: pointer;
	vertical-align: middle;
	margin-left: 0.25rem;
	position: relative;
}

.tooltip-trigger-inline:hover,
.tooltip-trigger-inline:focus-visible {
	color: var(--brand-text, #b94d36);
	background: var(--brand-soft, rgba(231, 111, 81, 0.08));
	border-color: var(--brand, #e76f51);
}
</style>
