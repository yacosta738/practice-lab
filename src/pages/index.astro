---
import { getCollection } from "astro:content";
import { getCertificationList, loadCertification } from "../certifications/index";
import Layout from "../layouts/Layout.astro";
import { base } from "../lib/base";
import { groupNotes, toNoteMeta } from "../lib/study-groups";
import { studyCerts } from "../study/registry";
import "../styles/quiz.css";

const studyEntries = await getCollection("study");
const studyNotes = studyEntries.length;
const studySections = studyCerts.reduce(
	(total, cert) =>
		total +
		groupNotes(
			studyEntries.filter((entry) => entry.id.startsWith(`${cert.slug}/`)).map(toNoteMeta),
			cert.certification.domains,
		).length,
	0,
);

// Load all certifications with their question counts
const certConfigs = await getCertificationList();
const certDetails = await Promise.all(
	certConfigs.map(async (cfg) => {
		const entry = await loadCertification(cfg.slug);
		return {
			config: cfg,
			questionCount: entry?.questions.length ?? 0,
			domainCount: Object.keys(cfg.domains).length,
		};
	}),
);
---

<Layout
	title="Practice Lab"
	description="Prepare for certifications with interactive practice quizzes"
>
	<main id="main-content" tabindex="-1">
		<header>
			<a class="brand" href={base}>
				<div class="mark">P</div>
				<span>
					<strong>Practice Lab</strong>
					<small>Certification Prep</small>
				</span>
			</a>
			<button
				type="button"
				class="ghost"
				data-action="theme"
				aria-label="Theme: toggle light and dark appearance"
			>
				Theme
			</button>
		</header>

		<section class="hero">
			<span class="eyebrow">Certification practice lab</span>
			<h1>Practice with confidence.</h1>
			<p class="lead">
				Interactive quizzes built for real exam readiness. Study by domain, take timed mock exams,
				and track your progress — all offline in your browser.
			</p>
			<div class="ctaRow">
				<a class="primary" href={`${base}certifications/ccdv-f`}>Start practicing</a>
				<a class="ghost ghostOnDark" href="#certifications">See the certifications</a>
				<a class="ghost ghostOnDark" href={`${base}study/`}>Study the notes</a>
			</div>
			<div class="pills">
				<span class="pill">Offline-first</span>
				<span class="pill">Progress tracking</span>
				<span class="pill">Timed mock exams</span>
				<span class="pill">Domain-focused study</span>
			</div>
		</section>

		<section class="section" id="certifications">
			<div class="sectionHead">
				<h2>Available certifications</h2>
				<span class="muted small">{certDetails.length} available</span>
			</div>
			{certDetails.map((detail) => (
				<a class="certCard" href={`${base}certifications/${detail.config.slug}`}>
					<div>
						<span class="num">{detail.config.subtitle}</span>
						<strong>{detail.config.title}</strong>
						<p>
							{detail.questionCount} questions across {detail.domainCount} domains. Timed mock exam
							with {detail.config.totalQuestions} questions.
						</p>
						<span class="certCta">Open the practice lab →</span>
					</div>
					<dl class="certFacts">
						<div>
							<dt>Question bank</dt>
							<dd>{detail.questionCount}</dd>
						</div>
						<div>
							<dt>Exam domains</dt>
							<dd>{detail.domainCount}</dd>
						</div>
						<div>
							<dt>Mock exam</dt>
							<dd>{detail.config.totalQuestions} questions</dd>
						</div>
					</dl>
				</a>
			))}
		</section>

		<section class="section" id="study">
			<div class="sectionHead">
				<h2>Study library</h2>
				<span class="muted small">{studyNotes} notes</span>
			</div>
			<a class="certCard" href={`${base}study/`}>
				<div>
					<span class="num">Study</span>
					<strong>Knowledge base by certification</strong>
					<p>
						Personal study notes with domain ordering, labs, sources and cross-links, built from
						Markdown.
					</p>
					<span class="certCta">Open the study library →</span>
				</div>
				<dl class="certFacts">
					<div>
						<dt>Notes</dt>
						<dd>{studyNotes}</dd>
					</div>
					<div>
						<dt>Sections</dt>
						<dd>{studySections}</dd>
					</div>
					<div>
						<dt>Format</dt>
						<dd>Markdown</dd>
					</div>
				</dl>
			</a>
		</section>

		<footer>Independent study material · Progress stays in your browser</footer>
	</main>
</Layout>
