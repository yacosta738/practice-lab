---
import { getCollection } from "astro:content";
import { getCertificationList, loadCertification } from "../certifications/index";
import AppShell from "../components/AppShell.astro";
import Layout from "../layouts/Layout.astro";
import { base } from "../lib/base";
import { groupNotes, toNoteMeta } from "../lib/study-groups";
import { studyCerts } from "../study/registry";
import "../styles/tokens.css";
import "../styles/quiz.css";

const studyEntries = await getCollection("study");
const studyNotes = studyEntries.length;
const studySlugs = new Set(studyCerts.map((c) => c.slug));

const certConfigs = await getCertificationList();
const certDetails = await Promise.all(
	certConfigs.map(async (cfg) => {
		const entry = await loadCertification(cfg.slug);
		return {
			config: cfg,
			questionCount: entry?.questions.length ?? 0,
			domainCount: Object.keys(cfg.domains).length,
			hasStudyNotes: studySlugs.has(cfg.slug),
		};
	}),
);

const flagship = certDetails.find((c) => c.config.slug === "ccdv-f") ?? certDetails[0];
const flagshipDomains = flagship
	? Object.entries(flagship.config.domains)
			.sort(([, a], [, b]) => b.weight - a.weight)
			.slice(0, 4)
			.map(([id, d]) => ({
				id,
				name: d.name,
				weight: d.weight,
				href: `${base}study/${flagship.config.slug}/#${id}`,
			}))
	: [];

const sidebarDomains = flagship
	? Object.entries(flagship.config.domains).map(([id, d]) => ({
			id,
			name: d.name,
			weight: d.weight,
			href: `${base}study/${flagship.config.slug}/#${id}`,
		}))
	: [];

const totalQuestions = certDetails.reduce((acc, c) => acc + c.questionCount, 0);
const studySections = studyCerts.reduce(
	(total, cert) =>
		total +
		groupNotes(
			studyEntries.filter((entry) => entry.id.startsWith(`${cert.slug}/`)).map(toNoteMeta),
			cert.certification.domains,
		).length,
	0,
);
---

<Layout
	title="Practice Lab | Certification Practice Quizzes & Study Notes"
	description="Prepare for certifications with interactive practice quizzes and structured study notes"
>
	<AppShell
		activeNav="overview"
		activeCertSlug="ccdv-f"
		breadcrumb="Overview"
		domains={sidebarDomains}
	>
		<section class="wsHero">
			<div class="wsHeroTop">
				<div>
					<h1>Practice with confidence.</h1>
					<p class="lead">
						Build knowledge, drill by exam domain, and measure readiness with timed mock exams.
						Progress stays in this browser. Install Practice Lab to reopen cached pages offline;
						pages you haven't visited still need a connection.
					</p>
				</div>
				<div class="wsHeroActions">
					<a class="primary" href={`${base}certifications/ccdv-f`}>Start practicing</a>
					<a class="ghost" href={`${base}study/`}>Study the notes</a>
				</div>
			</div>
			<div class="wsPillarGrid">
				<a class="wsPillar" href={`${base}study/ccdv-f/`}>
					<span class="wsPillarMark" aria-hidden="true">L</span>
					<strong>Learn</strong>
					<p>
						{studyNotes} domain-ordered study notes across {studySections} sections, labs, and
						curated resources.
					</p>
					<span class="wsPillarCta">Open study library →</span>
				</a>
				<a class="wsPillar" href={`${base}certifications/ccdv-f/`}>
					<span class="wsPillarMark" aria-hidden="true">P</span>
					<strong>Practice</strong>
					<p>
						{totalQuestions} source-linked questions with instant rationales and keyboard shortcuts.
					</p>
					<span class="wsPillarCta">Start domain drill →</span>
				</a>
				<a class="wsPillar" href={`${base}certifications/ccdv-f/?mode=assess#session`}>
					<span class="wsPillarMark" aria-hidden="true">A</span>
					<strong>Assess</strong>
					<p>Blueprint-proportioned timed mock exams with flag review and domain diagnostics.</p>
					<span class="wsPillarCta">Launch mock exam →</span>
				</a>
			</div>
		</section>

		<section class="section" id="certifications">
			<div class="sectionHead">
				<h2>Available certifications</h2>
				<span class="muted small">{certDetails.length} tracks · local progress tracking</span>
			</div>
			<div class="wsCertList">
				{certDetails.map((detail) => (
					<a class="wsCertRow" href={`${base}certifications/${detail.config.slug}`}>
						<div class="wsCertMain">
							<div class="wsCertMeta">
								<span class="wsCode">{detail.config.subtitle}</span>
								{detail.hasStudyNotes ? (
									<span class="wsBadgeAccent">{studyNotes} study notes</span>
								) : (
									<span class="wsBadgeMuted">Practice bank</span>
								)}
							</div>
							<strong>{detail.config.title}</strong>
							<p>{detail.config.description}</p>
						</div>
						<dl class="wsCertStats">
							<div>
								<dt>Bank</dt>
								<dd>{detail.questionCount} Qs</dd>
							</div>
							<div>
								<dt>Domains</dt>
								<dd>{detail.domainCount}</dd>
							</div>
							<div>
								<dt>Mock</dt>
								<dd>{detail.config.totalQuestions} Qs</dd>
							</div>
						</dl>
						<span class="wsArrow" aria-hidden="true">
							→
						</span>
					</a>
				))}
			</div>
		</section>

		{flagshipDomains.length > 0 && (
			<section class="section" id="continue">
				<div class="sectionHead">
					<h2>Continue studying — highest exam weight</h2>
					<a class="small wsTextLink" href={`${base}study/ccdv-f/`}>
						View all {studyNotes} notes →
					</a>
				</div>
				<div class="wsCompactList">
					{flagshipDomains.map((d) => (
						<a class="wsCompactRow" href={d.href}>
							<span>
								<strong>{d.id}</strong> · {d.name}
							</span>
							<span class="wsCompactRight">
								<span class="wsCode">{d.weight}% weight</span>
								<span aria-hidden="true">→</span>
							</span>
						</a>
					))}
				</div>
			</section>
		)}
	</AppShell>
</Layout>
