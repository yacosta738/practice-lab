---
import { getCollection } from "astro:content";
import { getCertificationList, loadCertification } from "../../certifications";
import AppShell from "../../components/AppShell.astro";
import Layout from "../../layouts/Layout.astro";
import { base } from "../../lib/base";
import type { ProgressBank } from "../../lib/progress/analytics";
import { computeQuestionRevision } from "../../lib/progress/legacy-migration";
import { groupNotes, toNoteMeta } from "../../lib/study-groups";
import "../../styles/tokens.css";
import "../../styles/quiz.css";

const certifications = await getCertificationList();
const banks: ProgressBank[] = await Promise.all(
	certifications.map(async (certification) => {
		const bank = await loadCertification(certification.slug);
		return {
			certificationId: certification.slug,
			certificationSubtitle: certification.subtitle,
			...(certification.blueprintSource ? { blueprintSource: certification.blueprintSource } : {}),
			questions: (bank?.questions ?? []).map((question) => ({
				certificationId: certification.slug,
				certificationSubtitle: certification.subtitle,
				questionId: question.id,
				domainId: question.domain,
				domainName: certification.domains[question.domain]?.name ?? question.domain,
				revision: computeQuestionRevision(question),
				...(certification.domains[question.domain]?.weight !== undefined
					? { domainWeight: certification.domains[question.domain].weight }
					: {}),
				...(certification.blueprintSource
					? { blueprintSource: certification.blueprintSource }
					: {}),
			})),
		};
	}),
);
const certificationLabels = Object.fromEntries(
	certifications.map((certification) => [
		certification.slug,
		{
			title: certification.title,
			subtitle: certification.subtitle,
			href: `${base}certifications/${certification.slug}/`,
		},
	]),
);
const studyEntries = await getCollection("study");
const studyNotes = certifications.flatMap((certification) => {
	const notes = studyEntries
		.filter((entry) => entry.id.startsWith(`${certification.slug}/`))
		.map(toNoteMeta);
	return groupNotes(notes, certification.domains).flatMap((section) =>
		section.notes.map((note) => ({
			certificationId: certification.slug,
			noteId: note.id,
			aliases: note.aliases,
			revision: note.revision,
			title: note.title,
			href: `${base}study/${certification.slug}/${note.slug}/`,
		})),
	);
});
const flagship = certifications.find((certification) => certification.slug === "ccdv-f");
const sidebarDomains = flagship
	? Object.entries(flagship.domains).map(([id, domain]) => ({
			id,
			name: domain.name,
			weight: domain.weight,
			href: `${base}study/${flagship.slug}/#${id}`,
		}))
	: [];
const clientData = JSON.stringify({ banks, certificationLabels, studyNotes }).replaceAll(
	"<",
	"\\u003c",
);
---

<Layout
	title="My Progress | Practice Lab"
	description="Review certification quiz progress, mock-exam history, saved questions, and performance by exam domain. Your practice data stays private in this browser."
	disableAnalytics={true}
>
	<AppShell
		activeNav="progress"
		activeCertSlug="ccdv-f"
		breadcrumb="My Progress"
		domains={sidebarDomains}
	>
		<div class="progressPage" id="progress-main">
			<header class="progressHeader">
				<div>
					<p class="eyebrow">Personal workspace</p>
					<h1>My Progress</h1>
					<p class="muted">A private, browser-local view of your practice and mock-exam history.</p>
				</div>
				<a class="ghost" href={`${base}certifications/ccdv-f/`}>Start practicing</a>
			</header>

			<p class="progressOffline" id="progress-offline" hidden>
				You are offline. Saved progress is still available in this browser.
			</p>
			<p class="progressStatus" id="progress-status" role="status" aria-live="polite">
				Loading saved progress…
			</p>
			<p
				class="progressImportedNotice"
				id="progress-imported-notice"
				role="status"
				aria-live="polite"
				hidden
			></p>
			<p class="progressError" id="progress-error" role="alert" hidden></p>

			<section class="progressFilters panel" aria-labelledby="history-filters-title">
				<h2 id="history-filters-title">Filter session history</h2>
				<div class="progressFilterGrid">
					<label>
						<span>Certification</span>
						<select id="filter-certification" name="certification">
							<option value="all">All certifications</option>
							{certifications.map((certification) => (
								<option value={certification.slug}>{certification.subtitle}</option>
							))}
						</select>
					</label>
					<label>
						<span>Session type</span>
						<select id="filter-mode" name="mode">
							<option value="all">All types</option>
							<option value="practice">Practice</option>
							<option value="exam">Mock exam</option>
							<option value="weak">Review missed questions</option>
							<option value="review">Spaced review</option>
						</select>
					</label>
					<label>
						<span>Status</span>
						<select id="filter-status" name="status">
							<option value="all">All statuses</option>
							<option value="in_progress">In progress</option>
							<option value="completed">Completed</option>
							<option value="expired">Time expired</option>
							<option value="abandoned">Abandoned</option>
						</select>
					</label>
					<label>
						<span>Started from</span>
						<input id="filter-from" name="from" type="date">
					</label>
					<label>
						<span>Started through</span>
						<input id="filter-through" name="through" type="date">
					</label>
				</div>
			</section>

			<section class="progressMetrics" aria-labelledby="metrics-title">
				<div class="sectionHead">
					<h2 id="metrics-title">At a glance</h2>
					<span class="small muted" id="metric-scope">All certifications</span>
				</div>
				<div class="progressMetricGrid" id="progress-metrics" aria-live="polite"></div>
			</section>

			<section class="panel progressReviewQueue" aria-labelledby="review-queue-title">
				<div class="sectionHead">
					<div>
						<h2 id="review-queue-title">Due review queue</h2>
						<p class="small muted">
							Scheduled from your evaluated attempts using local calendar dates. Normal practice and
							mock exams remain unchanged.
						</p>
					</div>
				</div>
				<div id="review-queue" aria-live="polite"></div>
			</section>

			<div class="progressVisualGrid">
				<section class="panel progressVisual" aria-labelledby="mastery-title">
					<h2 id="mastery-title">Mastery breakdown</h2>
					<div id="mastery-breakdown" aria-live="polite"></div>
				</section>
				<section class="panel progressVisual" aria-labelledby="recommendations-title">
					<h2 id="recommendations-title">Targeted review recommendations</h2>
					<div id="review-recommendations" aria-live="polite"></div>
				</section>
			</div>

			<section class="progressStudy panel" aria-labelledby="study-progress-title">
				<div class="progressStudyHeader">
					<div>
						<h2 id="study-progress-title">Study notes and goals</h2>
						<p class="muted">Reading state, bookmarks, and targets stay in this browser.</p>
					</div>
					<label class="progressStudyCertification" for="study-certification">
						<span>Certification</span>
						<select id="study-certification">
							{certifications.map((certification) => (
								<option value={certification.slug}>{certification.subtitle}</option>
							))}
						</select>
					</label>
				</div>
				<p id="study-progress-status" class="progressStudyStatus" role="status" aria-live="polite">
					Loading study progress…
				</p>
				<p id="study-progress-error" class="progressError" role="alert" hidden></p>
				<div class="progressStudyGrid">
					<div id="study-progress-overview" aria-live="polite"></div>
					<form id="study-goals-form" class="progressStudyGoals">
						<h3>Study goals</h3>
						<label for="study-target-date">Exam target date</label>
						<input id="study-target-date" name="targetDate" type="date">
						<p class="small muted">
							A date-only value in this device’s local calendar; it is not converted to UTC or
							treated as a time.
						</p>
						<label for="study-target-questions">Question target</label>
						<input
							id="study-target-questions"
							name="targetQuestionCount"
							type="number"
							min="0"
							max="1000000"
							step="1"
							inputmode="numeric"
						>
						<label for="study-target-notes">Completed-note target</label>
						<input
							id="study-target-notes"
							name="targetNoteCount"
							type="number"
							min="0"
							max="1000000"
							step="1"
							inputmode="numeric"
						>
						<p id="study-legacy-date-notice" class="small muted" hidden></p>
						<div class="progressStudyActions">
							<button class="primary" type="submit">Save goals</button>
						</div>
						<p id="study-goals-status" class="small muted" role="status" aria-live="polite"></p>
					</form>
				</div>
				<p class="progressStudyPrivacy">
					Bookmarks, completion, reading anchors, and goals are browser-local and are not sent to
					analytics.
				</p>
			</section>

			<details class="progressDefinitions panel">
				<summary>How these metrics are calculated</summary>
				<ul>
					<li>
						<strong>Coverage</strong> is distinct current-bank questions with a recorded evaluation
						or imported legacy attempt, divided by eligible questions in the selected certification
						bank.
					</li>
					<li>
						<strong>Overall accuracy</strong> is correct recorded evaluations plus imported legacy
						correct answers, divided by all recorded evaluations plus imported legacy attempts.
					</li>
					<li>
						<strong>Recent accuracy</strong> uses the latest 10 recorded evaluations by evaluation
						time; legacy totals have no timestamps and are excluded.
					</li>
					<li>
						<strong>Completed mock exams</strong> counts exam sessions with completed status;
						expired or abandoned exams are not counted as completed.
					</li>
					<li>
						<strong>Last result</strong> is the most recently finished session; its score is correct
						answers divided by the session's frozen question count, including unanswered questions.
					</li>
					<li>
						<strong>Domain metrics</strong> report coverage, overall accuracy, recent accuracy
						(within the latest 10 timestamped evaluations), and mastery counts separately with
						sample sizes. Domains with fewer than 3 attempts are marked as insufficient evidence and
						are not ranked as worst accuracy.
					</li>
					<li>
						<strong>Mastery states (<code>mastery-v1</code>)</strong> are derived deterministically
						from chronological recorded attempts: <strong>New</strong> (no evaluated evidence),
						<strong>Learning</strong> (some evidence, a recent miss, a material question revision,
						or undated legacy totals only), <strong>Proficient</strong> (at least 2 consecutive
						correct evaluations across distinct sessions on the current revision), and
						<strong>Mastered</strong>
						(at least 3 consecutive correct evaluations across distinct sessions spanning at least
						24 hours).
					</li>
					<li>
						<strong>Demotion, revisions &amp; staleness</strong>: wrong or partial answers reset a
						question to <strong>Learning</strong>. Material question revisions require
						re-verification on the current revision while keeping historical session scores
						unchanged. Proficient or mastered questions not verified within 14 days are flagged as
						stale for review.
					</li>
					<li>
						<strong>Recommendations &amp; weighting</strong>: recommendations prioritize recently
						missed questions, updated questions, weak domains (below 75% accuracy with at least 3
						attempts), stale knowledge, and unseen domains. Official exam blueprint weights are used
						only where explicitly labeled; local practice evidence does not predict official exam
						pass probability.
					</li>
					<li>
						<strong>Review scheduling (<code>review-v1</code>)</strong> uses a transparent
						fixed-step interval ladder (1, 3, 7, 14, and 30 days max) based on actual evaluated
						attempts. Incorrect or partial answers reset the interval to 1 day. Due dates are stored
						as floating local calendar dates (<code>YYYY-MM-DD</code>) so daylight-saving shifts and
						travel do not drift schedules. Skipped questions are not evaluated and do not advance
						intervals; undated legacy totals do not fabricate due dates; materially revised
						questions are queued for re-verification.
					</li>
					<li>
						<strong>Exam trend</strong> includes completed and expired mock exams; unanswered
						questions remain in the denominator. Revision and question count are shown so different
						banks are not mistaken for a like-for-like comparison.
					</li>
					<li>
						History is sorted by start time (newest first; session ID breaks ties), filtered by
						start date, and paginated 20 sessions at a time. Imported legacy attempts are an undated
						baseline.
					</li>
				</ul>
			</details>

			<div class="progressVisualGrid">
				<section class="panel progressVisual" aria-labelledby="domains-title">
					<h2 id="domains-title">Domain coverage, accuracy &amp; mastery</h2>
					<div id="domain-chart"></div>
				</section>
				<section class="panel progressVisual" aria-labelledby="trend-title">
					<h2 id="trend-title">Mock-exam performance</h2>
					<div id="exam-trend"></div>
				</section>
			</div>

			<section class="panel progressHistory" aria-labelledby="history-title">
				<div class="sectionHead">
					<div>
						<h2 id="history-title">Session history</h2>
						<p class="small muted" id="history-count">Showing recent saved sessions.</p>
					</div>
				</div>
				<div class="progressTableWrap">
					<table>
						<caption class="visuallyHidden">
							Saved practice and mock-exam sessions
						</caption>
						<thead>
							<tr>
								<th scope="col">Started</th>
								<th scope="col">Certification</th>
								<th scope="col">Type</th>
								<th scope="col">Status</th>
								<th scope="col">Result</th>
								<th scope="col">Duration</th>
								<th scope="col"><span class="visuallyHidden">Review</span></th>
							</tr>
						</thead>
						<tbody id="history-rows"></tbody>
					</table>
				</div>
				<nav class="progressPagination" aria-label="Session history pages">
					<button class="ghost" id="history-previous" type="button">Previous</button>
					<span id="history-page" aria-live="polite">Page 1</span>
					<button class="ghost" id="history-next" type="button">Next</button>
				</nav>
			</section>
		</div>
	</AppShell>
</Layout>

<script type="application/json" id="progress-client-data" set:html={clientData}></script>

<script>
import { base } from "../../lib/base";
import type { ProgressBank } from "../../lib/progress/analytics";
import { deriveProgressSummary } from "../../lib/progress/analytics";
import { createProgressRepository } from "../../lib/progress/indexeddb-repository";
import type { SessionMode, SessionStatus } from "../../lib/progress/model";
import type { SessionHistoryPage, SessionHistoryQuery } from "../../lib/progress/repository-port";
import { createProgressUseCases } from "../../lib/progress/use-cases";

interface DashboardData {
	banks: ProgressBank[];
	certificationLabels: Record<string, { title: string; subtitle: string; href: string }>;
}

const dataElement = document.getElementById("progress-client-data");
const data = JSON.parse(dataElement?.textContent || "{}") as DashboardData;
const PAGE_SIZE = 20;
const repository = createProgressRepository();
const useCases = createProgressUseCases(repository);
const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
const certificationFilter = byId<HTMLSelectElement>("filter-certification");
const modeFilter = byId<HTMLSelectElement>("filter-mode");
const statusFilter = byId<HTMLSelectElement>("filter-status");
const fromFilter = byId<HTMLInputElement>("filter-from");
const throughFilter = byId<HTMLInputElement>("filter-through");
const statusMessage = byId<HTMLParagraphElement>("progress-status");
const errorMessage = byId<HTMLParagraphElement>("progress-error");
let currentPage = Number(new URLSearchParams(location.search).get("page")) || 1;
let loadSequence = 0;

function escapeHtml(value: string): string {
	return value.replace(/[&<>"']/g, (character) => {
		const entities: Record<string, string> = {
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			'"': "&quot;",
			"'": "&#39;",
		};
		return entities[character];
	});
}

function formatDate(timestamp: number): string {
	return new Intl.DateTimeFormat(undefined, {
		dateStyle: "medium",
		timeStyle: "short",
	}).format(timestamp);
}

function formatDuration(startedAt: number, finishedAt?: number): string {
	const seconds = Math.max(0, Math.floor(((finishedAt ?? Date.now()) - startedAt) / 1000));
	const minutes = Math.floor(seconds / 60);
	return minutes < 60 ? `${minutes} min` : `${Math.floor(minutes / 60)} hr ${minutes % 60} min`;
}

function percentage(correct: number, attempts: number): number | undefined {
	return attempts ? Math.round((correct / attempts) * 100) : undefined;
}

function formatAccuracy(correct: number, attempts: number): string {
	const rate = percentage(correct, attempts);
	return rate === undefined ? "No attempts" : `${rate}% · ${correct}/${attempts}`;
}

function getSelectedBanks(): ProgressBank[] {
	const selected = certificationFilter.value;
	return selected === "all"
		? data.banks
		: data.banks.filter((bank) => bank.certificationId === selected);
}

function getHistoryQuery(): SessionHistoryQuery {
	const query: SessionHistoryQuery = { page: currentPage, pageSize: PAGE_SIZE };
	if (certificationFilter.value !== "all") query.certificationId = certificationFilter.value;
	if (modeFilter.value !== "all") query.mode = modeFilter.value as SessionMode;
	if (statusFilter.value !== "all") query.status = statusFilter.value as SessionStatus;
	if (fromFilter.value) query.from = new Date(`${fromFilter.value}T00:00:00`).getTime();
	if (throughFilter.value)
		query.through = new Date(`${throughFilter.value}T23:59:59.999`).getTime();
	return query;
}

function updateUrl(): void {
	const params = new URLSearchParams();
	if (certificationFilter.value !== "all") params.set("certification", certificationFilter.value);
	if (modeFilter.value !== "all") params.set("mode", modeFilter.value);
	if (statusFilter.value !== "all") params.set("status", statusFilter.value);
	if (fromFilter.value) params.set("from", fromFilter.value);
	if (throughFilter.value) params.set("through", throughFilter.value);
	if (currentPage > 1) params.set("page", String(currentPage));
	const query = params.toString();
	history.replaceState(null, "", `${location.pathname}${query ? `?${query}` : ""}`);
}

function renderMetrics(
	summary: ReturnType<typeof deriveProgressSummary>,
	banks: ProgressBank[],
	hasSessions: boolean,
): void {
	const accuracy = percentage(summary.accuracy.correct, summary.accuracy.attempts);
	const recent = percentage(summary.recentAccuracy.correct, summary.recentAccuracy.attempts);
	const coverage = percentage(summary.coverage.evaluated, summary.coverage.eligible);
	const lastResult = summary.lastResult;
	const labels = data.certificationLabels;
	byId("metric-scope").textContent =
		banks.length === data.banks.length
			? "All certifications"
			: (labels[banks[0]?.certificationId]?.subtitle ?? "Selected certification");
	const importedNotice = byId<HTMLParagraphElement>("progress-imported-notice");
	if (summary.legacy.attempts > 0 && !hasSessions) {
		importedNotice.textContent =
			"Imported progress totals have no dated session history. No session rows or dates were created from the import.";
		importedNotice.hidden = false;
	} else {
		importedNotice.hidden = true;
	}
	const masteredPct = percentage(summary.mastery.mastered, summary.mastery.total);
	byId("progress-metrics").innerHTML = `
			<article class="progressMetric panel"><h3>Bank coverage</h3><strong>${coverage ?? 0}%</strong><p>${summary.coverage.evaluated} of ${summary.coverage.eligible} questions evaluated</p></article>
			<article class="progressMetric panel"><h3>Overall accuracy</h3><strong>${accuracy === undefined ? "—" : `${accuracy}%`}</strong><p>${summary.accuracy.correct} correct of ${summary.accuracy.attempts} attempts</p></article>
			<article class="progressMetric panel"><h3>Recent accuracy</h3><strong>${recent === undefined ? "—" : `${recent}%`}</strong><p>${summary.recentAccuracy.correct} correct of ${summary.recentAccuracy.attempts} recent attempts</p></article>
			<article class="progressMetric panel"><h3>Completed mock exams</h3><strong>${summary.completedMockExams}</strong><p>Completed exam sessions</p></article>
			<article class="progressMetric panel"><h3>Last result</h3><strong>${lastResult ? `${lastResult.correct}/${lastResult.questions}` : "—"}</strong><p>${lastResult ? `${escapeHtml(labels[lastResult.certificationId]?.subtitle ?? lastResult.certificationId)} · ${formatDate(lastResult.finishedAt)}` : "No finished sessions yet"}</p></article>
			<article class="progressMetric panel"><h3>Durable mastery</h3><strong>${masteredPct ?? 0}%</strong><p>${summary.mastery.mastered} mastered · ${summary.mastery.proficient} proficient of ${summary.mastery.total}</p></article>
		`;
}

function renderReviewQueue(summary: ReturnType<typeof deriveProgressSummary>): void {
	const container = byId<HTMLDivElement>("review-queue");
	const queue = summary.reviewQueue;
	const counts = queue.counts;
	const stepsLabel = queue.policy.successIntervalsDays.join(", ");
	const caption = `<p class="small muted progressPolicyCaption">Policy <code>${escapeHtml(queue.policy.version)}</code> · Intervals: ${stepsLabel} days (max ${queue.policy.maxIntervalDays}d) · Local date: ${escapeHtml(queue.today)} · Browser-local only (no notifications or cloud sync).</p>`;
	const summaryPills = `<div class="reviewQueueStats" role="list" aria-label="Review queue counts">
		<div class="reviewQueueStat" role="listitem"><strong>${counts.dueNow}</strong><span>Due now</span></div>
		<div class="reviewQueueStat" role="listitem"><strong>${counts.overdue}</strong><span>Overdue</span></div>
		<div class="reviewQueueStat" role="listitem"><strong>${counts.dueToday}</strong><span>Due today</span></div>
		<div class="reviewQueueStat" role="listitem"><strong>${counts.revisionChanged}</strong><span>Updated</span></div>
		<div class="reviewQueueStat" role="listitem"><strong>${counts.upcoming}</strong><span>Upcoming</span></div>
	</div>`;

	if (counts.dueNow === 0) {
		const emptyMessage =
			counts.upcoming > 0 && queue.nextDueDate
				? `No questions are due for review today. ${counts.upcoming} ${counts.upcoming === 1 ? "question is" : "questions are"} scheduled next, starting ${queue.nextDueDate}.`
				: counts.legacyOnly > 0
					? "No scheduled reviews yet. Imported legacy totals do not include evaluation dates; answer questions to build a review schedule."
					: "No questions are due for review right now. Complete a practice session or mock exam to schedule future reviews.";
		container.innerHTML = `${caption}${summaryPills}<p class="muted reviewQueueEmpty">${escapeHtml(emptyMessage)}</p>`;
		return;
	}

	const cards = queue.byCertification
		.filter((cert) => cert.counts.dueNow > 0)
		.map((cert) => {
			const certSlug = encodeURIComponent(cert.certificationId);
			const defaultAmount = Math.min(10, cert.counts.dueNow);
			const amountOptions = [5, 10, 20]
				.filter((n) => n < cert.counts.dueNow)
				.map(
					(n) =>
						`<option value="${n}" ${n === defaultAmount ? "selected" : ""}>${n} questions</option>`,
				);
			amountOptions.push(
				`<option value="${cert.counts.dueNow}" ${defaultAmount === cert.counts.dueNow ? "selected" : ""}>All due (${cert.counts.dueNow})</option>`,
			);
			const topReasons = cert.dueItems
				.slice(0, 3)
				.map(
					(item) =>
						`<li><span class="progressStatusTag">${escapeHtml(item.domainId)}</span> <span>${escapeHtml(item.reason)}</span></li>`,
				)
				.join("");
			const remaining = cert.dueItems.length - 3;
			const startHref = `${base}certifications/${certSlug}/?mode=review&amount=${defaultAmount}#review-queue`;
			const selectId = `review-count-${cert.certificationId.replace(/[^a-z0-9_-]/gi, "-")}`;
			return `<article class="reviewQueueCard">
				<div class="reviewQueueCardHead">
					<div>
						<h3>${escapeHtml(cert.certificationSubtitle)}</h3>
						<p class="small muted">${cert.counts.dueNow} due · ${cert.counts.overdue} overdue · ${cert.counts.dueToday} due today${cert.counts.revisionChanged ? ` · ${cert.counts.revisionChanged} updated` : ""}</p>
					</div>
					<div class="reviewQueueControls">
						<label class="small" for="${selectId}"><span>Questions</span>
							<select id="${selectId}" class="reviewQueueCountSelect" data-review-cert="${escapeHtml(cert.certificationId)}">${amountOptions.join("")}</select>
						</label>
						<a class="primary reviewQueueStartLink" data-review-start="${escapeHtml(cert.certificationId)}" href="${escapeHtml(startHref)}">Start review</a>
					</div>
				</div>
				<ul class="reviewQueueReasons">${topReasons}${remaining > 0 ? `<li class="small muted">+ ${remaining} more ${remaining === 1 ? "question" : "questions"} in queue</li>` : ""}</ul>
			</article>`;
		})
		.join("");

	container.innerHTML = `${caption}${summaryPills}<div class="reviewQueueCards">${cards}</div>`;
	for (const select of container.querySelectorAll<HTMLSelectElement>(".reviewQueueCountSelect")) {
		select.addEventListener("change", () => {
			const certId = select.dataset.reviewCert;
			if (!certId) return;
			const link = container.querySelector<HTMLAnchorElement>(
				`a[data-review-start="${CSS.escape(certId)}"]`,
			);
			if (!link) return;
			const certSlug = encodeURIComponent(certId);
			link.href = `${base}certifications/${certSlug}/?mode=review&amount=${encodeURIComponent(select.value)}#review-queue`;
		});
	}
}

function renderMasteryBreakdown(summary: ReturnType<typeof deriveProgressSummary>): void {
	const container = byId<HTMLDivElement>("mastery-breakdown");
	const m = summary.mastery;
	if (m.total === 0) {
		container.innerHTML = '<p class="muted">No eligible questions in the selected bank.</p>';
		return;
	}
	const notes: string[] = [];
	if (m.stale > 0) {
		notes.push(
			`${m.stale} proficient or mastered ${m.stale === 1 ? "question is" : "questions are"} due for a 14-day refresh.`,
		);
	}
	if (m.revisionChanged > 0) {
		notes.push(
			`${m.revisionChanged} ${m.revisionChanged === 1 ? "question was" : "questions were"} materially revised since your last attempt.`,
		);
	}
	if (m.legacyOnly > 0) {
		notes.push(
			`${m.legacyOnly} ${m.legacyOnly === 1 ? "question has" : "questions have"} undated legacy totals only (counted as Learning, not Proficient or Mastered).`,
		);
	}
	const rows = [
		{
			label: "Mastered",
			count: m.mastered,
			detail: `≥ ${summary.policy.masteredMinSessions} distinct sessions, ≥ 24h spacing`,
		},
		{
			label: "Proficient",
			count: m.proficient,
			detail: `≥ ${summary.policy.proficientMinSessions} distinct sessions on current revision`,
		},
		{
			label: "Learning",
			count: m.learning,
			detail: "Evaluated, missed, revised, or legacy-only evidence",
		},
		{
			label: "New",
			count: m.new,
			detail: "No evaluated evidence yet",
		},
	];
	container.innerHTML = `
		<p class="small muted progressPolicyCaption">Policy <code>${escapeHtml(summary.policy.version)}</code> · Local practice evidence only (not an exam-pass prediction).</p>
		<ul class="progressMasteryList">
			${rows
				.map((row) => {
					const pct = percentage(row.count, m.total) ?? 0;
					return `<li><div class="progressBarHeading"><span><strong>${row.label}</strong> · ${escapeHtml(row.detail)}</span><strong>${row.count}/${m.total} (${pct}%)</strong></div><progress max="${Math.max(1, m.total)}" value="${row.count}" aria-label="${row.label}: ${row.count} of ${m.total} questions (${pct}%)"></progress></li>`;
				})
				.join("")}
		</ul>
		${notes.length ? `<ul class="progressMasteryNotes">${notes.map((note) => `<li>${escapeHtml(note)}</li>`).join("")}</ul>` : ""}
	`;
}

function categoryLabel(
	category: ReturnType<typeof deriveProgressSummary>["recommendations"][number]["category"],
): string {
	return {
		"recently-missed": "Recently missed",
		"revision-changed": "Updated question",
		"weak-domain": "Weak domain",
		"stale-knowledge": "Stale knowledge",
		"unseen-questions": "Unseen questions",
	}[category];
}

function renderRecommendations(summary: ReturnType<typeof deriveProgressSummary>): void {
	const container = byId<HTMLDivElement>("review-recommendations");
	if (!summary.recommendations.length) {
		container.innerHTML =
			'<p class="muted">No targeted review items right now. All eligible questions have current mastery evidence.</p>';
		return;
	}
	container.innerHTML = `<ol class="progressRecommendationList">${summary.recommendations
		.map((rec) => {
			const studyLink = rec.studyHref
				? `<a href="${escapeHtml(rec.studyHref)}">${escapeHtml(rec.studyLabel ?? "Study notes")}</a>`
				: "";
			return `<li class="progressRecommendationItem"><div class="progressRecommendationHead"><span class="progressStatusTag">${escapeHtml(categoryLabel(rec.category))}</span><span class="small muted">Sample: ${rec.sampleSize}</span></div><h3>${escapeHtml(rec.title)}</h3><p class="small muted">${escapeHtml(rec.reason)}</p><div class="progressDomainLinks"><a href="${escapeHtml(rec.practiceHref)}">${escapeHtml(rec.practiceLabel)}</a>${studyLink}</div></li>`;
		})
		.join("")}</ol>`;
}

function renderDomainChart(summary: ReturnType<typeof deriveProgressSummary>): void {
	const container = byId<HTMLDivElement>("domain-chart");
	if (!summary.domains.length) {
		container.innerHTML =
			'<p class="muted">Domain coverage, accuracy, and mastery will appear after your first evaluated answer.</p>';
		return;
	}
	const visibleDomains =
		certificationFilter.value === "all" ? summary.domains : summary.domainBreakdown;
	container.innerHTML = `<ul class="progressBarList">${visibleDomains
		.map((domain) => {
			const correct = "accuracy" in domain ? domain.accuracy.correct : domain.correct;
			const attempts = "accuracy" in domain ? domain.accuracy.attempts : domain.attempts;
			const rate = percentage(correct, attempts) ?? 0;
			const certification = escapeHtml(domain.certificationSubtitle);
			const certificationId = encodeURIComponent(domain.certificationId);
			const domainId = encodeURIComponent(domain.domainId);
			const name = escapeHtml(domain.domainName);
			const studyUrl = `${base}study/${certificationId}/#${domainId}`;
			const practiceUrl = `${base}certifications/${certificationId}/?mode=practice&domain=${domainId}#session`;
			const weightLabel =
				domain.examWeight !== undefined && domain.blueprintSource === "official"
					? ` · Official exam weight ${domain.examWeight}%`
					: domain.examWeight !== undefined && domain.blueprintSource === "derived"
						? ` · Bank share ${domain.examWeight}%`
						: "";
			const recentText =
				domain.recentAccuracy.attempts > 0
					? `Recent: ${formatAccuracy(domain.recentAccuracy.correct, domain.recentAccuracy.attempts)}`
					: "Recent: none in last 10";
			const evidenceTag = domain.hasSufficientEvidence
				? ""
				: ` · Insufficient evidence (< ${summary.policy.weakDomainMinAttempts} attempts)`;
			const detailLine = `Coverage: ${domain.coverage.evaluated}/${domain.coverage.eligible} · ${recentText} · Mastery: ${domain.mastery.mastered} mastered, ${domain.mastery.proficient} proficient, ${domain.mastery.learning} learning, ${domain.mastery.new} new${evidenceTag}`;
			return `<li><div class="progressBarHeading"><span>${certification} · ${escapeHtml(domain.domainId)} ${name}${escapeHtml(weightLabel)}</span><strong>${formatAccuracy(correct, attempts)}</strong></div><p class="small muted progressDomainMeta">${escapeHtml(detailLine)}</p><div class="progressDomainLinks"><a href="${escapeHtml(studyUrl)}" aria-label="Study section for ${certification} ${escapeHtml(domain.domainId)}">Study section</a><a href="${escapeHtml(practiceUrl)}" aria-label="Practice domain for ${certification} ${escapeHtml(domain.domainId)}">Practice domain</a></div><progress max="100" value="${rate}" aria-label="${certification}, ${escapeHtml(domain.domainId)} ${name}: ${attempts ? `${rate}% accuracy` : "no attempts yet"}"></progress></li>`;
		})
		.join("")}</ul>`;
}

function renderExamTrend(summary: ReturnType<typeof deriveProgressSummary>): void {
	const container = byId<HTMLDivElement>("exam-trend");
	if (!summary.examTrend.length) {
		container.innerHTML = '<p class="muted">Completed or expired mock exams will appear here.</p>';
		return;
	}
	const groups = new Map<string, typeof summary.examTrend>();
	for (const point of summary.examTrend) {
		const key = `${point.certificationId}:${point.bankRevision}:${point.questions}`;
		groups.set(key, [...(groups.get(key) ?? []), point]);
	}
	container.innerHTML = [...groups.values()]
		.map((points) => {
			const first = points[0];
			const title = `${data.certificationLabels[first.certificationId]?.subtitle ?? first.certificationId} · revision ${escapeHtml(first.bankRevision.slice(0, 16))} · ${first.questions} questions`;
			const rows = points
				.map((point) => {
					const rate = percentage(point.correct, point.questions) ?? 0;
					const label = `${formatDate(point.finishedAt)}: ${point.correct} of ${point.questions} correct (${rate}%)`;
					return `<li><span>${formatDate(point.finishedAt)}</span><meter min="0" max="100" value="${rate}" aria-label="${escapeHtml(label)}">${rate}%</meter><strong>${rate}%</strong></li>`;
				})
				.join("");
			return `<section class="progressTrendGroup"><h3>${title}</h3><ol>${rows}</ol></section>`;
		})
		.join("");
}

function statusLabel(status: SessionStatus): string {
	return {
		in_progress: "In progress",
		completed: "Completed",
		expired: "Time expired",
		abandoned: "Abandoned",
	}[status];
}

function renderHistory(page: SessionHistoryPage): void {
	const tbody = byId<HTMLTableSectionElement>("history-rows");
	byId("history-count").textContent = page.total
		? `Showing ${Math.min((page.page - 1) * page.pageSize + 1, page.total)}–${Math.min(page.page * page.pageSize, page.total)} of ${page.total} sessions.`
		: "No sessions match these filters.";
	byId("history-page").textContent =
		`Page ${page.page} of ${Math.max(1, Math.ceil(page.total / page.pageSize))}`;
	byId<HTMLButtonElement>("history-previous").disabled = page.page <= 1;
	byId<HTMLButtonElement>("history-next").disabled = page.page * page.pageSize >= page.total;
	if (!page.entries.length) {
		tbody.innerHTML =
			'<tr><td class="progressEmpty" colspan="7">No saved sessions yet. Choose a certification and start a practice session.</td></tr>';
		return;
	}
	tbody.innerHTML = page.entries
		.map(({ session, attempts }) => {
			const label = data.certificationLabels[session.certificationId];
			const questions = session.content.questions.length;
			const correct = attempts.filter((attempt) => attempt.outcome === "correct").length;
			const finishedAt = session.finishedAt;
			const duration = formatDuration(session.startedAt, finishedAt);
			const result = session.status === "in_progress" ? "—" : `${correct}/${questions}`;
			const isActive = session.status === "in_progress";
			const actionLabel = isActive ? "Resume" : "Review";
			const actionUrl = isActive
				? `${label?.href ?? `${base}certifications/${encodeURIComponent(session.certificationId)}/`}?mode=${session.mode === "exam" ? "assess" : session.mode === "review" ? "review" : "practice"}&resume=1`
				: `${base}progress/session/?session=${encodeURIComponent(session.id)}`;
			const modeLabel =
				session.mode === "exam"
					? "Mock exam"
					: session.mode === "weak"
						? "Missed questions"
						: session.mode === "review"
							? "Spaced review"
							: "Practice";
			return `<tr><td>${formatDate(session.startedAt)}</td><td>${escapeHtml(label?.subtitle ?? session.certificationId)}</td><td>${modeLabel}</td><td><span class="progressStatusTag">${statusLabel(session.status)}</span></td><td>${result}</td><td>${duration}</td><td><a href="${actionUrl}" aria-label="${actionLabel} saved ${session.mode} session from ${formatDate(session.startedAt)}">${actionLabel}</a></td></tr>`;
		})
		.join("");
}

async function load(): Promise<void> {
	const sequence = ++loadSequence;
	statusMessage.textContent = "Loading saved progress…";
	errorMessage.hidden = true;
	try {
		const selectedBanks = getSelectedBanks();
		const [summaryData, historyPage] = await Promise.all([
			useCases.getProgressSummaryData(selectedBanks.map((bank) => bank.certificationId)),
			useCases.getSessionHistoryPage(getHistoryQuery()),
		]);
		if (sequence !== loadSequence) return;
		const summary = deriveProgressSummary(
			selectedBanks,
			summaryData.history,
			summaryData.questionProgress,
			summaryData,
			{ basePath: base },
		);
		renderMetrics(summary, selectedBanks, summaryData.hasSessions);
		renderReviewQueue(summary);
		renderMasteryBreakdown(summary);
		renderRecommendations(summary);
		renderDomainChart(summary);
		renderExamTrend(summary);
		renderHistory(historyPage);
		statusMessage.textContent = "Saved progress is up to date.";
		updateUrl();
	} catch (error) {
		if (sequence !== loadSequence) return;
		statusMessage.textContent = "Progress could not be loaded.";
		errorMessage.textContent =
			error instanceof Error
				? `${error.message} Your quiz data remains in this browser; check storage availability and try again.`
				: "Browser storage is unavailable. Your quiz data remains in this browser.";
		errorMessage.hidden = false;
	}
}

let historyLoadTimer: number | undefined;

function scheduleLoad(): void {
	if (historyLoadTimer !== undefined) window.clearTimeout(historyLoadTimer);
	historyLoadTimer = window.setTimeout(() => {
		historyLoadTimer = undefined;
		void load();
	}, 100);
}

function applyQueryToFilters(): void {
	const params = new URLSearchParams(location.search);
	const certification = params.get("certification");
	if (certification && data.banks.some((bank) => bank.certificationId === certification)) {
		certificationFilter.value = certification;
	}
	const mode = params.get("mode");
	if (mode && ["practice", "exam", "weak", "review"].includes(mode)) modeFilter.value = mode;
	const status = params.get("status");
	if (status && ["in_progress", "completed", "expired", "abandoned"].includes(status)) {
		statusFilter.value = status;
	}
	fromFilter.value = params.get("from") ?? "";
	throughFilter.value = params.get("through") ?? "";
	currentPage = Math.max(1, Number(params.get("page")) || 1);
}

for (const filter of [certificationFilter, modeFilter, statusFilter, fromFilter, throughFilter]) {
	filter.addEventListener("change", () => {
		currentPage = 1;
		scheduleLoad();
	});
}
byId("history-previous").addEventListener("click", () => {
	currentPage = Math.max(1, currentPage - 1);
	void load();
});
byId("history-next").addEventListener("click", () => {
	currentPage += 1;
	void load();
});
window.addEventListener("popstate", () => {
	applyQueryToFilters();
	void load();
});
window.addEventListener("online", () => byId("progress-offline").setAttribute("hidden", ""));
window.addEventListener("offline", () => byId("progress-offline").removeAttribute("hidden"));
window.addEventListener("storage", (event) => {
	if (event.key?.includes("practice-lab-v2")) scheduleLoad();
});
let progressChannel: BroadcastChannel | undefined;

function setupProgressChannel(): void {
	if (typeof BroadcastChannel === "undefined" || progressChannel) return;
	progressChannel = new BroadcastChannel("practice-lab-progress");
	progressChannel.addEventListener("message", (event: MessageEvent<unknown>) => {
		const message = event.data as { type?: unknown; certificationId?: unknown } | null;
		if (
			message?.type === "progress-changed" &&
			typeof message.certificationId === "string" &&
			(certificationFilter.value === "all" || certificationFilter.value === message.certificationId)
		) {
			scheduleLoad();
		}
	});
}

window.addEventListener("pagehide", () => {
	if (historyLoadTimer !== undefined) window.clearTimeout(historyLoadTimer);
	progressChannel?.close();
	progressChannel = undefined;
});
window.addEventListener("pageshow", (event) => {
	if (!event.persisted) return;
	setupProgressChannel();
	void load();
});
setupProgressChannel();
if (!navigator.onLine) byId("progress-offline").removeAttribute("hidden");
applyQueryToFilters();
void load();
</script>

<script>
import type { ProgressBank } from "../../lib/progress/analytics";
import { createProgressRepository } from "../../lib/progress/indexeddb-repository";
import type { LearningGoalRecord, StudyProgressRecord } from "../../lib/progress/model";
import {
	getStudyStatus,
	resolveStudyRecord,
	type StudyNoteReference,
	summarizeStudyProgress,
} from "../../lib/progress/study-domain";
import { StudyProgressService } from "../../lib/progress/study-service";

interface DashboardStudyNote extends StudyNoteReference {
	title: string;
	href: string;
}

interface StudyDashboardData {
	banks: ProgressBank[];
	studyNotes: DashboardStudyNote[];
}

const data = JSON.parse(
	document.getElementById("progress-client-data")?.textContent ?? "{}",
) as StudyDashboardData;
const repository = createProgressRepository();
const service = new StudyProgressService(repository);
const certificationSelect = document.getElementById("study-certification") as HTMLSelectElement;
const status = document.getElementById("study-progress-status") as HTMLParagraphElement;
const error = document.getElementById("study-progress-error") as HTMLParagraphElement;
const overview = document.getElementById("study-progress-overview") as HTMLDivElement;
const goalForm = document.getElementById("study-goals-form") as HTMLFormElement;
const targetDate = document.getElementById("study-target-date") as HTMLInputElement;
const targetQuestions = document.getElementById("study-target-questions") as HTMLInputElement;
const targetNotes = document.getElementById("study-target-notes") as HTMLInputElement;
const legacyDateNotice = document.getElementById(
	"study-legacy-date-notice",
) as HTMLParagraphElement;
const goalStatus = document.getElementById("study-goals-status") as HTMLParagraphElement;
let records: StudyProgressRecord[] = [];
let goal: LearningGoalRecord | undefined;
let loadSequence = 0;
let studyRefreshTimer: number | undefined;

function escapeHtml(value: string): string {
	return value.replace(
		/[&<>"']/g,
		(character) =>
			({
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				'"': "&quot;",
				"'": "&#39;",
			})[character] ?? character,
	);
}

function linkFor(note: DashboardStudyNote, record: StudyProgressRecord | undefined): string {
	const anchor =
		record?.contentRevision === note.revision ? record.readingPositionAnchor : undefined;
	return `${note.href}${anchor ? `#${encodeURIComponent(anchor)}` : ""}`;
}

function renderNoteLinks(
	recordsForNotes: Array<{ note: DashboardStudyNote; record: StudyProgressRecord }>,
): string {
	if (recordsForNotes.length === 0) return '<p class="small muted">None yet.</p>';
	return `<ul class="progressStudyNoteList">${recordsForNotes
		.map(({ note, record }) => {
			const state = getStudyStatus(record, note.revision);
			const label =
				state === "completed"
					? "Completed"
					: state === "in_progress"
						? "In progress"
						: "Not started";
			return `<li><a href="${escapeHtml(linkFor(note, record))}">${escapeHtml(note.title)}</a><span>${label}</span></li>`;
		})
		.join("")}</ul>`;
}

function renderOverview(
	certificationId: string,
	notes: DashboardStudyNote[],
	practiceCount: number,
): void {
	const counts = summarizeStudyProgress(notes, records);
	const noteRecords = notes.flatMap((note) => {
		const record = resolveStudyRecord(note, records);
		return record ? [{ note, record }] : [];
	});
	const recent = noteRecords
		.filter(({ record }) => record.lastOpenedAt !== undefined)
		.toSorted((a, b) => (b.record.lastOpenedAt ?? 0) - (a.record.lastOpenedAt ?? 0))
		.slice(0, 8);
	const bookmarks = noteRecords.filter(({ record }) => record.bookmarked);
	const targetDateText = goal?.targetDate
		? `<p>Exam target date: <strong>${escapeHtml(goal.targetDate)}</strong> (floating local calendar date).</p>`
		: "";
	const questionGoal =
		goal?.targetQuestionCount === null || goal?.targetQuestionCount === undefined
			? "No question target set."
			: `${Math.min(practiceCount, goal.targetQuestionCount)} of ${goal.targetQuestionCount} distinct current-bank questions practiced.`;
	const noteGoal =
		goal?.targetNoteCount === null || goal?.targetNoteCount === undefined
			? "No note target set."
			: `${Math.min(counts.completed, goal.targetNoteCount)} of ${goal.targetNoteCount} notes completed.`;
	const archived = counts.archived.length
		? `<details class="progressStudyArchive"><summary>Archived note history (${counts.archived.length})</summary><ul>${counts.archived.map((record) => `<li><span>${escapeHtml(record.noteId)}</span><span>${record.status.replaceAll("_", " ")}${record.bookmarked ? " · bookmarked" : ""}</span></li>`).join("")}</ul></details>`
		: '<p class="small muted">No archived note records.</p>';

	overview.innerHTML = `
			<section class="progressStudyCompletion" aria-label="Study-note completion">
				<strong>${counts.completed} of ${counts.eligible} notes completed</strong>
				<progress max="${Math.max(1, counts.eligible)}" value="${counts.completed}" aria-label="${counts.completed} of ${counts.eligible} eligible study notes completed"></progress>
				<p>${counts.inProgress} in progress · ${counts.bookmarked} bookmarks</p>
			</section>
			<section class="progressStudyGoalsSummary" aria-label="Goal progress">
				<h3>Goal progress</h3>
				<p>${questionGoal}</p><p>${noteGoal}</p>${targetDateText}
			</section>
			<section><h3>Recently opened notes</h3>${renderNoteLinks(recent)}</section>
			<section><h3>Bookmarks</h3>${renderNoteLinks(bookmarks)}</section>
			${archived}
			${notes.length === 0 ? `<p class="small muted">No eligible study notes are currently published for ${escapeHtml(certificationId)}; saved records remain in archived history.</p>` : ""}
		`;
}

function scheduleStudyRefresh(): void {
	if (studyRefreshTimer !== undefined) window.clearTimeout(studyRefreshTimer);
	studyRefreshTimer = window.setTimeout(() => {
		studyRefreshTimer = undefined;
		void loadStudyProgress();
	}, 300);
}

async function loadStudyProgress(): Promise<void> {
	const sequence = ++loadSequence;
	const certificationId = certificationSelect.value;
	const notes = data.studyNotes.filter((note) => note.certificationId === certificationId);
	status.textContent = "Loading study progress…";
	error.hidden = true;
	try {
		await service.initialize(certificationId);
		const [loadedRecords, loadedGoal] = await Promise.all([
			service.getProgress(certificationId),
			service.getGoal(certificationId),
		]);
		if (sequence !== loadSequence) return;
		records = loadedRecords;
		goal = loadedGoal;
		let practiceCount = 0;
		if (goal?.targetQuestionCount !== null && goal?.targetQuestionCount !== undefined) {
			const progressData = await repository.getProgressSummaryData([certificationId]);
			if (sequence !== loadSequence) return;
			const bankQuestions = new Set(
				(data.banks.find((bank) => bank.certificationId === certificationId)?.questions ?? []).map(
					(question) => question.questionId,
				),
			);
			practiceCount = progressData.questionProgress.filter(
				(progress) => bankQuestions.has(progress.questionId) && progress.attemptCount > 0,
			).length;
		}
		targetDate.value = goal?.targetDate ?? "";
		targetQuestions.value = goal?.targetQuestionCount?.toString() ?? "";
		targetNotes.value = goal?.targetNoteCount?.toString() ?? "";
		legacyDateNotice.hidden = goal?.legacyTargetDate === undefined;
		legacyDateNotice.textContent =
			goal?.legacyTargetDate === undefined
				? ""
				: "An older timestamped target is retained in backups but cannot safely be converted to a local calendar date. Choose a new date to replace it.";
		renderOverview(certificationId, notes, practiceCount);
		status.textContent = "Study progress is up to date.";
	} catch (cause) {
		if (sequence !== loadSequence) return;
		status.textContent = "Study progress could not be loaded.";
		error.hidden = false;
		error.textContent = cause instanceof Error ? cause.message : "Browser storage is unavailable.";
	}
}

goalForm.addEventListener("submit", (event) => {
	event.preventDefault();
	if (!goalForm.reportValidity()) return;
	const certificationId = certificationSelect.value;
	const input = {
		targetDate: targetDate.value || null,
		targetQuestionCount: targetQuestions.value === "" ? null : Number(targetQuestions.value),
		targetNoteCount: targetNotes.value === "" ? null : Number(targetNotes.value),
	};
	goalStatus.textContent = "Saving goals…";
	void service
		.saveGoals(certificationId, input)
		.then(() => {
			goalStatus.textContent = "Goals saved in this browser.";
			return loadStudyProgress();
		})
		.catch((cause: unknown) => {
			goalStatus.textContent = "Goals could not be saved.";
			error.hidden = false;
			error.textContent =
				cause instanceof Error ? cause.message : "Browser storage is unavailable.";
		});
});

certificationSelect.addEventListener("change", () => {
	goalStatus.textContent = "";
	void loadStudyProgress();
});
service.onChange((kind) => {
	if (kind === "practice" && goal?.targetQuestionCount == null) return;
	scheduleStudyRefresh();
});
window.addEventListener(
