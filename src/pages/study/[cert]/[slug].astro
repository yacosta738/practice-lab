---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import StudyLayout from "../../../layouts/StudyLayout.astro";
import { base } from "../../../lib/base";
import {
	assertUniqueNoteSlugs,
	groupNotes,
	type StudyNoteMeta,
	type StudySection,
	toNoteMeta,
} from "../../../lib/study-groups";
import { type StudyCert, studyCerts } from "../../../study/registry";

export const prerender = true;

interface NotePageProps {
	cert: StudyCert;
	section: StudySection;
	note: StudyNoteMeta;
	entry: CollectionEntry<"study">;
	prev: StudyNoteMeta | null;
	next: StudyNoteMeta | null;
}

export async function getStaticPaths() {
	const allEntries = await getCollection("study");
	const entryMap = new Map<string, CollectionEntry<"study">>();
	for (const entry of allEntries) {
		entryMap.set(entry.id, entry);
	}

	const paths: Array<{
		params: { cert: string; slug: string };
		props: NotePageProps;
	}> = [];

	for (const cert of studyCerts) {
		const notes = allEntries
			.filter((entry) => entry.id.startsWith(`${cert.slug}/`))
			.map(toNoteMeta);
		assertUniqueNoteSlugs(notes);
		const sections = groupNotes(notes, cert.certification.domains);

		for (const section of sections) {
			const sortedNotes = section.notes;
			for (let i = 0; i < sortedNotes.length; i++) {
				const note = sortedNotes[i];
				const entry = entryMap.get(note.entryId);
				if (!entry) {
					throw new Error(`Missing entry for note id "${note.id}" in cert "${cert.slug}"`);
				}
				const prev = i > 0 ? sortedNotes[i - 1] : null;
				const next = i < sortedNotes.length - 1 ? sortedNotes[i + 1] : null;
				paths.push({
					params: { cert: cert.slug, slug: note.slug },
					props: { cert, section, note, entry, prev, next },
				});
			}
		}
	}

	return paths;
}

const { cert, section, note, entry, prev, next }: NotePageProps = Astro.props;

const { Content, headings } = await render(entry);

const toc = headings.filter((heading) => heading.depth === 2);

const description = note.kind
	? `${note.kind} note on ${note.title} for ${cert.title}. Review exam-domain concepts, then practice related certification questions.`
	: `Study note: ${note.title} for ${cert.title}. Review exam-domain concepts, then practice related certification questions.`;

const sidebarDomains = Object.entries(cert.certification.domains).map(([id, d]) => ({
	id,
	name: d.name,
	weight: d.weight,
	href: `${base}study/${cert.slug}/#${id}`,
}));
const practiceDomain =
	section.domain && cert.certification.domains[section.domain] ? section.domain : undefined;
const practiceHref = `${base}${cert.quizPath}/?mode=practice${practiceDomain ? `&domain=${encodeURIComponent(practiceDomain)}` : ""}#session`;
const practiceLabel = practiceDomain ? `Practice ${practiceDomain}` : `Practice ${cert.subtitle}`;
const studyClientData = JSON.stringify({
	note: {
		certificationId: cert.slug,
		noteId: note.id,
		aliases: note.aliases,
		revision: note.revision,
	},
}).replaceAll("<", "\\u003c");
---

<StudyLayout
	title={note.title}
	description={description}
	activeCertSlug={cert.slug}
	activeCertCode={cert.subtitle}
	breadcrumb={note.title}
	domains={sidebarDomains}
	disableAnalytics={true}
>
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href={base}>Home</a>
		<span>/</span>
		<a href={`${base}study/`}>Study</a>
		<span>/</span>
		<a href={`${base}study/${cert.slug}/`}>{cert.title}</a>
		<span>/</span>
		<a href={`${base}study/${cert.slug}/#${section.id}`}>{section.title}</a>
		<span>/</span>
		<span aria-current="page">{note.title}</span>
	</nav>

	<div class="studyNotePage">
		<article class="studyProse">
			<h1>{note.title}</h1>
			<div class="studyMeta">
				{note.kind && <span class="kindBadge">{note.kind}</span>}
				{section.domain && section.weight !== undefined && (
					<span class="weightBadge">
						{section.domain} · {section.weight}%
					</span>
				)}
				<span>Section: {section.title}</span>
				{note.updated && <span>Updated {note.updated}</span>}
			</div>
			<section class="noteProgressPanel" aria-labelledby="note-progress-title">
				<div>
					<h2 id="note-progress-title">Your study progress</h2>
					<p id="note-progress-status" class="muted" role="status" aria-live="polite">
						Loading personal progress…
					</p>
				</div>
				<div class="noteProgressActions">
					<button type="button" class="primary" data-study-completion disabled>
						Mark as complete
					</button>
					<button type="button" class="ghost" data-study-bookmark disabled>Bookmark note</button>
					<a class="ghost" data-study-resume hidden href="#study-reading-content">Resume reading</a>
				</div>
				<p id="note-progress-error" class="studyProgressError" role="alert" hidden></p>
			</section>
			<div id="study-reading-content">
				<Content />
			</div>
			<div class="studyPracticeCta">
				<div>
					<strong>Test this topic in Practice Lab</strong>
					<p class="small muted" style="margin:2px 0 0">
						Reinforce {section.title} with source-linked questions and immediate rationales.
					</p>
				</div>
				<a class="primary" href={practiceHref}>{practiceLabel} →</a>
			</div>
			<div class="pl-contextual-feedback">
				<span class="small muted">Spotted an error or outdated detail in this note?</span>
				<button
					type="button"
					class="pl-feedback-link"
					data-pl-open-feedback
					data-feedback-type="lesson"
					data-feedback-cert={cert.slug}
					data-feedback-domain={section.domain}
					data-feedback-lesson={note.slug}
					aria-haspopup="dialog"
					aria-controls="pl-feedback-dialog"
				>
					Report an issue
				</button>
			</div>
		</article>

		{toc.length >= 2 && (
			<aside class="studyToc" aria-labelledby="toc-title">
				<h2 id="toc-title">On this page</h2>
				<ul>
					{toc.map((heading) => (
						<li>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
				</ul>
			</aside>
		)}
	</div>

	{(prev || next) && (
		<nav class="studyPager" aria-label="More notes in this section">
			{prev && (
				<a href={`${base}study/${cert.slug}/${prev.slug}/`} rel="prev">
					<span>Previous</span>
					{prev.title}
				</a>
			)}
			{next && (
				<a href={`${base}study/${cert.slug}/${next.slug}/`} rel="next">
					<span>Next</span>
					{next.title}
				</a>
			)}
		</nav>
	)}
</StudyLayout>

<script type="application/json" id="study-note-data" set:html={studyClientData}></script>

<script>
import type { StudyProgressRecord } from "../../../lib/progress/model";
import type { StudyNoteReference } from "../../../lib/progress/study-domain";
import { getStudyStatus, resolveStudyRecord } from "../../../lib/progress/study-domain";
import { StudyProgressService } from "../../../lib/progress/study-service";

interface NoteData {
	note: StudyNoteReference;
}

const data = JSON.parse(
	document.getElementById("study-note-data")?.textContent ?? "{}",
) as NoteData;
const note = data.note;
const service = new StudyProgressService();
const statusElement = document.getElementById("note-progress-status") as HTMLParagraphElement;
const errorElement = document.getElementById("note-progress-error") as HTMLParagraphElement;
const completionButton = document.querySelector<HTMLButtonElement>("[data-study-completion]");
const bookmarkButton = document.querySelector<HTMLButtonElement>("[data-study-bookmark]");
const resumeLink = document.querySelector<HTMLAnchorElement>("[data-study-resume]");
let records: StudyProgressRecord[] = [];
let pendingAnchor: string | undefined;
let checkpointTimer: number | undefined;
let lastSavedAnchor: string | undefined;
let observers: IntersectionObserver | undefined;

function currentRecord(): StudyProgressRecord | undefined {
	return resolveStudyRecord(note, records);
}

async function renderProgress(): Promise<void> {
	records = await service.getProgress(note.certificationId);
	const record = currentRecord();
	const status = getStudyStatus(record, note.revision);
	statusElement.textContent =
		status === "completed"
			? "Completed by you. You can mark this note unread at any time."
			: status === "in_progress"
				? "In progress. Visiting or scrolling never marks a note complete."
				: "Not started. Mark this note complete only when you choose to.";
	if (completionButton) {
		completionButton.disabled = false;
		completionButton.textContent = status === "completed" ? "Mark unread" : "Mark as complete";
	}
	if (bookmarkButton) {
		bookmarkButton.disabled = false;
		bookmarkButton.textContent = record?.bookmarked ? "Remove bookmark" : "Bookmark note";
		bookmarkButton.setAttribute("aria-pressed", String(record?.bookmarked ?? false));
	}
	if (
		resumeLink &&
		record?.readingPositionAnchor &&
		record.contentRevision === note.revision &&
		document.getElementById(record.readingPositionAnchor)
	) {
		resumeLink.href = `#${encodeURIComponent(record.readingPositionAnchor)}`;
		resumeLink.hidden = false;
	} else if (resumeLink) {
		resumeLink.hidden = true;
	}
	lastSavedAnchor = record?.readingPositionAnchor;
}

function showError(cause: unknown): void {
	errorElement.hidden = false;
	errorElement.textContent = `Personal progress could not be loaded or saved. The note remains available.${cause instanceof Error ? ` ${cause.message}` : ""}`;
}

async function saveAnchor(): Promise<void> {
	if (!pendingAnchor || pendingAnchor === lastSavedAnchor) return;
	const anchor = pendingAnchor;
	pendingAnchor = undefined;
	try {
		const record = await service.saveReadingPosition(note, anchor);
		lastSavedAnchor = record?.readingPositionAnchor ?? lastSavedAnchor;
		await renderProgress();
	} catch (cause) {
		showError(cause);
	}
}

function scheduleAnchor(anchor: string): void {
	pendingAnchor = anchor;
	if (checkpointTimer !== undefined) window.clearTimeout(checkpointTimer);
	checkpointTimer = window.setTimeout(() => void saveAnchor(), 1_500);
}

function trackReadingPosition(): void {
	const headings = [
		...document.querySelectorAll<HTMLElement>(
			"#study-reading-content h2[id], #study-reading-content h3[id]",
		),
	];
	if (!headings.length || typeof IntersectionObserver === "undefined") return;
	observers = new IntersectionObserver(() => {
		const active = headings
			.map((heading) => ({ heading, top: heading.getBoundingClientRect().top }))
			.filter(
				({ heading, top }) =>
					top < window.innerHeight && heading.getBoundingClientRect().bottom > 0,
			)
			.toSorted((a, b) => a.top - b.top);
		const current = active.filter(({ top }) => top <= 160).at(-1)?.heading ?? active[0]?.heading;
		if (current?.id) scheduleAnchor(current.id);
	});
	for (const heading of headings) observers.observe(heading);
}

async function start(): Promise<void> {
	try {
		await service.initialize(note.certificationId);
		await service.openNote(note);
		await renderProgress();
		service.onChange((kind) => {
			if (kind !== "practice") void renderProgress().catch(showError);
		});
		trackReadingPosition();
	} catch (cause) {
		showError(cause);
	}
}

completionButton?.addEventListener("click", () => {
	const status = getStudyStatus(currentRecord(), note.revision);
	void service
		.setStatus(note, status === "completed" ? "not_started" : "completed")
		.then(renderProgress)
		.catch(showError);
});
bookmarkButton?.addEventListener("click", () => {
	void service
		.setBookmarked(note, !(currentRecord()?.bookmarked ?? false))
		.then(renderProgress)
		.catch(showError);
});
document.addEventListener("visibilitychange", () => {
	if (document.visibilityState === "hidden") void saveAnchor();
});
window.addEventListener(
	"pagehide",
	() => {
		if (checkpointTimer !== undefined) window.clearTimeout(checkpointTimer);
		void saveAnchor().finally(() => {
			observers?.disconnect();
			service.close();
		});
	},
	{ once: true },
);
void start();
</script>
