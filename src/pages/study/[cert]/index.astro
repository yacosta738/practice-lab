---
import { getCollection } from "astro:content";
import { getCertificationList } from "../../../certifications";
import StudyLayout from "../../../layouts/StudyLayout.astro";
import { base } from "../../../lib/base";
import { groupNotes, toNoteMeta } from "../../../lib/study-groups";
import { type StudyCert, studyCerts } from "../../../study/registry";

export const prerender = true;

export async function getStaticPaths() {
	const studyCertifications = new Map(studyCerts.map((cert) => [cert.slug, cert]));
	const certifications = await getCertificationList();
	return certifications.map((certification) => ({
		params: { cert: certification.slug },
		props: {
			cert:
				studyCertifications.get(certification.slug) ??
				({
					slug: certification.slug,
					title: certification.title,
					subtitle: certification.subtitle,
					description: certification.description,
					certification,
					quizPath: `certifications/${certification.slug}`,
				} satisfies StudyCert),
		},
	}));
}

const { cert }: { cert: StudyCert } = Astro.props;

const allNotes = await getCollection("study");
const notes = allNotes.filter((entry) => entry.id.startsWith(`${cert.slug}/`)).map(toNoteMeta);
const sections = groupNotes(notes, cert.certification.domains);
for (const [id, domain] of Object.entries(cert.certification.domains)) {
	if (sections.some((section) => section.id === id)) continue;
	sections.push({
		id,
		title: `${domain.id} ${domain.name}`,
		domain: domain.id,
		weight: domain.weight,
		notes: [],
	});
}

const totalSections = sections.length;
const eligibleNotes = sections.flatMap((section) => section.notes);
const totalNotes = eligibleNotes.length;
const studyClientData = JSON.stringify({
	certificationId: cert.slug,
	notes: eligibleNotes.map((note) => ({
		certificationId: cert.slug,
		noteId: note.id,
		aliases: note.aliases,
		revision: note.revision,
		title: note.title,
		href: `${base}study/${cert.slug}/${note.slug}/`,
	})),
}).replaceAll("<", "\\u003c");

const sidebarDomains = Object.entries(cert.certification.domains).map(([id, d]) => ({
	id,
	name: d.name,
	weight: d.weight,
	href: `${base}study/${cert.slug}/#${id}`,
}));
---

<StudyLayout
	title={cert.title}
	description={`${cert.description} Personal study notes organised by exam domain.`}
	activeCertSlug={cert.slug}
	activeCertCode={cert.subtitle}
	breadcrumb="Study Library"
	domains={sidebarDomains}
	disableAnalytics={true}
>
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href={base}>Home</a>
		<span>/</span>
		<a href={`${base}study/`}>Study</a>
		<span>/</span>
		<span aria-current="page">{cert.title}</span>
	</nav>

	<section class="hero">
		<span class="eyebrow">{cert.subtitle} · {notes.length ? "Study notes" : "Study domains"}</span>
		<h1>{cert.title}</h1>
		<p class="lead">{cert.description}</p>
		<div class="ctaRow">
			<a class="primary" href={`${base}${cert.quizPath}`}>Practice the quiz</a>
			{cert.examGuide && (
				<a class="ghost ghostOnDark" href={`${base}${cert.examGuide.path}`}>
					{cert.examGuide.label}
				</a>
			)}
			{cert.learningResources && (
				<a class="ghost ghostOnDark" href={`${base}${cert.learningResources.path}/`}>
					{cert.learningResources.label}
				</a>
			)}
			{cert.examDecisionGuide && (
				<a class="ghost ghostOnDark" href={`${base}${cert.examDecisionGuide.path}/`}>
					{cert.examDecisionGuide.label}
				</a>
			)}
		</div>
		<div class="pills">
			<span class="pill">{totalNotes} notes</span>
			<span class="pill">{totalSections} sections</span>
			<span class="pill">{cert.certification.slug}</span>
		</div>
	</section>

	<section class="studyProgressPanel" aria-labelledby="study-progress-title">
		<div>
			<h2 id="study-progress-title">Study progress</h2>
			<p id="study-library-summary" class="muted" role="status" aria-live="polite">
				Loading personal study progress…
			</p>
		</div>
		<p id="study-library-error" class="studyProgressError" role="alert" hidden></p>
	</section>

	<nav class="studyJump" aria-label="Jump to section">
		{sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
	</nav>

	{sections.map((section) => (
		<section class="section studyGroup" id={section.id}>
			<div class="sectionHead">
				<h2>{section.title}</h2>
				<span class="muted small">
					{section.notes.length} note
					{section.notes.length !== 1 ? "s" : ""}
					{section.weight !== undefined ? ` · ${section.weight}% exam weight` : ""}
				</span>
			</div>
			{section.notes.length ? (
				<ul class="studyList">
					{section.notes.map((note) => (
						<li data-study-note-row={note.id}>
							<a class="studyNote" href={`${base}study/${cert.slug}/${note.slug}/`}>
								<span class="studyNoteTitle">{note.title}</span>
								{note.kind && <span class="kindBadge">{note.kind}</span>}
							</a>
							<div class="studyNoteProgress">
								<span data-study-status>Not started</span>
								<a data-study-resume hidden href={`${base}study/${cert.slug}/${note.slug}/`}>
									Resume reading
								</a>
								<button
									class="studyBookmarkButton"
									type="button"
									data-study-bookmark
									aria-label={`Bookmark ${note.title}`}
									aria-pressed="false"
									disabled
								>
									Bookmark
								</button>
							</div>
						</li>
					))}
				</ul>
			) : (
				<p class="muted">Study notes are not available for this domain yet.</p>
			)}
		</section>
	))}

	<p class="alert section">Personal study notes. Not affiliated with or endorsed by Anthropic.</p>
</StudyLayout>

<script type="application/json" id="study-library-data" set:html={studyClientData}></script>

<script>
import type { StudyProgressRecord } from "../../../lib/progress/model";
import type { StudyNoteReference } from "../../../lib/progress/study-domain";
import {
	getStudyStatus,
	resolveStudyRecord,
	summarizeStudyProgress,
} from "../../../lib/progress/study-domain";
import { StudyProgressService } from "../../../lib/progress/study-service";

interface LibraryNote extends StudyNoteReference {
	title: string;
	href: string;
}

interface LibraryData {
	certificationId: string;
	notes: LibraryNote[];
}

const data = JSON.parse(
	document.getElementById("study-library-data")?.textContent ?? "{}",
) as LibraryData;
const service = new StudyProgressService();
const summary = document.getElementById("study-library-summary") as HTMLParagraphElement;
const error = document.getElementById("study-library-error") as HTMLParagraphElement;
let records: StudyProgressRecord[] = [];

async function renderProgress(): Promise<void> {
	records = await service.getProgress(data.certificationId);
	const counts = summarizeStudyProgress(data.notes, records);
	summary.textContent = `${counts.completed} of ${counts.eligible} notes completed · ${counts.inProgress} in progress · ${counts.bookmarked} bookmarks`;
	for (const note of data.notes) {
		const row = document.querySelector<HTMLElement>(
			`[data-study-note-row="${CSS.escape(note.noteId)}"]`,
		);
		if (!row) continue;
		const record = resolveStudyRecord(note, records);
		const status = getStudyStatus(record, note.revision);
		const statusElement = row.querySelector<HTMLElement>("[data-study-status]");
		if (statusElement) {
			statusElement.textContent =
				status === "completed"
					? "Completed"
					: status === "in_progress"
						? "In progress"
						: "Not started";
		}
		const bookmark = row.querySelector<HTMLButtonElement>("[data-study-bookmark]");
		if (bookmark) {
			bookmark.disabled = false;
			bookmark.setAttribute("aria-pressed", String(record?.bookmarked ?? false));
			bookmark.setAttribute(
				"aria-label",
				record?.bookmarked ? `Remove ${note.title} bookmark` : `Bookmark ${note.title}`,
			);
			bookmark.textContent = record?.bookmarked ? "Bookmarked" : "Bookmark";
		}
		const resume = row.querySelector<HTMLAnchorElement>("[data-study-resume]");
		if (resume && record?.readingPositionAnchor && record.contentRevision === note.revision) {
			resume.href = `${note.href}#${encodeURIComponent(record.readingPositionAnchor)}`;
			resume.hidden = false;
		} else if (resume) {
			resume.hidden = true;
		}
	}
}

async function start(): Promise<void> {
	try {
		await service.initialize(data.certificationId);
		await renderProgress();
		service.onChange((kind) => {
			if (kind !== "practice") void renderProgress().catch(showError);
		});
	} catch (cause) {
		showError(cause);
	}
}

function showError(cause: unknown): void {
	error.hidden = false;
	error.textContent = `Personal progress could not be loaded or saved. The study notes remain available.${cause instanceof Error ? ` ${cause.message}` : ""}`;
}

document.addEventListener("click", (event) => {
	const target =
		event.target instanceof Element
			? event.target.closest<HTMLButtonElement>("[data-study-bookmark]")
			: null;
	if (!target) return;
	const row = target.closest<HTMLElement>("[data-study-note-row]");
	const note = data.notes.find((item) => item.noteId === row?.dataset.studyNoteRow);
	if (!note) return;
	const record = resolveStudyRecord(note, records);
	void service
		.setBookmarked(note, !(record?.bookmarked ?? false))
		.then(renderProgress)
		.catch(showError);
});

window.addEventListener("pagehide", () => service.close(), { once: true });
void start();
</script>
