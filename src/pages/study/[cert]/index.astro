---
import { getCollection } from "astro:content";
import { getCertificationList } from "../../../certifications";
import StudyLayout from "../../../layouts/StudyLayout.astro";
import { base } from "../../../lib/base";
import { groupNotes, toNoteMeta } from "../../../lib/study-groups";
import { type StudyCert, studyCerts } from "../../../study/registry";

export const prerender = true;

export async function getStaticPaths() {
	const studyCertifications = new Map(studyCerts.map((cert) => [cert.slug, cert]));
	const certifications = await getCertificationList();
	return certifications.map((certification) => ({
		params: { cert: certification.slug },
		props: {
			cert:
				studyCertifications.get(certification.slug) ??
				({
					slug: certification.slug,
					title: certification.title,
					subtitle: certification.subtitle,
					description: certification.description,
					certification,
					quizPath: `certifications/${certification.slug}`,
				} satisfies StudyCert),
		},
	}));
}

const { cert }: { cert: StudyCert } = Astro.props;

const allNotes = await getCollection("study");
const notes = allNotes.filter((entry) => entry.id.startsWith(`${cert.slug}/`)).map(toNoteMeta);
const sections = groupNotes(notes, cert.certification.domains);
for (const [id, domain] of Object.entries(cert.certification.domains)) {
	if (sections.some((section) => section.id === id)) continue;
	sections.push({
		id,
		title: `${domain.id} ${domain.name}`,
		domain: domain.id,
		weight: domain.weight,
		notes: [],
	});
}

const totalNotes = notes.length;
const totalSections = sections.length;
const description = totalNotes
	? `Study ${cert.subtitle} with ${totalNotes} domain-organized notes across ${totalSections} sections. Review key concepts, use curated resources, and practice related certification questions.`
	: `Explore ${cert.subtitle} exam domains, review their weightings, and use the certification practice quiz to assess your knowledge today.`;

const sidebarDomains = Object.entries(cert.certification.domains).map(([id, d]) => ({
	id,
	name: d.name,
	weight: d.weight,
	href: `${base}study/${cert.slug}/#${id}`,
}));
---

<StudyLayout
	title={cert.title}
	description={description}
	activeCertSlug={cert.slug}
	activeCertCode={cert.subtitle}
	breadcrumb="Study Library"
	domains={sidebarDomains}
>
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href={base}>Home</a>
		<span>/</span>
		<a href={`${base}study/`}>Study</a>
		<span>/</span>
		<span aria-current="page">{cert.title}</span>
	</nav>

	<section class="hero">
		<span class="eyebrow">{cert.subtitle} · {notes.length ? "Study notes" : "Study domains"}</span>
		<h1>{cert.title}</h1>
		<p class="lead">{cert.description}</p>
		<div class="ctaRow">
			<a class="primary" href={`${base}${cert.quizPath}`}>Practice the quiz</a>
			{cert.examGuide && (
				<a class="ghost ghostOnDark" href={`${base}${cert.examGuide.path}`}>
					{cert.examGuide.label}
				</a>
			)}
			{cert.learningResources && (
				<a class="ghost ghostOnDark" href={`${base}${cert.learningResources.path}/`}>
					{cert.learningResources.label}
				</a>
			)}
			{cert.examDecisionGuide && (
				<a class="ghost ghostOnDark" href={`${base}${cert.examDecisionGuide.path}/`}>
					{cert.examDecisionGuide.label}
				</a>
			)}
		</div>
		<div class="pills">
			<span class="pill">{totalNotes} notes</span>
			<span class="pill">{totalSections} sections</span>
			<span class="pill">{cert.certification.slug}</span>
		</div>
	</section>

	<nav class="studyJump" aria-label="Jump to section">
		{sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
	</nav>

	{sections.map((section) => (
		<section class="section studyGroup" id={section.id}>
			<div class="sectionHead">
				<h2>{section.title}</h2>
				<span class="muted small">
					{section.notes.length} note
					{section.notes.length !== 1 ? "s" : ""}
					{section.weight !== undefined ? ` · ${section.weight}% exam weight` : ""}
				</span>
			</div>
			{section.notes.length ? (
				<ul class="studyList">
					{section.notes.map((note) => (
						<li>
							<a class="studyNote" href={`${base}study/${cert.slug}/${note.slug}/`}>
								<span class="studyNoteTitle">{note.title}</span>
								{note.kind && <span class="kindBadge">{note.kind}</span>}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="muted">Study notes are not available for this domain yet.</p>
			)}
		</section>
	))}

	<p class="alert section">Personal study notes. Not affiliated with or endorsed by Anthropic.</p>
</StudyLayout>
