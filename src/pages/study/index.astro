---
import { getCollection } from "astro:content";
import { getCertificationList } from "../../certifications";
import StudyLayout from "../../layouts/StudyLayout.astro";
import { base } from "../../lib/base";
import { groupNotes, toNoteMeta } from "../../lib/study-groups";
import { studyCerts } from "../../study/registry";

const allNotes = await getCollection("study");
const certifications = await getCertificationList();
const studyCertBySlug = new Map(studyCerts.map((cert) => [cert.slug, cert]));

const certData = certifications.map((certification) => {
	const studyCert = studyCertBySlug.get(certification.slug);
	const notes = allNotes
		.filter((entry) => entry.id.startsWith(`${certification.slug}/`))
		.map(toNoteMeta);
	const sections = groupNotes(notes, certification.domains);
	return {
		slug: certification.slug,
		title: certification.title,
		subtitle: certification.subtitle,
		description:
			studyCert?.description ??
			"Dedicated study notes are not available yet. Review exam-domain weightings and use the linked practice quiz to get started.",
		notesCount: notes.length,
		sectionsCount: sections.length || Object.keys(certification.domains).length,
	};
});
---

<StudyLayout
	title="Certification Study Library"
	description="Browse personal certification study notes organized by exam domain, with guided lessons, curated resources, and related practice quizzes."
>
	<section class="section studyIntro">
		<span class="eyebrow">Study library</span>
		<h1>Study notes, organised by certification.</h1>
		<p class="lead">
			These are personal study material recovered from a knowledge base, grouped by exam domain. If
			you want to test your knowledge, the practice quizzes live next door.
		</p>
	</section>

	<div class="studyGrid">
		{certData.map((cert) => (
			<a class="certCard" href={`${base}study/${cert.slug}/`}>
				<div>
					<span class="num">{cert.subtitle}</span>
					<strong>{cert.title}</strong>
					<p>{cert.description}</p>
					<span class="certCta">
						{cert.notesCount ? "Open the study library" : "Explore domains and practice"} →
					</span>
				</div>
				<dl class="certFacts">
					<div>
						<dt>Notes</dt>
						<dd>{cert.notesCount}</dd>
					</div>
					<div>
						<dt>Sections</dt>
						<dd>{cert.sectionsCount}</dd>
					</div>
				</dl>
			</a>
		))}
	</div>
</StudyLayout>
