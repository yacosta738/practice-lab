				<div class="sectionHead"><h2>Learning telemetry</h2><div class="actions"><button class="ghost small" data-action="download-backup">Download data backup</button><button class="ghost small" data-action="select-restore-file" ${progressState.migrationPending || progressState.legacyWriteDetected ? "disabled" : ""}>Restore from JSON</button><input id="progress-restore-file" type="file" accept=".json,application/json" hidden><button class="ghost small" data-action="reset-stats" ${progressState.migrationPending ? "disabled" : ""}>Reset progress</button></div></div>
