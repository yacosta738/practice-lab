---
// Dynamic certification page — loads config and questions server-side

import QuizLayout from "../../layouts/QuizLayout.astro";
import { base } from "../../lib/base";
import { OPTION_SHORTCUT_KEYS } from "../../lib/quiz-keys";
import type { CertificationConfig, Question } from "../../lib/quiz-types";
import { studyCerts } from "../../study/registry";

/** Extract the certification slug from a glob key (segment immediately before config.ts / questions.ts) */
function extractSlug(path: string): string {
	const match = path.match(/(?:^|\/)([^/]+)\/(?:config|questions)\.ts$/);
	return match ? match[1] : "";
}

// Auto-discover config and questions modules for all certifications
const configModules = import.meta.glob("../../certifications/*/config.ts", { eager: true });
const questionsModules = import.meta.glob("../../certifications/*/questions.ts", { eager: true });

// Build maps keyed by slug
const configMap: Record<string, { config: CertificationConfig }> = {};
const questionsMap: Record<string, { questions: Question[] }> = {};
for (const [path, mod] of Object.entries(configModules)) {
	const slug = extractSlug(path);
	if (slug) configMap[slug] = mod as { config: CertificationConfig };
}
for (const [path, mod] of Object.entries(questionsModules)) {
	const slug = extractSlug(path);
	if (slug) questionsMap[slug] = mod as { questions: Question[] };
}

// Slugs that have study notes
const studySlugs = new Set(studyCerts.map((c) => c.slug));

export const prerender = true;

// getStaticPaths is extracted by Astro into a separate module, so it must
// be fully self-contained — no references to frontmatter variables.
export async function getStaticPaths() {
	const modules = import.meta.glob("../../certifications/*/config.ts", { eager: true });
	const slugs = Object.keys(modules)
		.map((path) => {
			const m = path.match(/(?:^|\/)([^/]+)\/(?:config|questions)\.ts$/);
			return m ? m[1] : "";
		})
		.filter((s) => s.length > 0);
	return slugs.map((slug) => ({
		params: { slug },
	}));
}

const slug = Astro.params.slug;
const certConfig = configMap[slug]?.config;
const questions = questionsMap[slug]?.questions ?? [];

// Only pass studyHref when the certification actually has study notes
const studyHref = studySlugs.has(slug) ? `${base}study/${slug}/` : undefined;
const sidebarDomains = Object.entries(certConfig.domains).map(([id, d]) => ({
	id,
	name: d.name,
	weight: d.weight,
	href: studyHref ? `${studyHref}#${id}` : "#coverage",
}));
---

<QuizLayout
	title={certConfig.title}
	subtitle={certConfig.subtitle}
	slug={certConfig.slug}
	description={certConfig.description}
	studyHref={studyHref}
	domains={sidebarDomains}
	theme={certConfig.theme}
>
	<!-- Quiz data passed inline -->
</QuizLayout>

<div
	id="quiz-bootstrap"
	data-bootstrap={JSON.stringify({
		cfg: certConfig,
		qs: questions,
		optionKeys: OPTION_SHORTCUT_KEYS,
		studyHref,
		base,
		knownCertifications: Object.keys(configMap),
	})}
	hidden
></div>

<script>
import { parseProgressBackup } from "../../lib/progress/backup-restore";
import type { BrowserProgressService } from "../../lib/progress/browser-service";
import type {
	EvaluationOutcome,
	ProgressSession,
	SessionCheckpoint,
	SessionMode,
} from "../../lib/progress/model";
import { initializeQuizClient } from "../../lib/quiz-client";
import {
	formatTime,
	isAnswerCorrectWithShuffle,
	percent as pct,
	shuffle,
	shuffleQuestionOptions,
} from "../../lib/quiz-engine";
import { delegateQuizActions, renderQuizContent, setQuizFocusMode } from "../../lib/quiz-renderer";
import type {
	DomainInfo,
	Question,
	QuestionStats,
	ShuffledQuestionOptions,
} from "../../lib/quiz-types";

type QuizSessionView = ReturnType<BrowserProgressService["hydrateSession"]>["session"] & {
	questionsById?: Record<string, Question>;
	domainsById?: Record<string, Pick<DomainInfo, "name" | "weight">>;
};
type DomainSummary = Pick<DomainInfo, "name" | "weight">;
type RetryPersistence = () => unknown;

const app = document.getElementById("app");
const HTML_ESCAPES: Record<string, string> = {
	"&": "&amp;",
	"<": "&lt;",
	">": "&gt;",
	'"': "&quot;",
	"'": "&#39;",
};

function showProgressFailure(error: unknown) {
	const message = error instanceof Error ? error.message : String(error);
	if (app) {
		const safeMessage = message.replace(/[&<>"']/g, (char) => HTML_ESCAPES[char] ?? char);
		app.innerHTML = `<section class="panel padded" role="alert"><h1>Progress storage unavailable</h1><p>${safeMessage}</p><p>Your existing data has not been replaced by browser-only fallback state.</p><button class="primary" data-storage-action="retry">Retry storage</button><button class="ghost" data-storage-action="backup">Download recovery backup</button></section>`;
	}
}
document.addEventListener("click", (event: MouseEvent) => {
	const target = event.target instanceof Element ? event.target : null;
	const action = target?.closest("[data-storage-action]")?.getAttribute("data-storage-action");
	if (action === "retry") window.location.reload();
	if (action === "backup") {
		event.preventDefault();
		window.practiceLabProgressService?.downloadLocalLegacyBackup().catch(() => {});
	}
});

(async function () {
	if (!app) return;
	const client = await initializeQuizClient();
	if (!client) return;
	const { cfg, qs, optionKeys, studyHref, base, knownCertifications } = client.bootstrap;
	const { progressService, byId, domains } = client;
	let progressState = client.progressState;

	const LETTERS = "ABCDE";
	let reviewFilter = "all";
	const params = new URLSearchParams(window.location.search);
	const rawDomain = params.get("domain");
	const requestedDomain = rawDomain && Object.hasOwn(cfg.domains, rawDomain) ? rawDomain : "all";
	let examNavigatorExpanded = !window.matchMedia("(max-width: 860px)").matches;

	// Native <dialog> confirmation helper (replaces window.confirm())
	function confirmAction(
		title: string,
		message: string,
		okLabel: string,
		onConfirm: () => unknown,
	): void {
		const invoke = () => {
			Promise.resolve()
				.then(onConfirm)
				.catch((error) => setPersistenceError(error, () => window.location.reload()));
		};
		const dialogElement = document.getElementById("pl-confirm-dialog");
		if (!(dialogElement instanceof HTMLDialogElement)) {
			if (window.confirm(message)) invoke();
			return;
		}
		const dialog = dialogElement;
		const titleEl = document.getElementById("pl-confirm-title");
		const msgEl = document.getElementById("pl-confirm-message");
		const okBtn = document.getElementById("pl-confirm-ok");
		if (titleEl) titleEl.textContent = title;
		if (msgEl) msgEl.textContent = message;
		if (okBtn) okBtn.textContent = okLabel;
		const onClose = () => {
			const val = dialog.returnValue;
			dialog.returnValue = "";
			if (val === "confirm") invoke();
		};
		dialog.addEventListener("close", onClose, { once: true });
		dialog.showModal();
	}

	// Safe HTML renderer — uses Element.setHTML() with Sanitizer API when available,
	// falls back to innerHTML for browsers without support (e.g. Safari).
	// The quiz content is trusted (from the question bank), so the sanitizer allows
	// data-* attributes required for event delegation.
	function setAppHTML(html: string, focusTarget?: string): void {
		if (!app) return;
		const notices = [];
		if (restoreMessage) {
			notices.push(
				`<section class="panel padded" role="alert"><strong>Progress backup could not be restored.</strong><p>${esc(restoreMessage)}</p></section>`,
			);
		}
		if (invalidationMessage) {
			notices.push(
				`<section class="panel padded" role="alert"><strong>Progress changed elsewhere.</strong><p>${esc(invalidationMessage)}</p><button class="ghost" data-action="reload-progress">Reload progress</button></section>`,
			);
		}
		if (progressState.legacyWriteDetected) {
			notices.push(
				`<section class="panel padded" role="alert"><strong>Legacy progress changed in an older tab.</strong><p>Its counts will not be merged automatically. Download the current record and IndexedDB progress, then explicitly archive the legacy copy to keep this IndexedDB history.</p><div class="actions"><button class="ghost" data-action="download-backup">Download data backup</button><button class="primary" data-action="reconcile-legacy" ${progressState.reconciliationBackupReady ? "" : "disabled"}>Keep IndexedDB and archive legacy copy</button><button class="ghost" data-action="reload-progress">Reload progress</button></div></section>`,
			);
		}
		if (progressState.migrationPending) {
			notices.push(
				`<section class="panel padded" role="status"><h2>Legacy progress is ready to import</h2><p>Download a versioned backup of all known certification records before importing. The original browser keys will remain untouched; reverting to an older app will not include progress created after migration.</p>${migrationNoticeList(progressState.migrationWarnings)}<div class="actions"><button class="ghost" data-action="download-backup">Download data backup</button><button class="primary" data-action="migrate-progress" ${progressState.backupReady ? "" : "disabled"}>Import saved progress</button></div></section>`,
			);
		} else if (progressState.migrationWarnings.length) {
			notices.push(
				`<section class="panel padded" role="status"><strong>Legacy recovery notes</strong>${migrationNoticeList(progressState.migrationWarnings)}<p class="small muted">Download a fresh backup at any time. The original v2 browser record was not deleted.</p></section>`,
			);
		}
		if (persistenceError) {
			notices.push(
				`<section class="panel padded" role="alert"><strong>Progress could not be saved.</strong><p>${esc(persistenceError)}</p><div class="actions"><button class="primary" data-action="retry-storage">Retry save</button><button class="ghost" data-action="download-recovery">Download recovery backup</button></div></section>`,
			);
		}
		const content = `${notices.join("")}${html}`;
		renderQuizContent(app, content, {
			focusTarget,
			onNavigatorToggle: (expanded) => {
				examNavigatorExpanded = expanded;
			},
		});
		syncFocusMode();
	}

	function syncFocusMode() {
		const active =
			activeSession?.mode === "exam" &&
			activeSession.progress.status === "in_progress" &&
			new URLSearchParams(window.location.search).get("resume") === "1";
		setQuizFocusMode(document, active);
	}

	// --- IndexedDB-backed progress ---
	let saved: { stats: Record<string, QuestionStats> } = { stats: progressState.stats };
	let session: QuizSessionView | null = null;
	let activeSession: QuizSessionView | null = null;
	let sessionQuestionsById: Record<string, Question> = {};
	let sessionDomainsById: Record<string, DomainSummary> = {};
	let persistenceError: string | null = null;
	let restoreMessage = "";
	let retryPersistence: RetryPersistence | null = null;
	let invalidationMessage = "";
	let finishing = false;
	let checking = false;
	let checkpointQueue: Promise<void> = Promise.resolve();

	function applyProgressSession(
		progressSession: ProgressSession,
		{ display = true, trackActive = true }: { display?: boolean; trackActive?: boolean } = {},
	): QuizSessionView {
		const hydrated = progressService.hydrateSession(progressSession);
		const hydratedDomains: Record<string, DomainSummary> = {};
		for (const snapshot of progressSession.content.questions) {
			hydratedDomains[snapshot.domainId] = {
				name: snapshot.domainName || snapshot.domainId,
				weight: progressSession.scoring.domainWeights[snapshot.domainId] || 0,
			};
		}
		const hydratedSession = hydrated.session as QuizSessionView;
		Object.defineProperty(hydratedSession, "questionsById", {
			value: hydrated.questionsById,
			configurable: true,
		});
		Object.defineProperty(hydratedSession, "domainsById", {
			value: hydratedDomains,
			configurable: true,
		});
		if (trackActive) {
			activeSession = progressSession.status === "in_progress" ? hydratedSession : null;
		}
		if (display) {
			session = hydratedSession;
			sessionQuestionsById = hydrated.questionsById;
			sessionDomainsById = hydratedDomains;
		}
		return hydratedSession;
	}

	function getQuestion(id: string): Question {
		const question = sessionQuestionsById[id] || byId[id];
		if (!question) throw new Error(`Question ${id} is no longer available.`);
		return question;
	}

	function getDomain(id: string): DomainSummary {
		return sessionDomainsById[id] || domains[id] || { name: id || "Unknown domain", weight: 0 };
	}

	function sessionCheckpoint(currentSession: QuizSessionView): SessionCheckpoint {
		const selectedOptionIdsByQuestion: Record<string, string[]> = {};
		for (const id of currentSession.ids) {
			const selected = currentSession.answers[id] || [];
			const optionIds = currentSession.shuffledOptions?.[id]?.optionIds;
			if (selected.length && optionIds)
				selectedOptionIdsByQuestion[id] = selected.map((index) => optionIds[index]);
		}
		return {
			currentQuestionId: currentSession.ids[currentSession.currentIndex] ?? null,
			deadlineAt: currentSession.deadline,
			selectedOptionIdsByQuestion,
			checkedQuestionIds: currentSession.ids.filter((id) => currentSession.checked[id]),
			flaggedQuestionIds: [...currentSession.flags],
		};
	}

	async function persist(): Promise<unknown> {
		const write = checkpointQueue.then(async () => {
			const currentSession = session;
			if (!currentSession?.progress)
				throw new Error("This session is not connected to durable progress storage.");
			const sessionId = currentSession.progress.id;
			const updated = await progressService.checkpointSession({
				sessionId,
				expectedRevision: currentSession.progress.revision,
				checkpoint: sessionCheckpoint(currentSession),
			});
			if (session?.progress.id === sessionId) {
				session.progress.revision = updated.revision;
				session.progress.status = updated.status;
			}
			return updated;
		});
		checkpointQueue = write.then(
			() => undefined,
			() => undefined,
		);
		return write;
	}

	function setPersistenceError(error: unknown, retry: RetryPersistence | null = null): void {
		persistenceError = error instanceof Error ? error.message : String(error);
		retryPersistence = retry;
		render();
	}

	document.addEventListener("change", async (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement) || input.id !== "progress-restore-file") return;
		const file = input.files?.[0];
		input.value = "";
		if (!file) return;
		try {
			if (file.size > 50 * 1024 * 1024) {
				throw new Error("The selected backup is too large to restore (50 MB maximum).");
			}
			const rawJson = await file.text();
			const snapshots = parseProgressBackup(rawJson, knownCertifications);
			if (!snapshots.some(({ certificationId }) => certificationId === cfg.slug)) {
				throw new Error(`The selected backup does not contain ${cfg.slug} progress.`);
			}
			restoreMessage = "";
			confirmAction(
				"Restore progress from backup?",
				`This replaces quiz progress and session history for ${cfg.title} with the data in this file. Other certifications will not change.`,
				"Restore progress",
				async () => {
					try {
						await progressService.restoreProgressBackup(rawJson);
						window.location.reload();
					} catch (error) {
						restoreMessage = error instanceof Error ? error.message : String(error);
						render();
					}
				},
			);
		} catch (error) {
			restoreMessage = error instanceof Error ? error.message : String(error);
			render();
		}
	});

	function handleInvalidation(message: string) {
		invalidationMessage = message;
		progressService
			.readState()
			.then((state) => {
				progressState = state;
				saved.stats = state.stats;
				render();
			})
			.catch(() => render());
	}

	progressService.onInvalidation(handleInvalidation);
	document.addEventListener("visibilitychange", () => {
		if (document.visibilityState !== "visible") return;
		const active = activeSession?.progress;
		progressService
			.checkForExternalChanges(active?.id, active?.revision)
			.catch((error) => setPersistenceError(error, () => window.location.reload()));
	});
	const activeEntry = progressState.history.find(
		({ session: item }) => item.status === "in_progress",
	);
	if (activeEntry) applyProgressSession(activeEntry.session, { trackActive: true });
	const requestedResultId = new URLSearchParams(window.location.search).get("result");
	if (requestedResultId) {
		const previous = progressState.history.find(
			({ session: item }) => item.id === requestedResultId,
		);
		if (previous) {
			applyProgressSession(previous.session, { trackActive: false });
		}
	}

	function esc(s: unknown): string {
		return String(s).replace(/[&<>"']/g, (char) => HTML_ESCAPES[char] ?? char);
	}

	function migrationNoticeList(warnings: readonly string[]): string {
		if (!warnings?.length)
			return '<p class="small muted">No legacy records required recovery notes.</p>';
		return `<ul class="small">${warnings.map((warning) => `<li>${esc(warning)}</li>`).join("")}</ul>`;
	}

	function getSelectCount(q: Question, id?: string): number {
		// Prefer the question's explicit selectCount when defined;
		// otherwise fall back to the answer-key length (from shuffled
		// session data or the original question).
		if (q.selectCount != null) return q.selectCount;
		const so = id ? session?.shuffledOptions?.[id] : undefined;
		if (so) return so.correctAnswers.length;
		return q.correctAnswers.length;
	}

	function answered(id: string): boolean {
		return Array.isArray(session?.answers?.[id]) && session.answers[id].length > 0;
	}

	// Shared accessor: returns { options, correctAnswers } for a question,
	// preferring the session's shuffled permutation when available.
	function getQuestionOptions(id: string): { options: string[]; correctAnswers: number[] } {
		const q = getQuestion(id);
		const so = session?.shuffledOptions?.[id];
		if (so) return { options: so.options, correctAnswers: so.correctAnswers };
		return { options: q.options, correctAnswers: q.correctAnswers };
	}

	function accurate(id: string): boolean {
		const currentSession = session;
		if (!currentSession) return false;
		return isAnswerCorrectWithShuffle(
			getQuestion(id),
			currentSession.answers[id] || [],
			currentSession.shuffledOptions,
			id,
		);
	}

	function getWeakCount(): number {
		return qs.filter((question) => saved.stats[question.id]?.lastWrong).length;
	}

	// --- Start session ---
	async function start(mode: SessionMode, domain?: string, amount?: number): Promise<void> {
		await checkpointQueue;
		let ids: string[] = [];
		if (mode === "exam") {
			for (const [d, n] of Object.entries(cfg.examBlueprint)) {
				const pool = qs.filter((q) => q.domain === d);
				ids.push(
					...shuffle(pool)
						.slice(0, n)
						.map((q) => q.id),
				);
			}
			ids = shuffle(ids);
		} else if (mode === "weak") {
			const weak = qs.filter((q) => saved.stats[q.id]?.lastWrong);
			if (!weak.length) return;
			ids = shuffle(weak).map((q) => q.id);
		} else {
			let pool = [...qs];
			if (domain && domain !== "all") {
				pool = pool.filter((q) => q.domain === domain);
			}
			const n = amount || pool.length;
			ids = shuffle(pool)
				.slice(0, n)
				.map((q) => q.id);
		}
		if (!ids.length) return;
		const shuffledOptions: Record<string, ShuffledQuestionOptions> = {};
		for (const id of ids) {
			shuffledOptions[id] = shuffleQuestionOptions(byId[id]);
		}
		const now = Date.now();
		const deadline = mode === "exam" ? now + (cfg.examMinutes ?? 120) * 60 * 1000 : null;
		const previousSession =
			activeSession?.progress?.status === "in_progress"
				? { id: activeSession.progress.id, revision: activeSession.progress.revision }
				: undefined;
		const savedSession = await progressService.startQuizSession(
			mode,
			ids,
			shuffledOptions,
			deadline,
			previousSession,
		);
		applyProgressSession(savedSession);
		saved.stats = (await progressService.readState()).stats;
		setResumeUrl(true);
		render("question");
		window.scrollTo({ top: 0, behavior: "smooth" });
	}

	async function requestStart(
		mode: SessionMode,
		domain?: string,
		amount?: number,
	): Promise<unknown> {
		if (activeSession && activeSession.progress.status === "in_progress") {
			const activeType = activeSession.mode === "exam" ? "mock exam" : "practice session";
			return confirmAction(
				"Replace active session?",
				`Your saved ${activeType} will be replaced. If you cancel, your answers and timer remain unchanged.`,
				"Replace session",
				() => start(mode, domain, amount),
			);
		}
		await start(mode, domain, amount);
	}

	function setResumeUrl(shouldResume: boolean): void {
		const url = new URL(window.location.href);
		if (shouldResume && activeSession) {
			session = activeSession;
			url.searchParams.set("mode", activeSession.mode === "exam" ? "assess" : "practice");
			url.searchParams.set("resume", "1");
			url.searchParams.delete("result");
		} else {
			url.searchParams.delete("resume");
			url.searchParams.delete("result");
		}
		history.replaceState(null, "", url);
		window.dispatchEvent(new Event("practice-lab:workspace-mode-change"));
	}

	// --- Home view ---
	function home(): void {
		const values = qs.map(
			(question) => saved.stats[question.id] || { attempts: 0, correct: 0, lastWrong: false },
		);
		const attempted = values.filter((s) => s.attempts > 0).length;
		const mastered = values.filter((s) => s.attempts > 0 && !s.lastWrong).length;
		const weak = getWeakCount();
		const assessSetup = new URLSearchParams(window.location.search).get("mode") === "assess";

		const readinessPct = pct(mastered, qs.length);
		const bpLabel = cfg.blueprintSource === "official" ? "Exam weight" : "Bank distribution";
		const cards = Object.entries(cfg.domains)
			.map(([d, domainConfig]) => {
				const list = qs.filter((q) => q.domain === d);
				const done = list.filter((q) => saved.stats[q.id]?.attempts);
				return `<div class="domainRow"><span><strong>${d}</strong> ${esc(domainConfig.name)}<br><span class="muted small">${bpLabel} ${domainConfig.weight}%</span></span><strong>${done.length}/${list.length}</strong></div>`;
			})
			.join("");
		const historyItems = progressState.history
			.filter(({ session: item }) => item.status === "completed" || item.status === "expired")
			.slice(0, 5)
			.map(
				({ session: item }) =>
					`<button class="ghost small" data-action="review-result" data-id="${esc(item.id)}">${esc(item.mode)} · ${new Date(item.startedAt).toLocaleDateString()} · ${item.status}</button>`,
			)
			.join("");
		const setupContent = assessSetup
			? `<div class="panel examSetup">
				<h3>Timed mock exam</h3>
				<p>${cfg.totalQuestions} questions mapped to the ${cfg.blueprintSource === "official" ? "official blueprint" : "available question-bank distribution"}.</p>
				<p class="small muted">${cfg.examMinutes ?? 120} minutes. The timer continues if you leave; return here to resume your saved exam.</p>
				<button class="primary" data-action="start-exam" ${progressState.migrationPending || progressState.legacyWriteDetected ? "disabled" : ""}>Start mock exam</button>
			</div>`
			: `<div class="config configTop">
				<div>
					<label class="small" for="domain">Practice focus</label>
					<select class="select" id="domain">
						<option value="all" ${requestedDomain === "all" ? "selected" : ""}>All domains</option>
						<optgroup label="Exam domains">
							${Object.entries(cfg.domains)
								.map(
									([id, d]) =>
										`<option value="${id}" ${requestedDomain === id ? "selected" : ""}>${id} · ${esc(d.name)}</option>`,
								)
								.join("")}
						</optgroup>
					</select>
				</div>
				<div>
					<label class="small" for="amount">Questions</label>
					<select class="select" id="amount">
						<option value="10">10</option>
						<option value="20" selected>20</option>
						<option value="50">50</option>
						<option value="${qs.length}">All available</option>
					</select>
				</div>
			</div>
			<div class="modes">
				<button class="mode" data-action="start-practice" ${progressState.migrationPending || progressState.legacyWriteDetected ? "disabled" : ""}>
					<strong>Practice mode</strong>
					<p>Instant feedback, explanations and links to primary documentation. Study by exam domain or focus on your weakest areas.</p>
