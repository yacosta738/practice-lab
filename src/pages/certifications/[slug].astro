	// --- Question view ---
	function question(focusTarget?: string): void | Promise<void> {
		const currentSession = session;
		if (!currentSession || currentSession.submitted) return home();
		if (
			currentSession.mode === "exam" &&
			currentSession.deadline &&
			currentSession.deadline <= Date.now()
		)
			return finish(true);
		if (currentSession.currentIndex >= currentSession.ids.length)
			return currentSession.mode === "exam" ? examReview() : finish(false);

		const id = currentSession.ids[currentSession.currentIndex];
		if (!id) return home();
		const x = getQuestion(id);
		const v = currentSession.answers[id] || [];
		const checked = !!currentSession.checked[id];
		const isExam = currentSession.mode === "exam";
		const isLast = currentSession.currentIndex === currentSession.ids.length - 1;
		const good = checked && accurate(id);
		const progress = currentSession.ids.filter(answered).length;

		// Shared accessor: shuffled session data wins, otherwise original question.
		const { options: displayOptions, correctAnswers: displayCorrect } = getQuestionOptions(id);

		const opts = displayOptions
			.map((t, n) => {
				let status = "";
				if (checked)
					status =
						displayCorrect.includes(n) && v.includes(n)
							? " good"
							: displayCorrect.includes(n)
								? " missing"
								: v.includes(n)
									? " bad"
									: "";
				else if (v.includes(n)) status = " selected";
				return `<button class="option${status}" data-action="pick" data-value="${n}" data-focus-target="answer-${n}" aria-pressed="${v.includes(n)}" ${checked ? "disabled" : ""}>
				<span class="letter">${LETTERS[n]}</span><span>${esc(t)}</span>
			</button>`;
			})
			.join("");

		const src = x.source;
		const domainStudyLink = studyHref ? `${studyHref}#${x.domain}` : "";
		const questionVersion = x.contentVersion || "1";
		let fb = "";
		if (checked)
			fb = `<div class="feedback ${good ? "correct" : "wrong"}" data-focus-target="feedback" tabindex="-1" role="status">
			<strong>${good ? "Correct — well reasoned." : "Not quite — review the reasoning."}</strong>
			<p>${esc(x.explanation)}</p>
			${x.whyNot ? `<p class="small muted">Why not the others: ${esc(x.whyNot)}</p>` : ""}
			<div class="feedbackLinks">
				${src.url ? `<a href="${esc(src.url)}" target="_blank" rel="noopener noreferrer">Study source: ${esc(src.label)} ↗</a>` : `<span class="small muted">Study source: ${esc(src.label)}</span>`}
				${domainStudyLink ? `<a href="${esc(domainStudyLink)}" data-action="go-to-site-home">Read ${x.domain} study notes →</a>` : ""}
				<button type="button" class="pl-feedback-link" data-pl-open-feedback data-feedback-type="question" data-feedback-cert="${esc(cfg.slug)}" data-feedback-domain="${esc(x.domain)}" data-feedback-question="${esc(x.id)}" data-feedback-version="${esc(questionVersion)}" data-feedback-category="incorrect-explanation" aria-haspopup="dialog" aria-controls="pl-feedback-dialog">Question this explanation</button>
			</div>
		</div>`;

		const examBar = isExam
			? `<div class="examBar" role="region" aria-label="Exam status">
				<div class="examBarLeft">
					<span class="badge">EXAM</span>
					<strong class="mono">Q ${currentSession.currentIndex + 1}/${currentSession.ids.length}</strong>
					<span class="small muted">${progress} answered · ${currentSession.flags.length} flagged</span>
				</div>
				<div class="examBarRight">
					<div id="clock" class="clock clockInline" aria-label="Time remaining">${clockText()}</div>
					<button class="ghost small" data-action="exit-exam">Exit exam</button>
					<button class="ghost small" data-action="finish">Submit exam</button>
				</div>
			</div>`
			: "";

		const main = `<h1 class="sr-only">${esc(cfg.title)} — ${isExam ? "Mock exam" : "Practice session"}</h1>
			${examBar}
			<div class="qhead"><span>Question ${currentSession.currentIndex + 1} of ${currentSession.ids.length} · ${esc(currentSession.mode.toUpperCase())}</span><span class="qheadRight">${progress} answered · <span class="kbdHint">Keys 1–4 · Enter</span></span></div>
			<progress class="progress" value="${currentSession.currentIndex + 1}" max="${currentSession.ids.length}" aria-label="Question progress"></progress>
			<div class="panel question" style="margin-top:14px">
				<span class="badge">${x.domain} · ${esc(domains[x.domain].name)}</span>
				${x.topic ? `<span class="muted small" style="margin-left:8px">${esc(x.topic)}</span>` : ""}
				<h2 data-focus-target="question" tabindex="-1">${esc(x.question)}</h2>
		 <p class="hint" data-select-count="${getSelectCount(x, id)}">${getSelectCount(x, id) === 1 ? "Select ONE answer." : `Select exactly ${getSelectCount(x, id)} answers.`}${isExam ? " Your choices stay editable until you submit." : " Check your answer to see the explanation."}</p>
				${opts}${fb}
				<div class="actions">
					${currentSession.currentIndex > 0 ? `<button class="ghost" data-action="prev">← Previous</button>` : ""}
					${
						isExam
							? `<button class="ghost" data-action="flag" data-focus-target="flag" aria-pressed="${currentSession.flags.includes(id)}"><span aria-hidden="true">⚑</span> ${currentSession.flags.includes(id) ? "Flagged" : "Flag for review"}</button>
						<button class="primary" data-action="next">${isLast ? "Go to review" : "Next →"}</button>`
							: checked
								? `<button class="primary" data-action="next">${isLast ? "Finish session" : "Next question →"}</button>`
								: `<button class="primary" data-action="check" ${v.length === getSelectCount(x, id) ? "" : "disabled"}>Check answer</button>`
					}
				</div>
				${
					!isExam
						? `<div class="pl-question-meta">
					<span class="mono small muted">Question ID: ${esc(cfg.subtitle)}-${esc(x.id)} · v${esc(questionVersion)}</span>
					<button type="button" class="pl-feedback-link" data-pl-open-feedback data-feedback-type="question" data-feedback-cert="${esc(cfg.slug)}" data-feedback-domain="${esc(x.domain)}" data-feedback-question="${esc(x.id)}" data-feedback-version="${esc(questionVersion)}" aria-haspopup="dialog" aria-controls="pl-feedback-dialog">Report an issue</button>
				</div>`
						: ""
				}
			</div>`;

		const grid = currentSession.ids
			.map((qid, k) => {
				const isCurrent = k === currentSession.currentIndex;
				const isAnswered = answered(qid);
				const isFlagged = currentSession.flags.includes(qid);
				const stateLabel = `${isAnswered ? "answered" : "unanswered"}, ${isFlagged ? "flagged for review" : "not flagged for review"}${isCurrent ? ", current question" : ""}`;
				const stateMarks = `${isAnswered ? "✓" : "—"}${isFlagged ? " ⚑" : ""}${isCurrent ? " ●" : ""}`;

				return `<button class="qchip${isCurrent ? " current" : ""}${isAnswered ? " answered" : ""}${isFlagged ? " flagged" : ""}" data-action="jump" data-value="${k}" aria-label="Question ${k + 1}, ${stateLabel}"${isCurrent ? ' aria-current="step"' : ""}><span class="qchipNumber">${k + 1}</span><span class="qchipMarks" aria-hidden="true">${stateMarks}</span></button>`;
			})
			.join("");

		const legend = `<ul class="qchipLegend">
			<li><span aria-hidden="true">✓</span> Answered</li>
			<li><span aria-hidden="true">—</span> Unanswered</li>
			<li><span aria-hidden="true">⚑</span> Flagged for review</li>
			<li><span aria-hidden="true">●</span> Current question</li>
		</ul>`;
		const navigatorContent = `<p class="small muted">Jump to any question.</p>
			${legend}
			<div class="small muted">${progress}/${currentSession.ids.length} answered · ${currentSession.flags.length} flagged</div>
			<div class="qgrid" role="region" aria-label="Question list" tabindex="0">${grid}</div>
			<button class="ghost" data-action="finish">Submit mock exam</button>`;
		const side = isExam
			? `<details class="panel side examNavigator" ${examNavigatorExpanded ? "open" : ""}>
				<summary><span>Question navigator</span><span class="small muted">${progress}/${currentSession.ids.length} answered</span></summary>
				${navigatorContent}
			</details>`
			: `<aside class="panel side">
				<h3>Study session</h3>
				<p class="small muted">Immediate rationale and primary-source references after each answer.</p>
				${legend}
				<div class="small muted">${progress}/${currentSession.ids.length} answered</div>
				<div class="qgrid" role="region" aria-label="Question list" tabindex="0">${grid}</div>
				<button class="ghost" data-action="home">Pause & go home</button>
			</aside>`;

		setAppHTML(`<div class="split"><div>${main}</div>${side}</div>`, focusTarget);
	}

	function clockText(): string {
		if (!session?.deadline) return "";
		return formatTime(session.deadline - Date.now());
	}

	function tick(): void {
		const running = activeSession;
		if (
			running?.progress.status !== "in_progress" ||
			running.mode !== "exam" ||
			running.deadline === null
		) {
			return;
		}
		if (session?.progress.id === running.progress.id) {
			const e = document.getElementById("clock");
			if (e) {
				e.textContent = clockText();
				e.classList.toggle("warn", running.deadline - Date.now() < 600000);
			}
		}
		if (running.deadline <= Date.now()) void finish(true, running);
	}

	async function finish(
		timed = false,
		sessionToFinish: QuizSessionView | null = session,
	): Promise<void> {
		if (!sessionToFinish || sessionToFinish.submitted || finishing || persistenceError) return;
		finishing = true;
		const isDisplayedSession = session?.progress.id === sessionToFinish.progress.id;
		if (isDisplayedSession) {
			try {
				await checkpointQueue;
			} catch (error) {
				finishing = false;
				setPersistenceError(error, () => finish(timed, sessionToFinish));
				return;
			}
		}
		const evaluations = sessionToFinish.ids.flatMap((id) => {
			const selectedIndexes = sessionToFinish.answers[id] || [];
			if (!selectedIndexes.length || sessionToFinish.checked[id]) return [];
			const optionIds = sessionToFinish.shuffledOptions?.[id]?.optionIds || [];
			const selectedOptionIds = selectedIndexes.map((index) => optionIds[index]);
			const correctAnswers =
				sessionToFinish.shuffledOptions?.[id]?.correctAnswers || getQuestion(id).correctAnswers;
			const correct =
				selectedIndexes.length === correctAnswers.length &&
				selectedIndexes.every((index) => correctAnswers.includes(index));
			const outcome: EvaluationOutcome = correct ? "correct" : "incorrect";
			return [
				{
					sessionId: sessionToFinish.progress.id,
					questionId: id,
					selectedOptionIds,
					outcome,
					scoreEarned: correct ? 1 : 0,
					scorePossible: 1,
				},
			];
		});
		try {
			const completed = await progressService.finalizeSession(
				sessionToFinish.progress.id,
				sessionToFinish.progress.revision,
				timed ? "expired" : "completed",
				evaluations,
			);
			progressState = await progressService.readState();
			saved.stats = progressState.stats;
			if (isDisplayedSession) applyProgressSession(completed);
			else applyProgressSession(completed, { display: false });
			persistenceError = null;
			retryPersistence = null;
			finishing = false;
			if (isDisplayedSession) {
				const url = new URL(window.location.href);
				url.searchParams.delete("resume");
				url.searchParams.set("result", completed.id);
				history.replaceState(null, "", url);
				window.dispatchEvent(new Event("practice-lab:workspace-mode-change"));
				results();
				window.scrollTo({ top: 0, behavior: "smooth" });
			} else if (!session) {
				home();
			}
		} catch (error) {
			finishing = false;
			setPersistenceError(error, () => finish(timed, sessionToFinish));
		}
	}

	// --- Results view ---
	function results(): void {
		const currentSession = session;
		if (!currentSession) {
			home();
			return;
		}
		const ids = currentSession.ids;
		const correct = ids.filter((id) => answered(id) && accurate(id));
		const score = pct(correct.length, ids.length);

		// Show passing threshold reference when configured
		let passingBandHtml = "";
		const passingScore = currentSession.progress?.scoring?.passingScore ?? cfg.passingScore;
		if (passingScore) {
			passingBandHtml = `
				<div class="infoCallout">
					<strong>Reference passing threshold: ${passingScore} / 1,000</strong>
					<p class="small muted" style="margin:4px 0 0">The official exam uses a scaled scoring model. This practice score is a raw percentage and cannot predict the scaled result.</p>
				</div>`;
		}

		const resultDomains = [...new Set(ids.map((id) => getQuestion(id).domain))];
		const rows = resultDomains
			.map((d) => {
				const domainConfig = getDomain(d);
				const list = ids.filter((id) => getQuestion(id).domain === d);
				if (!list.length) return "";
				const ok = list.filter((id) => correct.includes(id)).length;
				const domainPct = pct(ok, list.length);
				const studyLink =
					studyHref && domainPct < 80
						? `<a class="small wsTextLink" href="${esc(studyHref)}#${d}" data-action="go-to-site-home">Study ${d} →</a>`
						: "";
				return `<div class="domainRow"><span><strong>${d}</strong> · ${esc(domainConfig.name)} ${studyLink}</span><strong>${ok}/${list.length} (${domainPct}%)</strong></div>`;
			})
			.join("");

		const missedCount = ids.filter((id) => !(answered(id) && accurate(id))).length;
		const flaggedCount = currentSession.flags.length;
		const filteredIds = ids
			.map((id, k) => ({ id, k }))
			.filter(({ id }) => {
				if (reviewFilter === "missed") return !(answered(id) && accurate(id));
				if (reviewFilter === "flagged") return currentSession.flags.includes(id);
				return true;
			});

		const rev = filteredIds.length
			? filteredIds
					.map(({ id, k }) => {
						const q = getQuestion(id);
						const v = currentSession.answers[id] || [];
						const ok = accurate(id) && answered(id);
						const { options: revOptions, correctAnswers: revCorrect } = getQuestionOptions(id);
						return `<details class="panel review"><summary><span class="badge">${q.domain}</span> ${k + 1}. ${ok ? "✓" : "✕"} ${esc(q.question)}</summary>
				<div class="small muted" style="margin:9px 16px">Your selection: ${v.length ? v.map((n) => LETTERS[n]).join(", ") : "Unanswered"} · Correct: ${revCorrect.map((n) => LETTERS[n]).join(", ")}</div>
				${revOptions.map((t, n) => `<div class="option${revCorrect.includes(n) ? " good" : v.includes(n) ? " bad" : ""}"><span class="letter">${LETTERS[n]}</span><span>${esc(t)}</span></div>`).join("")}
				<p>${esc(q.explanation)}</p>
				${q.whyNot ? `<p class="small muted">Why not the others: ${esc(q.whyNot)}</p>` : ""}
				<div class="pl-review-meta">
					${q.source.url ? `<a href="${esc(q.source.url)}" target="_blank" rel="noopener noreferrer">${esc(q.source.label)} ↗</a>` : `<span class="small muted">${esc(q.source.label)}</span>`}
					<button type="button" class="pl-feedback-link" data-pl-open-feedback data-feedback-type="question" data-feedback-cert="${esc(cfg.slug)}" data-feedback-domain="${esc(q.domain)}" data-feedback-question="${esc(q.id)}" data-feedback-version="${esc(q.contentVersion || "1")}" aria-haspopup="dialog" aria-controls="pl-feedback-dialog">Report an issue (${esc(q.id)})</button>
				</div>
			</details>`;
					})
					.join("")
			: `<p class="panel muted">No questions match this filter.</p>`;

		setAppHTML(`
			<div class="results">
				<div class="panel padded">
					<h1>${currentSession.mode === "exam" ? "Mock exam results" : "Practice session results"}${currentSession.timedOut ? " · time expired" : ""}</h1>
					<div class="score" style="margin:12px 0">
						<div class="ring" style="--score:${score}%">
							<span>${score}%</span>
						</div>
						<div>
							<h2 class="scoreHeading">${correct.length} / ${ids.length} correct</h2>
							<p class="muted" style="margin:0">Unofficial practice score · not equivalent to the scaled passing score.</p>
						</div>
					</div>
					${passingBandHtml}
					<div class="actions">
						<button class="primary" data-action="home">Back to dashboard</button>
						<button class="ghost" data-action="start-weak" ${getWeakCount() ? "" : "disabled"}>Retake missed questions</button>
						<button class="ghost" data-action="start-exam">New mock exam</button>
					</div>
				</div>
				<section class="section">
					<h2>Performance by domain</h2>
					<div class="domainGrid">${rows}</div>
				</section>
				<section class="section">
					<div class="sectionHead">
						<div>
							<h2>Review every answer</h2>
							<p class="muted small" style="margin:4px 0 0">Open an item to see the correct option, rationale and primary documentation.</p>
						</div>
						<div class="filterBar" role="group" aria-label="Filter reviewed answers">
							<button type="button" class="filterBtn" data-action="filter-review" data-value="all" aria-pressed="${reviewFilter === "all"}">All (${ids.length})</button>
							<button type="button" class="filterBtn" data-action="filter-review" data-value="missed" aria-pressed="${reviewFilter === "missed"}">Missed (${missedCount})</button>
							<button type="button" class="filterBtn" data-action="filter-review" data-value="flagged" aria-pressed="${reviewFilter === "flagged"}">Flagged (${flaggedCount})</button>
						</div>
					</div>
					${rev}
				</section>
			</div>`);
	}

	// --- Exam review ---
	function examReview(): void {
		const currentSession = session;
		if (!currentSession) {
			home();
			return;
		}
		const un = currentSession.ids.filter((id) => !answered(id)).length;
		setAppHTML(`<div class="panel padded results">
			<h1>Review your answer sheet.</h1>
			<p class="lead">${currentSession.ids.length - un} answered · ${un} unanswered · ${currentSession.flags.length} flagged. Time remaining: ${clockText()}.</p>
			<div class="actions">
				<button class="ghost" data-action="back-to-exam">Review questions</button>
				<button class="primary" data-action="finish">Submit and score</button>
			</div>
		</div>`);
	}

	// --- Render ---
	function render(focusTarget?: string): void {
		if (
			session &&
			!session.submitted &&
			new URLSearchParams(window.location.search).get("resume") === "1"
		)
			question(focusTarget);
		else if (session && !session.submitted) home();
		else if (session?.submitted) results();
		else home();
		tick();
	}

	// --- Event handlers ---
	async function checkAnswer(id: string): Promise<void> {
		if (!session || session.checked[id] || checking) return;
		checking = true;
		try {
			await checkpointQueue;
		} catch (error) {
			checking = false;
			setPersistenceError(error, () => checkAnswer(id));
			return;
		}
		if (!session || session.checked[id]) {
			checking = false;
			return;
		}
		const selectedIndexes = session.answers[id] || [];
		if (selectedIndexes.length !== getSelectCount(getQuestion(id))) {
			checking = false;
			return;
		}
		const optionIds = session.shuffledOptions?.[id]?.optionIds || [];
		const selectedOptionIds = selectedIndexes.map((index) => optionIds[index]);
		const correct = accurate(id);
		try {
			const result = await progressService.recordEvaluation({
				sessionId: session.progress.id,
				questionId: id,
				selectedOptionIds,
				outcome: correct ? "correct" : "incorrect",
				scoreEarned: correct ? 1 : 0,
				scorePossible: 1,
				expectedRevision: session.progress.revision,
			});
			if (result.session) {
				session.progress.revision = result.session.revision;
				session.progress.status = result.session.status;
			}
			session.checked[id] = true;
			progressState = await progressService.readState();
			saved.stats = progressState.stats;
			persistenceError = null;
			retryPersistence = null;
			question("feedback");
		} catch (error) {
			setPersistenceError(error, () => checkAnswer(id));
		} finally {
			checking = false;
		}
	}

	function saveThen(write: () => Promise<unknown>, onSaved: () => unknown): Promise<void> {
		const attempt = async () => {
			try {
				await write();
				persistenceError = null;
				retryPersistence = null;
				onSaved();
			} catch (error) {
				setPersistenceError(error, attempt);
			}
		};
		return attempt();
	}

	delegateQuizActions(app, async (event, el) => {
		const action = el.dataset.action;
		if (!action) return;

		// Allow site-home link and unified Layout theme toggle to handle their own events
		if (action === "go-to-site-home" || action === "theme") return;
		event.preventDefault();
		if (action === "reload-progress") return window.location.reload();
		if (action === "select-restore-file") {
			const fileInput = document.getElementById("progress-restore-file");
			if (fileInput instanceof HTMLInputElement) fileInput.click();
			return;
		}
		if (action === "retry-storage") {
			if (!retryPersistence) return window.location.reload();
			return retryPersistence();
		}
		if (action === "download-recovery") {
			return progressService
				.downloadLocalLegacyBackup()
				.catch((error) => setPersistenceError(error, retryPersistence));
		}
		if (checking) return;
		if (persistenceError || (invalidationMessage && !progressState.legacyWriteDetected)) return;
		if (
			progressState.migrationPending &&
			!["download-backup", "migrate-progress"].includes(action)
		) {
			return;
		}
		if (
			progressState.legacyWriteDetected &&
			!["download-backup", "reconcile-legacy"].includes(action)
		) {
			return;
		}

		try {
			if (action === "download-backup") {
				await progressService.downloadDataBackup();
				progressState = await progressService.readState();
				persistenceError = null;
				render();
				return;
			}
			if (action === "reconcile-legacy") {
				progressState = await progressService.reconcileLegacyWrite();
				saved.stats = progressState.stats;
				invalidationMessage = "";
				persistenceError = null;
				render();
				return;
			}
			if (action === "migrate-progress") {
				progressState = await progressService.migrateLegacyProgress();
				saved.stats = progressState.stats;
				if (progressState.currentSession) {
					const currentSession = applyProgressSession(progressState.currentSession);
					if (currentSession.submitted) {
						const url = new URL(window.location.href);
						url.searchParams.set("result", currentSession.progress.id);
						history.replaceState(null, "", url);
					}
				}
				persistenceError = null;
				render();
				return;
			}
			if (action === "review-result") {
				const entry = progressState.history.find(({ session: item }) => item.id === el.dataset.id);
				if (!entry) throw new Error("This saved result is no longer available.");
				applyProgressSession(entry.session, { trackActive: false });
				const url = new URL(window.location.href);
				url.searchParams.delete("resume");
				url.searchParams.set("result", entry.session.id);
				history.replaceState(null, "", url);
				return results();
			}

			if (action === "home") {
				if (session && activeSession?.progress.id === session.progress?.id && !session.submitted) {
					await persist();
				}
				if (session?.submitted) session = null;
				setResumeUrl(false);
				return home();
			}
			if (action === "resume") {
				if (!activeSession) return home();
				session = activeSession;
				sessionQuestionsById = activeSession.questionsById || byId;
				sessionDomainsById = activeSession.domainsById || domains;
				setResumeUrl(true);
				return render();
			}
			if (action === "exit-exam") {
				return confirmAction(
					"Exit mock exam?",
					"Your answers will be saved, but the timer continues while you are away. Resume the exam from this certification page.",
					"Exit exam",
					async () => {
						await persist();
						setResumeUrl(false);
						home();
						window.scrollTo({ top: 0, behavior: "smooth" });
					},
				);
			}
			if (action === "reset-stats") {
				confirmAction(
					"Reset saved practice history?",
					"This permanently clears this certification's saved quiz sessions, attempts, and question statistics on this device. Study progress and downloaded backups are kept.",
					"Reset history",
					async () => {
						progressState = await progressService.resetProgress();
						saved.stats = progressState.stats;
						session = null;
						activeSession = null;
						sessionQuestionsById = {};
						setResumeUrl(false);
						home();
					},
				);
				return;
			}
			if (action === "filter-review") {
				reviewFilter = el.dataset.value || "all";
				results();
				const activeBtn = app.querySelector(
					`[data-action="filter-review"][data-value="${reviewFilter}"]`,
				);
				if (activeBtn instanceof HTMLElement) activeBtn.focus();
				return;
			}
			if (action === "start-practice") {
				const d = (document.getElementById("domain") as HTMLSelectElement | null)?.value || "all";
				const amountSelect = document.getElementById("amount");
				const n = amountSelect instanceof HTMLSelectElement ? Number(amountSelect.value) || 20 : 20;
				return await requestStart("practice", d, n);
			}
			if (action === "start-exam") return await requestStart("exam");
			if (action === "start-weak") return await requestStart("weak");
			const currentSession = session;
			if (!currentSession || currentSession.submitted) return;

			const id = currentSession.ids[currentSession.currentIndex];
			if (!id) return;
			const q = getQuestion(id);
			if (action === "pick") {
				if (currentSession.checked[id]) return;
				const n = Number(el.dataset.value);
				if (!Number.isSafeInteger(n) || n < 0 || n >= q.options.length) return;
				const vals = currentSession.answers[id] || [];
				const pickCount = getSelectCount(q);
				currentSession.answers[id] =
					pickCount === 1
						? [n]
						: vals.includes(n)
							? vals.filter((x) => x !== n)
							: vals.length >= pickCount
								? vals
								: [...vals, n];
				return saveThen(
					() => persist(),
					() => question(`answer-${n}`),
				);
			}
			if (action === "check") {
				return checkAnswer(id);
			}
			if (action === "prev") {
				currentSession.currentIndex = Math.max(0, currentSession.currentIndex - 1);
				return saveThen(
					() => persist(),
					() => question("question"),
				);
			}
			if (action === "next") {
				currentSession.currentIndex++;
				return saveThen(
					() => persist(),
					() => {
						if (currentSession.currentIndex >= currentSession.ids.length) {
							if (currentSession.mode === "exam") return examReview();
							return finish();
						}
						return question("question");
					},
				);
			}
			if (action === "jump") {
				// The guard applies to the destination question, not the one on screen.
				const targetIndex = Number(el.dataset.value);
				const targetId = currentSession.ids[targetIndex];
				if (!Number.isSafeInteger(targetIndex) || !targetId) return;
				if (currentSession.mode !== "exam" && !currentSession.checked[targetId]) return;
				currentSession.currentIndex = targetIndex;
				return saveThen(
					() => persist(),
					() => question("question"),
				);
			}
			if (action === "flag") {
				currentSession.flags = currentSession.flags.includes(id)
					? currentSession.flags.filter((x) => x !== id)
					: [...currentSession.flags, id];
				return saveThen(
					() => persist(),
					() => question("flag"),
				);
			}
			if (action === "finish") {
				confirmAction(
					"Submit mock exam?",
					"Your answers will be scored and rationales will be revealed immediately.",
					"Submit and score",
					() => finish(false),
				);
			}
		} catch (error) {
			setPersistenceError(error, () => window.location.reload());
		}
	});

	// Back to exam handler
	document.addEventListener("click", async (e) => {
		if (!(e.target instanceof Element) || !e.target.closest('[data-action="back-to-exam"]')) return;
		e.preventDefault();
		if (!session) return;
		session.currentIndex = 0;
		return saveThen(
			() => persist(),
			() => question(),
		);
	});

	// Keyboard shortcuts
	document.addEventListener("keydown", (e) => {
		if (
			!session ||
			session.submitted ||
			e.altKey ||
			e.metaKey ||
			e.ctrlKey ||
			document.querySelector("dialog[open]") ||
			/INPUT|SELECT|TEXTAREA/.test(document.activeElement?.tagName || "")
		)
			return;
		const optionIndex = optionKeys.indexOf(e.key);
		if (optionIndex !== -1) {
			const b = app.querySelector<HTMLButtonElement>(
				`[data-action="pick"][data-value="${optionIndex}"]`,
			);
			if (b && !b.disabled) b.click();
		} else if (
			e.key === "Enter" &&
			(document.activeElement === document.body ||
				document.activeElement?.matches('[data-action="pick"]'))
		) {
			const b = app.querySelector<HTMLButtonElement>(
				'[data-action="check"]:not(:disabled),[data-action="next"]',
			);
			if (b) {
				e.preventDefault();
				b.click();
			}
		}
	});

	setInterval(tick, 1000);
	render();
})().catch(showProgressFailure);
</script>
