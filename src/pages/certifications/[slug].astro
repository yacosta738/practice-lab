---
// Dynamic certification page — loads config and questions server-side

import QuizLayout from "../../layouts/QuizLayout.astro";
import { base } from "../../lib/base";
import { OPTION_SHORTCUT_KEYS } from "../../lib/quiz-keys";
import type { CertificationConfig, Question } from "../../lib/quiz-types";
import { studyCerts } from "../../study/registry";

/** Extract the certification slug from a glob key (segment immediately before config.ts / questions.ts) */
function extractSlug(path: string): string {
	const match = path.match(/(?:^|\/)([^/]+)\/(?:config|questions)\.ts$/);
	return match ? match[1] : "";
}

// Auto-discover config and questions modules for all certifications
const configModules = import.meta.glob("../../certifications/*/config.ts", { eager: true });
const questionsModules = import.meta.glob("../../certifications/*/questions.ts", { eager: true });

// Build maps keyed by slug
const configMap: Record<string, { config: CertificationConfig }> = {};
const questionsMap: Record<string, { questions: Question[] }> = {};
for (const [path, mod] of Object.entries(configModules)) {
	const slug = extractSlug(path);
	if (slug) configMap[slug] = mod as { config: CertificationConfig };
}
for (const [path, mod] of Object.entries(questionsModules)) {
	const slug = extractSlug(path);
	if (slug) questionsMap[slug] = mod as { questions: Question[] };
}

// Slugs that have study notes
const studySlugs = new Set(studyCerts.map((c) => c.slug));

export const prerender = true;

// getStaticPaths is extracted by Astro into a separate module, so it must
// be fully self-contained — no references to frontmatter variables.
export async function getStaticPaths() {
	const modules = import.meta.glob("../../certifications/*/config.ts", { eager: true });
	const slugs = Object.keys(modules)
		.map((path) => {
			const m = path.match(/(?:^|\/)([^/]+)\/(?:config|questions)\.ts$/);
			return m ? m[1] : "";
		})
		.filter((s) => s.length > 0);
	return slugs.map((slug) => ({
		params: { slug },
	}));
}

const slug = Astro.params.slug;
const certConfig = configMap[slug]?.config;
const questions = questionsMap[slug]?.questions ?? [];

// Only pass studyHref when the certification actually has study notes
const studyHref = studySlugs.has(slug) ? `${base}study/${slug}/` : undefined;
const sidebarDomains = Object.entries(certConfig.domains).map(([id, d]) => ({
	id,
	name: d.name,
	weight: d.weight,
	href: studyHref ? `${studyHref}#${id}` : "#coverage",
}));
---

<QuizLayout
	title={certConfig.title}
	subtitle={certConfig.subtitle}
	slug={certConfig.slug}
	description={certConfig.description}
	studyHref={studyHref}
	domains={sidebarDomains}
	theme={certConfig.theme}
>
	<!-- Quiz data passed inline -->
</QuizLayout>

<script
	define:vars={{
		cfg: certConfig,
		qs: questions,
		optionKeys: OPTION_SHORTCUT_KEYS,
		studyHref,
		base,
	}}
	is:inline
>
(function () {
	// cfg and qs are provided by define:vars above
	if (!cfg || !qs) return;

	// Build lookup maps
	const byId = {};
	for (const q of qs) {
		byId[q.id] = q;
	}
	const domains = {};
	for (const [key, d] of Object.entries(cfg.domains)) {
		domains[key] = { name: d.name, weight: d.weight };
	}

	// Shuffle the options of a question and remap correctAnswers.
	// Returns { options: string[], correctAnswers: number[] }.
	function shuffleQuestionOptions(q) {
		const indices = q.options.map((_, i) => i);
		const shuffled = shuffle(indices);
		const newOptions = shuffled.map((i) => q.options[i]);
		const newCorrect = q.correctAnswers.map((origIdx) => shuffled.indexOf(origIdx));
		return { options: newOptions, correctAnswers: newCorrect };
	}

	const KEY = `${cfg.slug}-practice-lab-v2`;
	const LETTERS = "ABCDE";
	const app = document.getElementById("app");
	let reviewFilter = "all";
	const params = new URLSearchParams(window.location.search);
	const rawDomain = params.get("domain");
	const requestedDomain = rawDomain && Object.hasOwn(cfg.domains, rawDomain) ? rawDomain : "all";
	let examNavigatorExpanded = !window.matchMedia("(max-width: 860px)").matches;

	// Native <dialog> confirmation helper (replaces window.confirm())
	function confirmAction(title, message, okLabel, onConfirm) {
		const dialog = document.getElementById("pl-confirm-dialog");
		if (!dialog || typeof dialog.showModal !== "function") {
			if (window.confirm(message)) onConfirm();
			return;
		}
		const titleEl = document.getElementById("pl-confirm-title");
		const msgEl = document.getElementById("pl-confirm-message");
		const okBtn = document.getElementById("pl-confirm-ok");
		if (titleEl) titleEl.textContent = title;
		if (msgEl) msgEl.textContent = message;
		if (okBtn) okBtn.textContent = okLabel;
		const onClose = () => {
			const val = dialog.returnValue;
			dialog.returnValue = "";
			if (val === "confirm") onConfirm();
		};
		dialog.addEventListener("close", onClose, { once: true });
		dialog.showModal();
	}

	// Safe HTML renderer — uses Element.setHTML() with Sanitizer API when available,
	// falls back to innerHTML for browsers without support (e.g. Safari).
	// The quiz content is trusted (from the question bank), so the sanitizer allows
	// data-* attributes required for event delegation.
	function setAppHTML(html, focusTarget) {
		if ("setHTML" in Element.prototype && typeof Sanitizer !== "undefined") {
			try {
				const sanitizer = new Sanitizer({
					allowDataAttributes: true,
				});
				app.setHTML(html, { sanitizer });
			} catch (_) {
				app.innerHTML = html;
			}
		} else {
			app.innerHTML = html;
		}
		syncFocusMode();
		if (focusTarget) {
			const target = app.querySelector(`[data-focus-target="${focusTarget}"]`);
			if (target instanceof HTMLElement) target.focus();
		}
		const navigator = app.querySelector("details.examNavigator");
		navigator?.addEventListener("toggle", () => {
			examNavigatorExpanded = navigator.open;
		});
	}

	function syncFocusMode() {
		const shell = document.querySelector(".pl-shell");
		if (!shell) return;
		const active =
			session?.mode === "exam" &&
			!session.submitted &&
			new URLSearchParams(window.location.search).get("resume") === "1";
		shell.setAttribute("data-exam-focus", active ? "true" : "false");
	}

	// --- Storage ---
	function getSaved() {
		try {
			const x = JSON.parse(localStorage.getItem(KEY));
			return x && typeof x === "object" ? x : { stats: {}, session: null };
		} catch {
			return { stats: {}, session: null };
		}
	}
	let saved = getSaved();
	if (!saved.stats || typeof saved.stats !== "object") saved.stats = {};

	// A restored session may come from an older schema, from a hand-edited
	// record, or from a question bank that no longer holds some of its ids.
	// Validate it before use so a stale record degrades into a fresh session
	// instead of a permanently blank page.
	function restoreSession(raw) {
		if (!raw || typeof raw !== "object") return null;
		if (!["practice", "exam", "weak"].includes(raw.mode)) return null;
		if (!Array.isArray(raw.ids)) return null;
		const ids = raw.ids.filter((id) => byId[id]);
		if (!ids.length) return null;
		const answers = raw.answers && typeof raw.answers === "object" ? raw.answers : {};
		const checked = raw.checked && typeof raw.checked === "object" ? raw.checked : {};
		const flags = Array.isArray(raw.flags) ? raw.flags.filter((id) => byId[id]) : [];
		const index =
			Number.isInteger(raw.currentIndex) && raw.currentIndex >= 0 && raw.currentIndex < ids.length
				? raw.currentIndex
				: 0;
		// Restore shuffledOptions so saved answer indexes remain meaningful.
		// For legacy sessions without shuffledOptions, answers were recorded
		// against the original option order, so grading falls back to that.
		const shuffledOptions =
			raw.shuffledOptions && typeof raw.shuffledOptions === "object"
				? raw.shuffledOptions
				: undefined;
		return {
			mode: raw.mode,
			ids,
			currentIndex: index,
			answers,
			checked,
			flags,
			created: Number.isFinite(raw.created) ? raw.created : Date.now(),
			deadline: Number.isFinite(raw.deadline) ? raw.deadline : null,
			submitted: raw.submitted === true,
			timedOut: raw.timedOut === true,
			finished: Number.isFinite(raw.finished) ? raw.finished : undefined,
			shuffledOptions,
		};
	}

	let session = restoreSession(saved.session);
	saved.session = session;

	function persist() {
		saved.session = session;
		try {
			localStorage.setItem(KEY, JSON.stringify(saved));
		} catch {}
	}

	persist();

	// --- Engine functions ---
	function shuffle(arr) {
		const a = [...arr];
		for (let i = a.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[a[i], a[j]] = [a[j], a[i]];
		}
		return a;
	}

	function pct(n, t) {
		return t ? Math.round((n / t) * 100) : 0;
	}

	function esc(s) {
		return String(s).replace(
			/[&<>"']/g,
			(c) =>
				({
					"&": "&amp;",
					"<": "&lt;",
					">": "&gt;",
					'"': "&quot;",
					"'": "&#39;",
				})[c],
		);
	}

	function getSelectCount(q, id) {
		// Prefer the question's explicit selectCount when defined;
		// otherwise fall back to the answer-key length (from shuffled
		// session data or the original question).
		if (q.selectCount != null) return q.selectCount;
		const so = session?.shuffledOptions?.[id];
		if (so) return so.correctAnswers.length;
		return q.correctAnswers.length;
	}

	function answered(id) {
		return Array.isArray(session?.answers?.[id]) && session.answers[id].length > 0;
	}

	// Shared accessor: returns { options, correctAnswers } for a question,
	// preferring the session's shuffled permutation when available.
	function getQuestionOptions(id) {
		const q = byId[id];
		const so = session?.shuffledOptions?.[id];
		if (so) return { options: so.options, correctAnswers: so.correctAnswers };
		return { options: q.options, correctAnswers: q.correctAnswers };
	}

	function accurate(id) {
		const { correctAnswers } = getQuestionOptions(id);
		const v = session.answers[id] || [];
		return v.length === correctAnswers.length && v.every((k) => correctAnswers.includes(k));
	}

	function remember(id, ok) {
		const x = saved.stats[id] || { attempts: 0, correct: 0, lastWrong: false };
		x.attempts++;
		if (ok) x.correct++;
		x.lastWrong = !ok;
		saved.stats[id] = x;
	}

	function getWeakCount() {
		return Object.values(saved.stats).filter((s) => s.lastWrong).length;
	}

	// --- Start session ---
	function start(mode, domain, amount) {
		let ids = [];
		if (mode === "exam") {
			for (const [d, n] of Object.entries(cfg.examBlueprint)) {
				const pool = qs.filter((q) => q.domain === d);
				ids.push(
					...shuffle(pool)
						.slice(0, n)
						.map((q) => q.id),
				);
			}
			ids = shuffle(ids);
		} else if (mode === "weak") {
			const weak = qs.filter((q) => saved.stats[q.id]?.lastWrong);
			if (!weak.length) return;
			ids = shuffle(weak).map((q) => q.id);
		} else {
			let pool = [...qs];
			if (domain && domain !== "all") {
				pool = pool.filter((q) => q.domain === domain);
			}
			const n = amount || pool.length;
			ids = shuffle(pool)
				.slice(0, n)
				.map((q) => q.id);
		}
		if (!ids.length) return;
		// Build shuffled options for every question in this session
		const shuffledOptions = {};
		for (const id of ids) {
			shuffledOptions[id] = shuffleQuestionOptions(byId[id]);
		}
		session = {
			mode,
			ids,
			currentIndex: 0,
			answers: {},
			checked: {},
			flags: [],
			created: Date.now(),
			deadline: mode === "exam" ? Date.now() + (cfg.examMinutes ?? 120) * 60 * 1000 : null,
			submitted: false,
			shuffledOptions,
		};
		persist();
		setResumeUrl(true);
		render("question");
		window.scrollTo({ top: 0, behavior: "smooth" });
	}

	function requestStart(mode, domain, amount) {
		if (session && !session.submitted) {
			const activeType = session.mode === "exam" ? "mock exam" : "practice session";
			return confirmAction(
				"Replace active session?",
				`Your saved ${activeType} will be replaced. If you cancel, your answers and timer remain unchanged.`,
				"Replace session",
				() => start(mode, domain, amount),
			);
		}
		start(mode, domain, amount);
	}

	function setResumeUrl(shouldResume) {
		const url = new URL(window.location.href);
		if (shouldResume && session) {
			url.searchParams.set("mode", session.mode === "exam" ? "assess" : "practice");
			url.searchParams.set("resume", "1");
		} else {
			url.searchParams.delete("resume");
		}
		history.replaceState(null, "", url);
		window.dispatchEvent(new Event("practice-lab:workspace-mode-change"));
	}

	// --- Home view ---
	function home() {
		const values = Object.values(saved.stats);
		const attempted = values.filter((s) => s.attempts > 0).length;
		const mastered = values.filter((s) => s.attempts > 0 && !s.lastWrong).length;
		const weak = getWeakCount();
		const assessSetup = new URLSearchParams(window.location.search).get("mode") === "assess";

		const readinessPct = pct(mastered, qs.length);
		const bpLabel = cfg.blueprintSource === "official" ? "Exam weight" : "Bank distribution";
		const cards = Object.entries(cfg.domains)
			.map(([d, domainConfig]) => {
				const list = qs.filter((q) => q.domain === d);
				const done = list.filter((q) => saved.stats[q.id]?.attempts);
				return `<div class="domainRow"><span><strong>${d}</strong> ${esc(domainConfig.name)}<br><span class="muted small">${bpLabel} ${domainConfig.weight}%</span></span><strong>${done.length}/${list.length}</strong></div>`;
			})
			.join("");
		const setupContent = assessSetup
			? `<div class="panel examSetup">
				<h3>Timed mock exam</h3>
				<p>${cfg.totalQuestions} questions mapped to the ${cfg.blueprintSource === "official" ? "official blueprint" : "available question-bank distribution"}.</p>
				<p class="small muted">${cfg.examMinutes ?? 120} minutes. The timer continues if you leave; return here to resume your saved exam.</p>
				<button class="primary" data-action="start-exam">Start mock exam</button>
			</div>`
			: `<div class="config configTop">
				<div>
					<label class="small" for="domain">Practice focus</label>
					<select class="select" id="domain">
						<option value="all" ${requestedDomain === "all" ? "selected" : ""}>All domains</option>
						<optgroup label="Exam domains">
							${Object.entries(cfg.domains)
								.map(
									([id, d]) =>
										`<option value="${id}" ${requestedDomain === id ? "selected" : ""}>${id} · ${esc(d.name)}</option>`,
								)
								.join("")}
						</optgroup>
					</select>
				</div>
				<div>
					<label class="small" for="amount">Questions</label>
					<select class="select" id="amount">
						<option value="10">10</option>
						<option value="20" selected>20</option>
						<option value="50">50</option>
						<option value="${qs.length}">All available</option>
					</select>
				</div>
			</div>
			<div class="modes">
				<button class="mode" data-action="start-practice">
					<strong>Practice mode</strong>
					<p>Instant feedback, explanations and links to primary documentation. Study by exam domain or focus on your weakest areas.</p>
				</button>
				<button class="mode" data-action="start-weak" ${weak ? "" : "disabled"}>
					<strong>Review mistakes</strong>
					<p>${weak ? `${weak} questions need another pass.` : "Complete a session to unlock targeted revision."} Retest only your latest missed questions.</p>
				</button>
				<a class="mode modeLink" href="${base}certifications/${cfg.slug}/?mode=assess#session">
					<strong>Set up a mock exam</strong>
					<p>Start a timed assessment when you are ready to test yourself.</p>
				</a>
			</div>`;
		const activeSessionNotice =
			session && !session.submitted
				? `<p class="sessionNotice" role="status">Your ${session.mode === "exam" ? "mock exam" : "practice session"} is saved. ${session.mode === "exam" ? "The timer continues while you are away." : "Your answers are ready to resume."}</p>`
				: "";

		setAppHTML(`
			<div class="hero">
				<span class="eyebrow">${esc(cfg.subtitle)} · ${esc(cfg.title)}</span>
				<h1>Know the platform.<br>Ship with confidence.</h1>
				<p class="lead">${qs.length} source-linked practice questions across the ${Object.keys(cfg.domains).length} domains${cfg.examGuideNote ? ` mapped to ${cfg.examGuideNote} for the <strong>${esc(cfg.title)}</strong> certification` : ` for the <strong>${esc(cfg.title)}</strong> certification`}. Learn by doing, then test your readiness.</p>
				<div class="readinessBar">
					<div class="readinessMeta"><span>Study readiness · ${mastered} of ${qs.length} mastered</span><strong class="mono">${readinessPct}%</strong></div>
					<progress class="progress" value="${mastered}" max="${qs.length}" aria-label="Certification readiness"></progress>
				</div>
				<div class="ctaRow">
					${
						session && !session.submitted
							? `<button class="primary" data-action="resume">Resume ${session.mode === "exam" ? "mock exam" : "practice"} · ${session.currentIndex + 1}/${session.ids.length}</button>`
							: `<a class="primary" href="#session">${assessSetup ? "Review mock exam setup" : "Choose practice settings"}</a>`
					}
					${studyHref ? `<a class="ghost ghostOnDark" href="${esc(studyHref)}" data-action="go-to-site-home">Open study notes</a>` : ""}
					<a class="ghost ghostOnDark" href="#coverage">See your progress</a>
				</div>
			</div>
			${activeSessionNotice}
			<section class="section" id="session">
				<div class="sectionHead"><h2>${assessSetup ? "Mock exam setup" : "Practice setup"}</h2><span class="muted small">${assessSetup ? "Your saved answers can be resumed" : "Save & resume automatically"}</span></div>
				${setupContent}
			</section>
			<section class="section" id="coverage">
				<div class="sectionHead"><h2>Learning telemetry</h2><button class="ghost small" data-action="reset-stats">Reset progress</button></div>
				<div class="statGrid">
					<div class="panel stat"><strong>${attempted}/${qs.length}</strong><span>Questions attempted</span></div>
					<div class="panel stat"><strong>${mastered}</strong><span>Last attempt correct</span></div>
					<div class="panel stat"><strong>${weak}</strong><span>Needs review</span></div>
					<div class="panel stat"><strong>${Object.keys(cfg.domains).length}</strong><span>Exam domains</span></div>
				</div>
				<h3 style="margin-top:25px">Coverage by domain</h3>
				<div class="domainGrid">${cards}</div>
			</section>
			<p class="alert section">Independent study material. Practice scores are not equivalent to official exam scores.</p>
 		<p class="small muted section">This bank includes practice questions from <strong>Cert Pro Quest</strong> by Matthew Purcell. These are community-created practice questions and are not official exam content.</p>
		`);
	}

	// --- Question view ---
	function question(focusTarget) {
		if (!session || session.submitted) return home();
		if (session.mode === "exam" && session.deadline && session.deadline <= Date.now())
			return finish(true);
		if (session.currentIndex >= session.ids.length)
			return session.mode === "exam" ? examReview() : finish(false);

		const id = session.ids[session.currentIndex];
		const x = byId[id];
		const v = session.answers[id] || [];
		const checked = !!session.checked[id];
		const isExam = session.mode === "exam";
		const isLast = session.currentIndex === session.ids.length - 1;
		const good = checked && accurate(id);
		const progress = session.ids.filter(answered).length;

		// Shared accessor: shuffled session data wins, otherwise original question.
		const { options: displayOptions, correctAnswers: displayCorrect } = getQuestionOptions(id);

		const opts = displayOptions
			.map((t, n) => {
				let status = "";
				if (checked)
					status =
						displayCorrect.includes(n) && v.includes(n)
							? " good"
							: displayCorrect.includes(n)
								? " missing"
								: v.includes(n)
									? " bad"
									: "";
				else if (v.includes(n)) status = " selected";
				return `<button class="option${status}" data-action="pick" data-value="${n}" data-focus-target="answer-${n}" aria-pressed="${v.includes(n)}" ${checked ? "disabled" : ""}>
				<span class="letter">${LETTERS[n]}</span><span>${esc(t)}</span>
			</button>`;
			})
			.join("");

		const src = x.source;
		const domainStudyLink = studyHref ? `${studyHref}#${x.domain}` : "";
		let fb = "";
		if (checked)
			fb = `<div class="feedback ${good ? "correct" : "wrong"}" data-focus-target="feedback" tabindex="-1" role="status">
			<strong>${good ? "Correct — well reasoned." : "Not quite — review the reasoning."}</strong>
			<p>${esc(x.explanation)}</p>
			${x.whyNot ? `<p class="small muted">Why not the others: ${esc(x.whyNot)}</p>` : ""}
			<div class="feedbackLinks">
				${src.url ? `<a href="${esc(src.url)}" target="_blank" rel="noopener noreferrer">Study source: ${esc(src.label)} ↗</a>` : `<span class="small muted">Study source: ${esc(src.label)}</span>`}
				${domainStudyLink ? `<a href="${esc(domainStudyLink)}" data-action="go-to-site-home">Read ${x.domain} study notes →</a>` : ""}
			</div>
		</div>`;

		const examBar = isExam
			? `<div class="examBar" role="region" aria-label="Exam status">
				<div class="examBarLeft">
					<span class="badge">EXAM</span>
					<strong class="mono">Q ${session.currentIndex + 1}/${session.ids.length}</strong>
					<span class="small muted">${progress} answered · ${session.flags.length} flagged</span>
				</div>
				<div class="examBarRight">
					<div id="clock" class="clock clockInline" aria-label="Time remaining">${clockText()}</div>
					<button class="ghost small" data-action="exit-exam">Exit exam</button>
					<button class="ghost small" data-action="finish">Submit exam</button>
				</div>
			</div>`
			: "";

		const main = `<h1 class="sr-only">${esc(cfg.title)} — ${isExam ? "Mock exam" : "Practice session"}</h1>
			${examBar}
			<div class="qhead"><span>Question ${session.currentIndex + 1} of ${session.ids.length} · ${esc(session.mode.toUpperCase())}</span><span class="qheadRight">${progress} answered · <span class="kbdHint">Keys 1–4 · Enter</span></span></div>
			<progress class="progress" value="${session.currentIndex + 1}" max="${session.ids.length}" aria-label="Question progress"></progress>
			<div class="panel question" style="margin-top:14px">
				<span class="badge">${x.domain} · ${esc(domains[x.domain].name)}</span>
				${x.topic ? `<span class="muted small" style="margin-left:8px">${esc(x.topic)}</span>` : ""}
				<h2 data-focus-target="question" tabindex="-1">${esc(x.question)}</h2>
		 <p class="hint">${getSelectCount(x, id) === 1 ? "Select ONE answer." : `Select exactly ${getSelectCount(x, id)} answers.`}${isExam ? " Your choices stay editable until you submit." : " Check your answer to see the explanation."}</p>
				${opts}${fb}
				<div class="actions">
					${session.currentIndex > 0 ? `<button class="ghost" data-action="prev">← Previous</button>` : ""}
					${
						isExam
							? `<button class="ghost" data-action="flag" data-focus-target="flag" aria-pressed="${session.flags.includes(id)}"><span aria-hidden="true">⚑</span> ${session.flags.includes(id) ? "Flagged" : "Flag for review"}</button>
						<button class="primary" data-action="next">${isLast ? "Go to review" : "Next →"}</button>`
							: checked
								? `<button class="primary" data-action="next">${isLast ? "Finish session" : "Next question →"}</button>`
								: `<button class="primary" data-action="check" ${v.length === getSelectCount(x, id) ? "" : "disabled"}>Check answer</button>`
					}
				</div>
			</div>`;

		const grid = session.ids
			.map((qid, k) => {
				const isCurrent = k === session.currentIndex;
				const isAnswered = answered(qid);
				const isFlagged = session.flags.includes(qid);
				const stateLabel = `${isAnswered ? "answered" : "unanswered"}, ${isFlagged ? "flagged for review" : "not flagged for review"}${isCurrent ? ", current question" : ""}`;
				const stateMarks = `${isAnswered ? "✓" : "—"}${isFlagged ? " ⚑" : ""}${isCurrent ? " ●" : ""}`;

				return `<button class="qchip${isCurrent ? " current" : ""}${isAnswered ? " answered" : ""}${isFlagged ? " flagged" : ""}" data-action="jump" data-value="${k}" aria-label="Question ${k + 1}, ${stateLabel}"${isCurrent ? ' aria-current="step"' : ""}><span class="qchipNumber">${k + 1}</span><span class="qchipMarks" aria-hidden="true">${stateMarks}</span></button>`;
			})
			.join("");

		const legend = `<ul class="qchipLegend">
			<li><span aria-hidden="true">✓</span> Answered</li>
			<li><span aria-hidden="true">—</span> Unanswered</li>
			<li><span aria-hidden="true">⚑</span> Flagged for review</li>
			<li><span aria-hidden="true">●</span> Current question</li>
		</ul>`;
		const navigatorContent = `<p class="small muted">Jump to any question.</p>
			${legend}
			<div class="small muted">${progress}/${session.ids.length} answered · ${session.flags.length} flagged</div>
			<div class="qgrid">${grid}</div>
			<button class="ghost" data-action="finish">Submit mock exam</button>`;
		const side = isExam
			? `<details class="panel side examNavigator" ${examNavigatorExpanded ? "open" : ""}>
				<summary><span>Question navigator</span><span class="small muted">${progress}/${session.ids.length} answered</span></summary>
				${navigatorContent}
			</details>`
			: `<aside class="panel side">
				<h3>Study session</h3>
				<p class="small muted">Immediate rationale and primary-source references after each answer.</p>
				${legend}
				<div class="small muted">${progress}/${session.ids.length} answered</div>
				<div class="qgrid">${grid}</div>
				<button class="ghost" data-action="home">Pause & go home</button>
			</aside>`;

		setAppHTML(`<div class="split"><div>${main}</div>${side}</div>`, focusTarget);
	}

	function clockText() {
		if (!session?.deadline) return "";
		const t = Math.max(0, Math.ceil((session.deadline - Date.now()) / 1000));
		return `${String(Math.floor(t / 3600)).padStart(2, "0")}:${String(Math.floor((t % 3600) / 60)).padStart(2, "0")}:${String(t % 60).padStart(2, "0")}`;
	}

	function tick() {
		if (!session || session.submitted || session.mode !== "exam") return;
		const e = document.getElementById("clock");
		if (e) {
			e.textContent = clockText();
			e.classList.toggle("warn", session.deadline - Date.now() < 600000);
		}
		if (session.deadline && session.deadline <= Date.now()) finish(true);
	}

	function finish(timed = false) {
		if (!session || session.submitted) return;
		session.submitted = true;
		session.timedOut = timed;
		session.finished = Date.now();
		for (const id of session.ids)
			if (answered(id) && !session.checked[id]) remember(id, accurate(id));
		persist();
		results();
		window.scrollTo({ top: 0, behavior: "smooth" });
	}

	// --- Results view ---
	function results() {
		if (!session) return home();
		const ids = session.ids;
		const correct = ids.filter((id) => answered(id) && accurate(id));
		const score = pct(correct.length, ids.length);

		// Show passing threshold reference when configured
		let passingBandHtml = "";
		if (cfg.passingScore) {
			passingBandHtml = `
				<div class="infoCallout">
					<strong>Reference passing threshold: ${cfg.passingScore} / 1,000</strong>
					<p class="small muted" style="margin:4px 0 0">The official exam uses a scaled scoring model. This practice score is a raw percentage and cannot predict the scaled result.</p>
				</div>`;
		}

		const rows = Object.entries(cfg.domains)
			.map(([d, domainConfig]) => {
				const list = ids.filter((id) => byId[id].domain === d);
				if (!list.length) return "";
				const ok = list.filter((id) => correct.includes(id)).length;
				const domainPct = pct(ok, list.length);
				const studyLink =
					studyHref && domainPct < 80
						? `<a class="small wsTextLink" href="${esc(studyHref)}#${d}" data-action="go-to-site-home">Study ${d} →</a>`
						: "";
				return `<div class="domainRow"><span><strong>${d}</strong> · ${esc(domainConfig.name)} ${studyLink}</span><strong>${ok}/${list.length} (${domainPct}%)</strong></div>`;
			})
			.join("");

		const missedCount = ids.filter((id) => !(answered(id) && accurate(id))).length;
		const flaggedCount = session.flags.length;
		const filteredIds = ids
			.map((id, k) => ({ id, k }))
			.filter(({ id }) => {
				if (reviewFilter === "missed") return !(answered(id) && accurate(id));
				if (reviewFilter === "flagged") return session.flags.includes(id);
				return true;
			});

		const rev = filteredIds.length
			? filteredIds
					.map(({ id, k }) => {
						const q = byId[id];
						const v = session.answers[id] || [];
						const ok = accurate(id) && answered(id);
						const { options: revOptions, correctAnswers: revCorrect } = getQuestionOptions(id);
						return `<details class="panel review"><summary><span class="badge">${q.domain}</span> ${k + 1}. ${ok ? "✓" : "✕"} ${esc(q.question)}</summary>
				<div class="small muted" style="margin:9px 16px">Your selection: ${v.length ? v.map((n) => LETTERS[n]).join(", ") : "Unanswered"} · Correct: ${revCorrect.map((n) => LETTERS[n]).join(", ")}</div>
				${revOptions.map((t, n) => `<div class="option${revCorrect.includes(n) ? " good" : v.includes(n) ? " bad" : ""}"><span class="letter">${LETTERS[n]}</span><span>${esc(t)}</span></div>`).join("")}
				<p>${esc(q.explanation)}</p>
				${q.whyNot ? `<p class="small muted">Why not the others: ${esc(q.whyNot)}</p>` : ""}
				${q.source.url ? `<a href="${esc(q.source.url)}" target="_blank" rel="noopener noreferrer">${esc(q.source.label)} ↗</a>` : `<span class="small muted" style="display:inline-block;margin:0 16px 14px">${esc(q.source.label)}</span>`}
			</details>`;
					})
					.join("")
			: `<p class="panel muted">No questions match this filter.</p>`;

		setAppHTML(`
			<div class="results">
				<div class="panel padded">
					<h1>${session.mode === "exam" ? "Mock exam results" : "Practice session results"}${session.timedOut ? " · time expired" : ""}</h1>
					<div class="score" style="margin:12px 0">
						<div class="ring" style="--score:${score}%">
							<span>${score}%</span>
						</div>
						<div>
							<h2 class="scoreHeading">${correct.length} / ${ids.length} correct</h2>
							<p class="muted" style="margin:0">Unofficial practice score · not equivalent to the scaled passing score.</p>
						</div>
					</div>
					${passingBandHtml}
					<div class="actions">
						<button class="primary" data-action="home">Back to dashboard</button>
						<button class="ghost" data-action="start-weak" ${getWeakCount() ? "" : "disabled"}>Retake missed questions</button>
						<button class="ghost" data-action="start-exam">New mock exam</button>
					</div>
				</div>
				<section class="section">
					<h2>Performance by domain</h2>
					<div class="domainGrid">${rows}</div>
				</section>
				<section class="section">
					<div class="sectionHead">
						<div>
							<h2>Review every answer</h2>
							<p class="muted small" style="margin:4px 0 0">Open an item to see the correct option, rationale and primary documentation.</p>
						</div>
						<div class="filterBar" role="group" aria-label="Filter reviewed answers">
							<button type="button" class="filterBtn" data-action="filter-review" data-value="all" aria-pressed="${reviewFilter === "all"}">All (${ids.length})</button>
							<button type="button" class="filterBtn" data-action="filter-review" data-value="missed" aria-pressed="${reviewFilter === "missed"}">Missed (${missedCount})</button>
							<button type="button" class="filterBtn" data-action="filter-review" data-value="flagged" aria-pressed="${reviewFilter === "flagged"}">Flagged (${flaggedCount})</button>
						</div>
					</div>
					${rev}
				</section>
			</div>`);
	}

	// --- Exam review ---
	function examReview() {
		const un = session.ids.filter((id) => !answered(id)).length;
		setAppHTML(`<div class="panel padded results">
			<h1>Review your answer sheet.</h1>
			<p class="lead">${session.ids.length - un} answered · ${un} unanswered · ${session.flags.length} flagged. Time remaining: ${clockText()}.</p>
			<div class="actions">
				<button class="ghost" data-action="back-to-exam">Review questions</button>
				<button class="primary" data-action="finish">Submit and score</button>
			</div>
		</div>`);
	}

	// --- Render ---
	function render(focusTarget) {
		if (
			session &&
			!session.submitted &&
			new URLSearchParams(window.location.search).get("resume") === "1"
		)
			question(focusTarget);
		else if (session && !session.submitted) home();
		else if (session?.submitted) results();
		else home();
		tick();
	}

	// --- Event handlers ---
	document.addEventListener("click", (event) => {
		const el = event.target.closest("[data-action]");
		if (!el) return;
		const action = el.dataset.action;

		// Allow site-home link and unified Layout theme toggle to handle their own events
		if (action === "go-to-site-home" || action === "theme") return;
		event.preventDefault();

		if (action === "home") {
			if (session?.submitted) session = null;
			setResumeUrl(false);
			persist();
			return home();
		}
		if (action === "resume") {
			setResumeUrl(true);
			return render();
		}
		if (action === "exit-exam") {
			return confirmAction(
				"Exit mock exam?",
				"Your answers will be saved, but the timer continues while you are away. Resume the exam from this certification page.",
				"Exit exam",
				() => {
					setResumeUrl(false);
					home();
					window.scrollTo({ top: 0, behavior: "smooth" });
				},
			);
		}
		if (action === "reset-stats") {
			confirmAction(
				"Reset saved practice history?",
				"This clears your attempted, mastered, and weak-question statistics for this certification on this device.",
				"Reset history",
				() => {
					saved.stats = {};
					persist();
					home();
				},
			);
			return;
		}
		if (action === "filter-review") {
			reviewFilter = el.dataset.value || "all";
			results();
			const activeBtn = app.querySelector(
				`[data-action="filter-review"][data-value="${reviewFilter}"]`,
			);
			if (activeBtn instanceof HTMLElement) activeBtn.focus();
			return;
		}
		if (action === "start-practice") {
			const d = document.getElementById("domain")?.value || "all";
			const n = +document.getElementById("amount")?.value || 20;
			return requestStart("practice", d, n);
		}
		if (action === "start-exam") return requestStart("exam");
		if (action === "start-weak") return requestStart("weak");
		if (!session || session.submitted) return;

		const id = session.ids[session.currentIndex];
		const q = byId[id];
		if (action === "pick") {
			if (session.checked[id]) return;
			const n = +el.dataset.value;
			const vals = session.answers[id] || [];
			const pickCount = getSelectCount(q);
			session.answers[id] =
				pickCount === 1
					? [n]
					: vals.includes(n)
						? vals.filter((x) => x !== n)
						: vals.length >= pickCount
							? vals
							: [...vals, n];
			persist();
			return question(`answer-${n}`);
		}
		if (action === "check") {
			if ((session.answers[id] || []).length !== getSelectCount(q)) return;
			session.checked[id] = true;
			remember(id, accurate(id));
			persist();
			return question("feedback");
		}
		if (action === "prev") {
			session.currentIndex = Math.max(0, session.currentIndex - 1);
			persist();
			return question("question");
		}
		if (action === "next") {
			session.currentIndex++;
			persist();
			if (session.currentIndex >= session.ids.length) {
				if (session.mode === "exam") return examReview();
				return finish();
			}
			return question("question");
		}
		if (action === "jump") {
			// The guard applies to the destination question, not the one on screen.
			const targetId = session.ids[+el.dataset.value];
			if (session.mode !== "exam" && !session.checked[targetId]) return;
			session.currentIndex = +el.dataset.value;
			persist();
			return question("question");
		}
		if (action === "flag") {
			session.flags = session.flags.includes(id)
				? session.flags.filter((x) => x !== id)
				: [...session.flags, id];
			persist();
			return question("flag");
		}
		if (action === "finish") {
			confirmAction(
				"Submit mock exam?",
				"Your answers will be scored and rationales will be revealed immediately.",
				"Submit and score",
				() => finish(false),
			);
		}
	});

	// Back to exam handler
	document.addEventListener("click", (e) => {
		if (e.target.closest('[data-action="back-to-exam"]')) {
			e.preventDefault();
			session.currentIndex = 0;
			persist();
			question();
		}
	});

	// Keyboard shortcuts
	document.addEventListener("keydown", (e) => {
		if (
			!session ||
			session.submitted ||
			e.altKey ||
			e.metaKey ||
			e.ctrlKey ||
			document.querySelector("dialog[open]") ||
			/INPUT|SELECT|TEXTAREA/.test(document.activeElement?.tagName || "")
		)
			return;
		const optionIndex = optionKeys.indexOf(e.key);
		if (optionIndex !== -1) {
			const b = app.querySelector(`[data-action="pick"][data-value="${optionIndex}"]`);
			if (b && !b.disabled) b.click();
		} else if (
			e.key === "Enter" &&
			(document.activeElement === document.body ||
				document.activeElement?.matches('[data-action="pick"]'))
		) {
			const b = app.querySelector('[data-action="check"]:not(:disabled),[data-action="next"]');
			if (b) {
				e.preventDefault();
				b.click();
			}
		}
	});

	setInterval(tick, 1000);
	render();
})();
</script>
