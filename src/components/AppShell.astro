---
import { getCertificationList } from "../certifications/index";
import { base } from "../lib/base";
import { studyCerts } from "../study/registry";
import FeedbackDialog from "./FeedbackDialog.astro";

export interface SidebarDomain {
	id: string;
	name: string;
	weight?: number;
	href: string;
}

interface Props {
	activeNav: "overview" | "study" | "practice" | "assess" | "data" | "progress";
	activeCertSlug?: string;
	activeCertCode?: string;
	breadcrumb?: string;
	domains?: SidebarDomain[];
	footerText?: string;
	wide?: boolean;
}

const {
	activeNav,
	activeCertSlug = "ccdv-f",
	activeCertCode,
	breadcrumb = "Overview",
	domains = [],
	footerText = "Independent study material · Progress stays in your browser",
	wide = false,
} = Astro.props;

const certs = await getCertificationList();
const studySlugs = new Set(studyCerts.map((c) => c.slug));
const hasStudyForCert = studySlugs.has(activeCertSlug);
const learnHref = hasStudyForCert ? `${base}study/${activeCertSlug}/` : `${base}study/`;
const practiceHref = `${base}certifications/${activeCertSlug}/?mode=practice#session`;
const assessHref = `${base}certifications/${activeCertSlug}/?mode=assess#session`;
const resourcesHref = `${base}study/ccdv-f/learning-resources/`;
---

<div class="pl-shell" data-exam-focus="false">
	<aside class="pl-sidebar" aria-label="Workspace navigation">
		<a class="pl-sidebar-brand" href={base} data-action="go-to-site-home">
			<img class="pl-mark" src={`${base}brand/practice-lab-mark.png`} alt="" width="32" height="32">
			<span class="pl-brand-title">PRACTICE LAB</span>
		</a>

		<nav class="pl-nav-section" aria-label="Workspace">
			<span class="pl-nav-label">Workspace</span>
			<a
				class="pl-nav-link"
				href={base}
				aria-current={activeNav === "overview" ? "page" : undefined}
				data-action="go-to-site-home"
			>
				<span>Overview</span>
			</a>
			<a
				class="pl-nav-link"
				href={`${base}progress/`}
				aria-current={activeNav === "progress" ? "page" : undefined}
				data-action="go-to-site-home"
			>
				<span>My Progress</span>
			</a>
			<a
				class="pl-nav-link"
				href={learnHref}
				aria-current={activeNav === "study" ? "page" : undefined}
				data-action="go-to-site-home"
			>
				<span>Learn · Study library</span>
			</a>
			<a
				class="pl-nav-link"
				href={practiceHref}
				data-workspace-mode="practice"
				aria-current={activeNav === "practice" ? "page" : undefined}
				data-action="go-to-site-home"
			>
				<span>Practice · Questions</span>
			</a>
			<a
				class="pl-nav-link"
				href={assessHref}
				data-workspace-mode="assess"
				aria-current={activeNav === "assess" ? "page" : undefined}
				data-action="go-to-site-home"
			>
				<span>Assess · Mock exam</span>
			</a>
			<a
				class="pl-nav-link"
				href={`${base}data-management/`}
				aria-current={activeNav === "data" ? "page" : undefined}
				data-action="go-to-site-home"
			>
				<span>Data management</span>
			</a>
		</nav>

		{domains.length > 0 && (
			<nav class="pl-nav-section" aria-label="Knowledge domains">
				<span class="pl-nav-label">Knowledge</span>
				{domains.map((d) => (
					<a class="pl-nav-link" href={d.href} data-action="go-to-site-home">
						<span class="pl-nav-truncate">
							{d.id} · {d.name}
						</span>
						{d.weight !== undefined && <span class="pl-nav-badge">{Math.round(d.weight)}%</span>}
					</a>
				))}
			</nav>
		)}

		<nav class="pl-nav-section" aria-label="Certifications">
			<span class="pl-nav-label">Certifications</span>
			{certs.map((c) => (
				<a
					class="pl-nav-link"
					href={`${base}certifications/${c.slug}/`}
					aria-current={activeCertCode === c.subtitle ? "page" : undefined}
					data-action="go-to-site-home"
				>
					<span class="pl-nav-truncate">{c.subtitle}</span>
					<span class="pl-nav-badge">{Object.keys(c.domains).length}d</span>
				</a>
			))}
		</nav>
	</aside>

	<div class="pl-workspace">
		<header class="pl-topbar">
			<div class="pl-topbar-left">
				<button
					type="button"
					class="pl-menu-btn"
					data-pl-open-drawer
					aria-label="Open workspace navigation"
				>
					<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
						<path
							d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
						/>
					</svg>
				</button>
				<div class="pl-topbar-crumb">
					{activeCertCode ? (
						<>
							<span>{activeCertCode}</span>
							<span aria-hidden="true"> / </span>
						</>
					) : null}
					<strong data-pl-workspace-breadcrumb>{breadcrumb}</strong>
				</div>
			</div>

			<div class="pl-topbar-right">
				<button
					type="button"
					class="pl-search-trigger"
					data-pl-open-search
					aria-haspopup="dialog"
					aria-controls="pl-search-dialog"
				>
					<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<circle cx="7" cy="7" r="4.8" stroke="currentColor" stroke-width="1.5" />
						<path
							d="M10.7 10.7L14 14"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
						/>
					</svg>
					<span class="pl-search-label">Search</span>
					<kbd class="pl-kbd" aria-hidden="true">⌘K</kbd>
				</button>
				<a class="pl-topbar-link" href={`${base}#certifications`} data-action="go-to-site-home">
					Certifications
				</a>
				<a class="pl-topbar-link" href={resourcesHref} data-action="go-to-site-home"> Resources </a>
				<button
					type="button"
					class="ghost"
					data-action="theme"
					aria-label="Theme: toggle light and dark appearance"
				>
					Theme
				</button>
			</div>
		</header>

		<main id="main-content" tabindex="-1" class:list={["pl-content", wide && "pl-content-wide"]}>
			<slot />
		</main>

		<footer class="pl-footer">
			<span>{footerText}</span>
			<span class="pl-footer-sep" aria-hidden="true">·</span>
			<button
				type="button"
				class="pl-feedback-link"
				data-pl-open-feedback
				data-feedback-type="application"
				data-feedback-cert={activeCertSlug}
				aria-haspopup="dialog"
				aria-controls="pl-feedback-dialog"
			>
				Send feedback
			</button>
		</footer>
	</div>
</div>

<nav class="pl-bottom-nav" aria-label="Primary mobile navigation">
	<a
		href={base}
		aria-current={activeNav === "overview" ? "page" : undefined}
		data-action="go-to-site-home"
	>
		Home
	</a>
	<a
		href={`${base}progress/`}
		aria-current={activeNav === "progress" ? "page" : undefined}
		data-action="go-to-site-home"
	>
		Progress
	</a>
	<a
		href={learnHref}
		aria-current={activeNav === "study" ? "page" : undefined}
		data-action="go-to-site-home"
	>
		Learn
	</a>
	<a
		href={practiceHref}
		data-workspace-mode="practice"
		aria-current={activeNav === "practice" ? "page" : undefined}
		data-action="go-to-site-home"
	>
		Practice
	</a>
	<a
		href={assessHref}
		data-workspace-mode="assess"
		aria-current={activeNav === "assess" ? "page" : undefined}
		data-action="go-to-site-home"
	>
		Assess
	</a>
</nav>

<!-- Mobile Navigation Drawer (native <dialog closedby="any">) -->
<dialog id="pl-mobile-drawer" class="pl-drawer" closedby="any" aria-labelledby="pl-drawer-title">
	<div class="pl-drawer-head">
		<h2 id="pl-drawer-title" class="pl-drawer-brand">
			<img class="pl-mark" src={`${base}brand/practice-lab-mark.png`} alt="" width="32" height="32">
			<span class="pl-brand-title">PRACTICE LAB</span>
		</h2>
		<form method="dialog">
			<button type="submit" class="ghost" style="min-height: 32px; padding: 4px 10px;">
				Close
			</button>
		</form>
	</div>
	<nav class="pl-nav-section" aria-label="Mobile workspace">
		<span class="pl-nav-label">Workspace</span>
		<a class="pl-nav-link" href={base} data-action="go-to-site-home">Overview</a>
		<a
			class="pl-nav-link"
			href={`${base}progress/`}
			aria-current={activeNav === "progress" ? "page" : undefined}
			data-action="go-to-site-home"
			>My Progress</a
		>
		<a class="pl-nav-link" href={learnHref} data-action="go-to-site-home">Learn · Study library</a>
		<a
			class="pl-nav-link"
			href={practiceHref}
			data-workspace-mode="practice"
			aria-current={activeNav === "practice" ? "page" : undefined}
			data-action="go-to-site-home"
			>Practice · Questions</a
		>
		<a
			class="pl-nav-link"
			href={assessHref}
			data-workspace-mode="assess"
			aria-current={activeNav === "assess" ? "page" : undefined}
			data-action="go-to-site-home"
			>Assess · Mock exam</a
		>
		<a
			class="pl-nav-link"
			href={`${base}data-management/`}
			aria-current={activeNav === "data" ? "page" : undefined}
			data-action="go-to-site-home"
			>Data management</a
		>
		<a class="pl-nav-link" href={resourcesHref} data-action="go-to-site-home">Learning resources</a>
	</nav>
	<nav class="pl-nav-section" aria-label="Mobile certifications">
		<span class="pl-nav-label">Certifications</span>
		{certs.map((c) => (
			<a
				class="pl-nav-link"
				href={`${base}certifications/${c.slug}/`}
				data-action="go-to-site-home"
			>
				<span class="pl-nav-truncate">
					{c.subtitle} · {c.title}
				</span>
			</a>
		))}
	</nav>
</dialog>

<!-- Command Palette / Search Modal (native <dialog closedby="any">) -->
<dialog id="pl-search-dialog" class="pl-dialog" closedby="any" aria-labelledby="pl-search-title">
	<h2 id="pl-search-title" class="sr-only">Search Practice Lab</h2>
	<div class="pl-dialog-head">
		<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<circle cx="7" cy="7" r="4.8" stroke="currentColor" stroke-width="1.5" />
			<path d="M10.7 10.7L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
		</svg>
		<search class="pl-search-field">
			<label class="sr-only" for="pl-search-input"
				>Search certifications, domains, and study notes</label
			>
			<input
				id="pl-search-input"
				class="pl-dialog-input"
				type="search"
				placeholder="Search certifications, domains, study notes…"
				aria-controls="pl-search-results"
				autocapitalize="none"
				spellcheck={false}
				enterkeyhint="search"
				autofocus
			>
		</search>
		<form method="dialog">
			<button
				type="submit"
				class="ghost"
				style="min-height: 30px; padding: 2px 10px; font-size: 12px;"
			>
				Esc
			</button>
		</form>
	</div>
	<section id="pl-search-results" class="pl-dialog-body" aria-label="Search results"></section>
	<p id="pl-search-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
</dialog>

<FeedbackDialog />

<script>
import { base } from "../lib/base";
import { rankSearchItems, type SearchItem } from "../lib/study-search";

(function () {
	const searchDialog = document.getElementById("pl-search-dialog") as HTMLDialogElement | null;
	const searchInput = document.getElementById("pl-search-input") as HTMLInputElement | null;
	const searchResults = document.getElementById("pl-search-results");
	const searchStatus = document.getElementById("pl-search-status");
	const drawer = document.getElementById("pl-mobile-drawer") as HTMLDialogElement | null;
	let searchItems: SearchItem[] = [];
	let searchIndexPromise: Promise<SearchItem[]> | undefined;
	let searchStatusTimeout: number | undefined;
	let searchOpener: HTMLElement | null = null;

	function announceSearchStatus(message: string) {
		window.clearTimeout(searchStatusTimeout);
		searchStatusTimeout = window.setTimeout(() => {
			if (searchDialog?.open && searchStatus) searchStatus.textContent = message;
		}, 180);
	}

	function updateWorkspaceMode() {
		if (!window.location.pathname.includes(`${base}certifications/`)) return;
		const mode =
			new URLSearchParams(window.location.search).get("mode") === "assess" ? "assess" : "practice";
		const breadcrumb = document.querySelector("[data-pl-workspace-breadcrumb]");
		if (breadcrumb)
			breadcrumb.textContent = mode === "assess" ? "Assess · Mock exam" : "Practice · Questions";
		for (const link of document.querySelectorAll("[data-workspace-mode]")) {
			if (link.getAttribute("data-workspace-mode") === mode) {
				link.setAttribute("aria-current", "page");
			} else {
				link.removeAttribute("aria-current");
			}
		}
	}

	function isExamFocusActive() {
		return document.querySelector('.pl-shell[data-exam-focus="true"]') !== null;
	}

	function loadSearchIndex() {
		if (searchItems.length) return Promise.resolve(searchItems);
		if (!searchIndexPromise) {
			searchIndexPromise = fetch(`${base}search-index.json`)
				.then((response) => {
					if (!response.ok) throw new Error("Search index request failed");
					return response.json() as Promise<SearchItem[]>;
				})
				.then((items) => {
					searchItems = items;
					return items;
				})
				.catch((error) => {
					searchIndexPromise = undefined;
					throw error;
				});
		}
		return searchIndexPromise;
	}

	function renderResults(query: string) {
		if (!searchResults) return;
		const q = query.trim();
		const filtered = q
			? rankSearchItems(q, searchItems)
			: searchItems
					.slice(0, 12)
					.map((item) => ({ ...item, excerpt: item.text?.slice(0, 160) ?? "", score: 0 }));

		searchResults.replaceChildren();
		if (!filtered.length) {
			const empty = document.createElement("div");
			empty.className = "pl-search-empty";
			empty.textContent = q
				? `No results for “${q}”.`
				: "No certifications or study notes are available.";
			searchResults.append(empty);
			announceSearchStatus(q ? `No results for “${q}”.` : "No search results available.");
			return;
		}
		const list = document.createElement("ul");
		list.className = "pl-search-list";
		for (const item of filtered.slice(0, 20)) {
			const row = document.createElement("li");
			const link = document.createElement("a");
			link.className = "pl-search-result";
			link.setAttribute("href", item.href);
			const titleSpan = document.createElement("span");
			titleSpan.className = "pl-search-title";
			titleSpan.textContent = item.title;
			const metaSpan = document.createElement("span");
			metaSpan.className = "pl-search-meta";
			metaSpan.textContent = item.badge || item.category;
			link.append(titleSpan, metaSpan);
			if (item.excerpt) {
				const excerpt = document.createElement("span");
				excerpt.className = "pl-search-excerpt";
				excerpt.textContent = item.excerpt;
				link.append(excerpt);
			}
			row.append(link);
			list.append(row);
		}
		searchResults.append(list);
		announceSearchStatus(`${filtered.length} search result${filtered.length === 1 ? "" : "s"}.`);
	}

	function openSearch(
		opener: HTMLElement | null = document.activeElement instanceof HTMLElement
			? document.activeElement
			: null,
	) {
		if (isExamFocusActive()) return;
		if (!searchDialog || typeof searchDialog.showModal !== "function") return;
		if (!searchDialog.open) {
			searchOpener = opener;
			searchDialog.showModal();
			if (searchInput) {
				searchInput.value = "";
				searchInput.focus();
			}
			loadSearchIndex()
				.then(() => renderResults(searchInput?.value ?? ""))
				.catch(() => {
					if (searchResults) {
						const message = document.createElement("p");
						message.className = "pl-search-empty";
						message.textContent = "Search is unavailable right now. Try again later.";
						searchResults.replaceChildren(message);
					}
					announceSearchStatus("Search is unavailable right now.");
				});
		}
	}

	function moveSearchFocus(direction: number) {
		const links = [
			...(searchResults?.querySelectorAll<HTMLAnchorElement>("a.pl-search-result") ?? []),
		];
		const currentIndex = links.indexOf(document.activeElement as HTMLAnchorElement);
		const nextIndex = currentIndex + direction;
		if (nextIndex < 0) {
			if (direction < 0) searchInput?.focus();
			return;
		}
		if (nextIndex < links.length) links[nextIndex].focus();
	}

	document.addEventListener("click", (event) => {
		const target = event.target instanceof Element ? event.target : null;
		if (!target) return;
		const searchTrigger = target.closest<HTMLElement>("[data-pl-open-search]");
		if (searchTrigger) {
			event.preventDefault();
			openSearch(searchTrigger);
		} else if (target.closest("[data-pl-open-drawer]")) {
			event.preventDefault();
			if (drawer && typeof drawer.showModal === "function" && !drawer.open) {
				drawer.showModal();
			}
		}
	});

	drawer?.addEventListener("click", (event) => {
		if (
			event.defaultPrevented ||
			event.button !== 0 ||
			event.metaKey ||
			event.ctrlKey ||
			event.shiftKey ||
			event.altKey
		) {
			return;
		}
		const target = event.target instanceof Element ? event.target : null;
		const link = target?.closest('a[data-action="go-to-site-home"][href]');
		if (link && drawer.open) {
			drawer.close();
		}
	});

	searchInput?.addEventListener("input", () => renderResults(searchInput.value));
	searchDialog?.addEventListener("close", () => {
		window.clearTimeout(searchStatusTimeout);
		searchStatusTimeout = undefined;
		const opener = searchOpener;
		searchOpener = null;
		if (opener?.isConnected) opener.focus();
	});
	searchDialog?.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && searchInput?.value) {
			event.preventDefault();
			searchInput.value = "";
			renderResults("");
			searchInput.focus();
			return;
		}
		if (event.key === "ArrowDown" && event.target === searchInput) {
			event.preventDefault();
			moveSearchFocus(1);
		} else if (
			event.key === "ArrowDown" &&
			(event.target as Element).closest("a.pl-search-result")
		) {
			event.preventDefault();
			moveSearchFocus(1);
		} else if (event.key === "ArrowUp" && (event.target as Element).closest("a.pl-search-result")) {
			event.preventDefault();
			moveSearchFocus(-1);
		}
	});

	// Cmd/Ctrl+K shortcut
	document.addEventListener("keydown", (e) => {
		if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
			e.preventDefault();
			if (isExamFocusActive()) return;
			openSearch();
		}
	});

	updateWorkspaceMode();
	window.addEventListener("popstate", updateWorkspaceMode);
	window.addEventListener("practice-lab:workspace-mode-change", updateWorkspaceMode);

	// Fallback light-dismiss for browsers without native <dialog closedby="any"> (Safari)
	if (!("closedBy" in HTMLDialogElement.prototype)) {
		const outside = (e: PointerEvent, dialog: HTMLDialogElement) => {
			const r = dialog.getBoundingClientRect();
			return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
		};
		for (const dialog of [searchDialog, drawer]) {
			if (!dialog) continue;
			let pressedOutside = false;
			dialog.addEventListener("pointerdown", (e) => {
				pressedOutside = outside(e, dialog);
			});
			dialog.addEventListener("pointerup", (e) => {
				if (pressedOutside && outside(e, dialog)) dialog.close();
			});
		}
	}
})();
</script>
