---
// QuizApp — interactive quiz island component
// Receives certification data and renders the full quiz UI

import type { CertificationConfig, Question } from "../lib/quiz-types";

interface Props {
	config: CertificationConfig;
	questions: Question[];
}

const { config, questions } = Astro.props;
---

<script>
window.__quizData = {
	config: {config},
	questions: {questions}
};
</script>

<script is:inline>
(function() {
	// Parse data from window
	const quizData = window.__quizData;
	if (!quizData) return;
	const config = quizData.config;
	const questions = quizData.questions;

	// Build lookup maps
	const byId = {};
	for (const q of questions) { byId[q.id] = q; }
	const domains = {};
	for (const [key, d] of Object.entries(config.domains)) {
		domains[key] = { name: d.name, weight: d.weight };
	}

	const KEY = config.slug + "-practice-lab-v2";
	const LETTERS = "ABCD";
	const app = document.getElementById("app");

	// --- Storage ---
	function getSaved() {
		try {
			const x = JSON.parse(localStorage.getItem(KEY));
			return x && typeof x === "object" ? x : { stats: {}, session: null };
		} catch { return { stats: {}, session: null }; }
	}
	let saved = getSaved();
	if (!saved.stats) saved.stats = {};
	let session = saved.session || null;

	function persist() {
		saved.session = session;
		try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch {}
	}

	// --- Engine functions ---
	function shuffle(arr) {
		const a = [...arr];
		for (let i = a.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[a[i], a[j]] = [a[j], a[i]];
		}
		return a;
	}

	function pct(n, t) { return t ? Math.round(n / t * 100) : 0; }

	function esc(s) {
		return String(s).replace(/[&<>"']/g, c => ({
			"&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;"
		}[c]));
	}

	function answered(id) {
		return Array.isArray(session?.answers?.[id]) && session.answers[id].length > 0;
	}

	function accurate(id) {
		const q = byId[id], v = session.answers[id] || [];
		return v.length === q.correctAnswers.length && v.every(k => q.correctAnswers.includes(k));
	}

	function remember(id, ok) {
		const x = saved.stats[id] || { attempts: 0, correct: 0, lastWrong: false };
		x.attempts++;
		if (ok) x.correct++;
		x.lastWrong = !ok;
		saved.stats[id] = x;
	}

	function getWeakCount() {
		return Object.values(saved.stats).filter(s => s.lastWrong).length;
	}

	// --- Start session ---
	function start(mode, domain, amount) {
		let ids = [];
		if (mode === "exam") {
			for (const [d, n] of Object.entries(config.examBlueprint)) {
				const pool = questions.filter(q => q.domain === d);
				ids.push(...shuffle(pool).slice(0, n).map(q => q.id));
			}
			ids = shuffle(ids);
		} else if (mode === "weak") {
			const weak = questions.filter(q => saved.stats[q.id]?.lastWrong);
			if (!weak.length) return;
			ids = shuffle(weak).map(q => q.id);
		} else {
			let pool = [...questions];
			if (domain && domain !== "all") {
				pool = pool.filter(q => q.domain === domain);
			}
			const n = amount || pool.length;
			ids = shuffle(pool).slice(0, n).map(q => q.id);
		}
		if (!ids.length) return;
		session = {
			mode, ids, currentIndex: 0, answers: {}, checked: {}, flags: [],
			created: Date.now(),
			deadline: mode === "exam" ? Date.now() + 120 * 60 * 1000 : null,
			submitted: false
		};
		persist();
		render();
		window.scrollTo({ top: 0, behavior: "smooth" });
	}

	// --- Home view ---
	function home() {
		const values = Object.values(saved.stats);
		const attempted = values.filter(s => s.attempts > 0).length;
		const mastered = values.filter(s => s.attempts > 0 && !s.lastWrong).length;
		const weak = getWeakCount();

		const cards = Object.entries(config.domains).map(([d, info]) => {
			const list = questions.filter(q => q.domain === d);
			const done = list.filter(q => saved.stats[q.id]?.attempts).length;
			return `<div class="panel domainRow"><span><strong>${d}</strong> ${esc(info.name)}<br><span class="muted">Exam weight ${info.weight}%</span></span><strong>${done}/${list.length}</strong></div>`;
		}).join("");

		const resumeBtn = session && !session.submitted
			? `<button class="primary" data-action="resume" style="margin-top:28px">Resume ${session.mode === "exam" ? "Mock Exam" : "Practice"} · ${session.currentIndex + 1}/${session.ids.length}</button>`
			: "";

		app.innerHTML = `
			<div class="hero">
				<h1>Know the platform.<br>Ship with confidence.</h1>
				<p class="lead">${questions.length} practice questions across ${Object.keys(config.domains).length} domains. Learn by doing, then test your readiness with a timed mock exam.</p>
				<div class="pills">
					<span class="pill">${questions.length} questions</span>
					<span class="pill">${config.totalQuestions}-question mock exam</span>
					<span class="pill">120-minute timer</span>
					<span class="pill">Offline & private</span>
				</div>
				${resumeBtn}
			</div>
			<section class="section">
				<div class="sectionHead"><h2>Study mode</h2><span class="muted small">Progress saves automatically</span></div>
				<div class="modes">
					<button class="mode" data-action="start-practice">
						<strong>Practice</strong>
						<p>Instant feedback with explanations and links to official documentation. Study by exam domain at your own pace.</p>
					</button>
					<button class="mode" data-action="start-exam">
						<strong>Mock Exam</strong>
						<p>${config.totalQuestions} questions proportioned to the official blueprint. 120 minutes. Answers revealed after submission.</p>
					</button>
					<button class="mode" data-action="start-weak" ${weak ? "" : "disabled"}>
						<strong>Review Mistakes</strong>
						<p>${weak ? weak + " questions need another pass." : "Complete a session to unlock targeted revision."} Retest only your latest missed questions.</p>
					</button>
				</div>
				<div class="config">
					<div>
						<label class="small" for="domain">Practice focus</label>
						<select class="select" id="domain">
							<option value="all">All domains</option>
							${Object.entries(config.domains).map(([id, info]) => `<option value="${id}">${id} · ${esc(info.name)}</option>`).join("")}
						</select>
					</div>
					<div>
						<label class="small" for="amount">Questions</label>
						<select class="select" id="amount">
							<option value="10">10</option>
							<option value="20" selected>20</option>
							<option value="50">50</option>
							<option value="${questions.length}">All available</option>
						</select>
					</div>
				</div>
			</section>
			<section class="section">
				<div class="sectionHead"><h2>Progress</h2><button class="ghost small" data-action="reset-stats">Reset</button></div>
				<div class="statGrid">
					<div class="panel stat"><strong>${attempted}/${questions.length}</strong><span>Attempted</span></div>
					<div class="panel stat"><strong>${mastered}</strong><span>Last correct</span></div>
					<div class="panel stat"><strong>${weak}</strong><span>Needs review</span></div>
					<div class="panel stat"><strong>${Object.keys(config.domains).length}</strong><span>Domains</span></div>
				</div>
				<h3>Coverage by domain</h3>
				<div class="domainGrid">${cards}</div>
			</section>
			<p class="alert section">Independent study material. Practice scores are not equivalent to official scaled exam scores.</p>
		`;
	}

	// --- Question view ---
	function question() {
		if (!session || session.submitted) return home();
		if (session.mode === "exam" && session.deadline && Date.now() >= session.deadline) return finish(true);
		if (session.currentIndex >= session.ids.length) {
			return session.mode === "exam" ? examReview() : finish(false);
		}

		const id = session.ids[session.currentIndex];
		const x = byId[id];
		const v = session.answers[id] || [];
		const checked = !!session.checked[id];
		const isExam = session.mode === "exam";
		const isLast = session.currentIndex === session.ids.length - 1;
		const good = checked && accurate(id);
		const progress = session.ids.filter(answered).length;

		const opts = x.options.map((t, n) => {
			let status = "";
			if (checked) {
				if (x.correctAnswers.includes(n) && v.includes(n)) status = " good";
				else if (x.correctAnswers.includes(n)) status = " missing";
				else if (v.includes(n)) status = " bad";
			} else if (v.includes(n)) {
				status = " selected";
			}
			return `<button class="option${status}" data-action="pick" data-value="${n}" aria-pressed="${v.includes(n)}" ${checked ? "disabled" : ""}>
				<span class="letter">${LETTERS[n]}</span><span>${esc(t)}</span>
			</button>`;
		}).join("");

		let fb = "";
		if (checked) {
			const src = x.source;
			fb = `<div class="feedback ${good ? "correct" : "wrong"}" role="status">
				<strong>${good ? "Correct — well reasoned." : "Not quite — review the reasoning."}</strong>
				<p>${esc(x.explanation)}</p>
				<a href="${esc(src.url)}" target="_blank" rel="noopener noreferrer">Study source: ${esc(src.label)} ↗</a>
			</div>`;
		}

		const main = `
			<div class="qhead">
				<span>Question ${session.currentIndex + 1} of ${session.ids.length} · ${esc(session.mode.toUpperCase())}</span>
				<span>${progress} answered</span>
			</div>
			<div class="progress" aria-label="Progress"><i style="width:${pct(session.currentIndex + 1, session.ids.length)}%"></i></div>
			<div class="panel question" style="margin-top:16px">
				<span class="badge">${x.domain} · ${esc(domains[x.domain].name)}</span>
				<span class="muted small" style="margin-left:8px">${esc(x.topic)}</span>
				<h2>${esc(x.question)}</h2>
				<p class="hint">${x.correctAnswers.length === 1 ? "Select ONE answer." : `Select exactly ${x.correctAnswers.length} answers.`} ${isExam ? "Your choices stay editable until you submit." : " Check your answer to see the explanation."}</p>
				${opts}${fb}
				<div class="actions">
					${session.currentIndex > 0 ? `<button class="ghost" data-action="prev">← Previous</button>` : ""}
					${isExam ? `
						<button class="ghost" data-action="flag">${session.flags.includes(id) ? "⚑ Flagged" : "⚐ Flag for review"}</button>
						<button class="primary" data-action="next">${isLast ? "Go to review" : "Next →"}</button>
					` : checked ? `
						<button class="primary" data-action="next">${isLast ? "Finish session" : "Next question →"}</button>
					` : `
						<button class="primary" data-action="check" ${v.length === x.correctAnswers.length ? "" : "disabled"}>Check answer</button>
					`}
				</div>
			</div>
		`;

		const grid = session.ids.map((qid, k) => {
			let cls = "";
			if (k === session.currentIndex) cls += " current";
			if (answered(qid)) cls += " answered";
			if (session.flags.includes(qid)) cls += " flagged";
			return `<button class="qchip${cls}" data-action="jump" data-value="${k}" title="Question ${k + 1}">${k + 1}</button>`;
		}).join("");

		const side = `<aside class="panel side">
			<h3>${isExam ? "Timed assessment" : "Study session"}</h3>
			${isExam ? `
				<div id="clock" class="clock">${clockText()}</div>
				<p class="small muted">Time remaining</p>
			` : `
				<p class="small muted">Immediate rationale and primary-source references after each answer.</p>
			`}
			<div class="small muted">${progress}/${session.ids.length} answered · ${session.flags.length} flagged</div>
			<div class="qgrid">${grid}</div>
			${isExam ? `<button class="ghost" data-action="finish">Submit mock exam</button>` : `<button class="ghost" data-action="home">Pause & go home</button>`}
		</aside>`;

		app.innerHTML = `<div class="split"><div>${main}</div>${side}</div>`;
	}

	function clockText() {
		if (!session?.deadline) return "";
		const t = Math.max(0, Math.ceil((session.deadline - Date.now()) / 1000));
		return `${String(Math.floor(t / 3600)).padStart(2, "0")}:${String(Math.floor((t % 3600) / 60)).padStart(2, "0")}:${String(t % 60).padStart(2, "0")}`;
	}

	function tick() {
		if (!session || session.submitted || session.mode !== "exam") return;
		const e = document.getElementById("clock");
		if (e) {
			e.textContent = clockText();
			e.classList.toggle("warn", session.deadline - Date.now() < 600000);
		}
		if (session.deadline && Date.now() >= session.deadline) finish(true);
	}

	// --- Finish ---
	function finish(timed) {
		if (!session || session.submitted) return;
		session.submitted = true;
		session.timedOut = timed;
		session.finished = Date.now();
		for (const id of session.ids) {
			if (answered(id) && !session.checked[id]) remember(id, accurate(id));
		}
		persist();
		results();
		window.scrollTo({ top: 0, behavior: "smooth" });
	}

	// --- Results view ---
	function results() {
		if (!session) return home();
		const ids = session.ids;
		const correctIds = ids.filter(id => answered(id) && accurate(id));
		const score = pct(correctIds.length, ids.length);

		const rows = Object.entries(config.domains).map(([d, info]) => {
			const list = ids.filter(id => byId[id].domain === d);
			if (!list.length) return "";
			const ok = list.filter(id => correctIds.includes(id)).length;
			return `<div class="panel domainRow"><span>${d} · ${esc(info.name)}</span><strong>${ok}/${list.length} (${pct(ok, list.length)}%)</strong></div>`;
		}).join("");

		const rev = ids.map((id, k) => {
			const q = byId[id];
			const v = session.answers[id] || [];
			const ok = accurate(id) && answered(id);
			return `<details class="panel review">
				<summary><span class="badge">${q.domain}</span> ${k + 1}. ${ok ? "✓" : "✕"} ${esc(q.question)}</summary>
				<div class="small muted" style="margin:9px 0">Your selection: ${v.length ? v.map(n => LETTERS[n]).join(", ") : "Unanswered"} · Correct: ${q.correctAnswers.map(n => LETTERS[n]).join(", ")}</div>
				${q.options.map((t, n) => {
					let cls = "";
					if (q.correctAnswers.includes(n)) cls = " good";
					else if (v.includes(n)) cls = " bad";
					return `<div class="option${cls}"><span class="letter">${LETTERS[n]}</span><span>${esc(t)}</span></div>`;
				}).join("")}
				<p>${esc(q.explanation)}</p>
				<a href="${esc(q.source.url)}" target="_blank" rel="noopener noreferrer">${esc(q.source.label)} ↗</a>
			</details>`;
		}).join("");

		app.innerHTML = `
			<div class="results">
				<div class="panel padded">
 				<h2>${session.mode === "exam" ? "Mock exam results" : "Practice session results"}${session.timedOut ? " · time expired" : ""}</h2>
					<div class="score" style="margin:12px 0">
						<div class="ring" style="--score:${score}%">
							<span>${score}%</span>
						</div>
						<div>
							<h1 style="font-size:36px;margin:0 0 6px">${correctIds.length} / ${ids.length} correct</h1>
							<p class="muted" style="margin:0">Unofficial practice score · not equivalent to the scaled passing score.</p>
						</div>
					</div>
					<div class="actions">
						<button class="primary" data-action="home">Back to dashboard</button>
						<button class="ghost" data-action="start-weak">Retake missed questions</button>
						<button class="ghost" data-action="start-exam">New mock exam</button>
					</div>
				</div>
				<section class="section">
					<h2>Performance by domain</h2>
					<div class="domainGrid">${rows}</div>
				</section>
				<section class="section">
					<h2>Review every answer</h2>
					<p class="muted">Open an item to see the correct option, rationale and primary documentation.</p>
					${rev}
				</section>
			</div>
		`;
	}

	// --- Exam review ---
	function examReview() {
		const un = session.ids.filter(id => !answered(id)).length;
			app.innerHTML = `<div class="panel padded results">
				<h1>Review your answer sheet.</h1>
			<p class="lead">${session.ids.length - un} answered · ${un} unanswered · ${session.flags.length} flagged. Time remaining: ${clockText()}.</p>
			<div class="actions">
				<button class="ghost" data-action="back-to-exam">Review questions</button>
				<button class="primary" data-action="finish">Submit and score</button>
			</div>
		</div>`;
	}

	// --- Render ---
	function render() {
		if (session && !session.submitted) question();
		else if (session?.submitted) results();
		else home();
		tick();
	}

	// --- Event handling ---
	document.addEventListener("click", event => {
		const el = event.target.closest("[data-action]");
		if (!el) return;
		event.preventDefault();
		const action = el.dataset.action;

		if (action === "theme") {
			const dark = document.documentElement.dataset.theme === "dark";
			document.documentElement.dataset.theme = dark ? "light" : "dark";
			return;
		}
		if (action === "home") {
			if (session?.submitted) session = null;
			persist();
			return home();
		}
		if (action === "resume") return render();
		if (action === "reset-stats") {
			if (confirm("Reset all saved practice history?")) {
				saved.stats = {};
				persist();
				home();
			}
			return;
		}
		if (action === "start-practice") {
			const d = document.getElementById("domain")?.value || "all";
			const n = +document.getElementById("amount")?.value || 20;
			return start("practice", d, n);
		}
		if (action === "start-exam") return start("exam");
		if (action === "start-weak") return start("weak");
		if (!session || session.submitted) return;

		const id = session.ids[session.currentIndex];
		const q = byId[id];

		if (action === "pick") {
			if (session.checked[id]) return;
			const n = +el.dataset.value;
			const vals = session.answers[id] || [];
			if (q.correctAnswers.length === 1) {
				session.answers[id] = [n];
			} else {
				session.answers[id] = vals.includes(n)
					? vals.filter(x => x !== n)
					: vals.length >= q.correctAnswers.length ? [...vals.slice(1), n] : [...vals, n];
			}
			persist();
			return question();
		}
		if (action === "check") {
			if ((session.answers[id] || []).length !== q.correctAnswers.length) return;
			session.checked[id] = true;
			remember(id, accurate(id));
			persist();
			return question();
		}
		if (action === "prev") {
			session.currentIndex = Math.max(0, session.currentIndex - 1);
			persist();
			return question();
		}
		if (action === "next") {
			session.currentIndex++;
			persist();
			if (session.currentIndex >= session.ids.length) {
				if (session.mode === "exam") return examReview();
				return finish();
			}
			return question();
		}
		if (action === "jump") {
			if (session.mode !== "exam" && !session.checked[id]) return;
			session.currentIndex = +el.dataset.value;
			persist();
			return question();
		}
		if (action === "flag") {
			session.flags = session.flags.includes(id)
				? session.flags.filter(x => x !== id)
				: [...session.flags, id];
			persist();
			return question();
		}
		if (action === "finish") {
			if (confirm("Submit your mock exam and reveal the answers?")) finish(false);
		}
	});

	// Back to exam from review
	document.addEventListener("click", e => {
		if (e.target.closest('[data-action="back-to-exam"]')) {
			e.preventDefault();
			session.currentIndex = 0;
			persist();
			question();
		}
	});

	// Keyboard shortcuts
	document.addEventListener("keydown", e => {
		if (!session || session.submitted || e.altKey || e.metaKey || e.ctrlKey) return;
		if (/INPUT|SELECT|TEXTAREA/.test(document.activeElement?.tagName || "")) return;
		if ("1234".includes(e.key) && e.key.length === 1) {
			const b = app.querySelector(`[data-action="pick"][data-value="${+e.key - 1}"]`);
			if (b && !b.disabled) b.click();
		} else if (e.key === "Enter" && document.activeElement === document.body) {
			const b = app.querySelector('[data-action="check"]:not(:disabled),[data-action="next"]');
			if (b) b.click();
		}
	});

	// Timer tick
	setInterval(tick, 1000);

	// Initial render
	render();
})();
</script>
