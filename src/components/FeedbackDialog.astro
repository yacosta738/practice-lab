---
import { PUBLIC_FEEDBACK_GITHUB_REPO, PUBLIC_FEEDBACK_TALLY_URL } from "astro:env/client";
import pkg from "../../package.json";

const appVersion = pkg.version;
const tallyUrl = PUBLIC_FEEDBACK_TALLY_URL ?? "";
const githubRepo = PUBLIC_FEEDBACK_GITHUB_REPO ?? "yacosta738/practice-lab";
const hasTally = tallyUrl.trim().length > 0;
---

<dialog
	id="pl-feedback-dialog"
	class="pl-dialog pl-feedback-dialog"
	closedby="any"
	aria-labelledby="pl-feedback-title"
	data-app-version={appVersion}
	data-tally-url={tallyUrl}
	data-github-repo={githubRepo}
>
	<div class="pl-dialog-head pl-feedback-head">
		<div>
			<h2 id="pl-feedback-title" class="pl-feedback-title">Report an issue</h2>
			<p id="pl-feedback-context" class="pl-feedback-context">Practice Lab · Application</p>
		</div>
		<form method="dialog">
			<button type="submit" class="ghost pl-feedback-close">Close</button>
		</form>
	</div>

	<div class="pl-dialog-body pl-feedback-body">
		<p id="pl-feedback-error" class="pl-feedback-error" role="alert" hidden></p>
		<button type="button" id="pl-feedback-retry" class="ghost" hidden>
			Retry loading feedback form
		</button>

		<form id="pl-feedback-form" class="pl-feedback-form" novalidate hidden>
			<div class="pl-feedback-field">
				<label for="pl-feedback-category">Category</label>
				<select
					id="pl-feedback-category"
					name="category"
					class="pl-feedback-control"
					required
				></select>
				<p id="pl-feedback-category-hint" class="pl-feedback-hint"></p>
			</div>

			<div class="pl-feedback-field">
				<label for="pl-feedback-description">
					What needs attention? <span class="pl-feedback-required" aria-hidden="true">*</span>
				</label>
				<textarea
					id="pl-feedback-description"
					name="description"
					class="pl-feedback-control"
					rows="4"
					minlength="10"
					maxlength="4000"
					required
					placeholder="Describe the error, ambiguity, or improvement..."
				></textarea>
			</div>

			<div class="pl-feedback-field">
				<label for="pl-feedback-correction">
					Suggested correction <span class="pl-feedback-optional">(optional)</span>
				</label>
				<textarea
					id="pl-feedback-correction"
					name="suggestedCorrection"
					class="pl-feedback-control"
					rows="2"
					maxlength="2000"
					placeholder="Propose updated wording, answer key, or explanation..."
				></textarea>
			</div>

			<div class="pl-feedback-field">
				<label for="pl-feedback-reference">
					Official documentation URL <span class="pl-feedback-optional">(optional)</span>
				</label>
				<input
					id="pl-feedback-reference"
					name="referenceUrl"
					type="url"
					class="pl-feedback-control"
					placeholder="https://docs.anthropic.com/..."
				>
			</div>

			<p class="pl-feedback-notice">
				No account or personal data is required. Please do not share confidential official exam
				questions. Your active session stays untouched.
			</p>

			<div class="pl-feedback-actions">
				<button type="button" id="pl-feedback-clear-draft" class="ghost pl-feedback-btn-sm" hidden>
					Clear draft
				</button>
				<div class="pl-feedback-submit-group">
					{hasTally ? (
						<>
							<button type="button" class="ghost" data-feedback-channel="github-issue">
								Open GitHub Issue ↗
							</button>
							<button type="submit" class="primary" data-feedback-channel="tally">
								Continue in Tally ↗
							</button>
						</>
					) : (
						<button type="submit" class="primary" data-feedback-channel="github-issue">
							Open GitHub Issue ↗
						</button>
					)}
				</div>
			</div>
		</form>

		<div id="pl-feedback-handoff" class="pl-feedback-handoff" hidden>
			<div class="pl-feedback-handoff-box" role="status" aria-live="polite">
				<strong id="pl-feedback-handoff-heading">Report prepared in a new tab</strong>
				<p id="pl-feedback-handoff-copy">
					Finish submitting the pre-filled form in the new tab so your feedback is recorded.
				</p>
				<p class="pl-feedback-handoff-meta">
					Reference ID: <code id="pl-feedback-handoff-id"></code>
				</p>
				<a
					id="pl-feedback-handoff-link"
					class="pl-feedback-handoff-link"
					href={`https://github.com/${githubRepo}/issues/new`}
					target="_blank"
					rel="noopener noreferrer"
				>
					Open pre-filled report link ↗
				</a>
			</div>

			<div class="pl-feedback-actions">
				<button type="button" id="pl-feedback-edit-again" class="ghost">Edit report</button>
				<button type="button" id="pl-feedback-done" class="primary">Return to Practice Lab</button>
			</div>
		</div>
	</div>
</dialog>

<script>
import type {
	FeedbackDialogController,
	OpenFeedbackDetail,
} from "../lib/feedback/dialog-controller";

(function () {
	const dialog = document.getElementById("pl-feedback-dialog") as HTMLDialogElement | null;
	if (!dialog) return;
	const dialogEl = dialog;

	let controllerPromise: Promise<FeedbackDialogController> | undefined;
	const formEl = document.getElementById("pl-feedback-form") as HTMLFormElement | null;
	const retryButton = document.getElementById("pl-feedback-retry") as HTMLButtonElement | null;
	let retryControllerAction: (() => Promise<void>) | undefined;
	let controllerActionGeneration = 0;

	function loadController() {
		if (!controllerPromise) {
			controllerPromise = import("../lib/feedback/dialog-controller")
				.then(({ createFeedbackDialogController }) => createFeedbackDialogController(dialogEl))
				.catch((error) => {
					controllerPromise = undefined;
					throw error;
				});
		}
		return controllerPromise;
	}

	function showLoadError(generation: number) {
		if (generation !== controllerActionGeneration) return;
		const errorEl = document.getElementById("pl-feedback-error");
		if (formEl) formEl.hidden = true;
		if (errorEl) {
			errorEl.textContent = "Unable to load the feedback form right now. Please try again.";
			errorEl.hidden = false;
		}
		if (retryButton) retryButton.hidden = false;
		if (!dialogEl.open && typeof dialogEl.showModal === "function") {
			dialogEl.showModal();
		}
	}

	function runControllerAction(action: (controller: FeedbackDialogController) => void) {
		const generation = ++controllerActionGeneration;
		const attempt = async (retrying = false) => {
			try {
				const controller = await loadController();
				// The dialog closes synchronously, before the queued close event.
				if (generation !== controllerActionGeneration || (retrying && !dialogEl.open)) return;
				action(controller);
				if (retryButton) retryButton.hidden = true;
				retryControllerAction = undefined;
			} catch {
				if (!retrying || dialogEl.open) showLoadError(generation);
			}
		};
		retryControllerAction = () => attempt(true);
		void attempt();
	}

	dialogEl.addEventListener("close", () => {
		controllerActionGeneration += 1;
		retryControllerAction = undefined;
	});

	retryButton?.addEventListener("click", () => {
		if (retryControllerAction) void retryControllerAction();
	});

	document.addEventListener("click", (event) => {
		const target = event.target instanceof Element ? event.target : null;
		const trigger = target?.closest<HTMLElement>("[data-pl-open-feedback]");
		if (!trigger) return;
		event.preventDefault();
		runControllerAction((controller) => controller.openFromTrigger(trigger));
	});

	window.addEventListener("practice-lab:open-feedback", (event) => {
		const custom = event as CustomEvent<OpenFeedbackDetail>;
		if (custom.detail?.target) {
			runControllerAction((controller) => controller.open(custom.detail));
		}
	});
})();
</script>
