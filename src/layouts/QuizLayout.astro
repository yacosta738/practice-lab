---
import AppShell, { type SidebarDomain } from "../components/AppShell.astro";
import Layout from "./Layout.astro";
import "../styles/tokens.css";
import "../styles/quiz.css";

interface Props {
	title: string;
	subtitle: string;
	slug: string;
	description?: string;
	studyHref?: string;
	domains?: SidebarDomain[];
	theme?: {
		brand: string;
		brand2: string;
		brandSoft: string;
	};
}

const { title, subtitle, slug, description, domains = [] } = Astro.props;
const activeNav = Astro.url.searchParams.get("mode") === "assess" ? "assess" : "practice";
const breadcrumb = activeNav === "assess" ? "Assess · Mock exam" : "Practice · Questions";
---

<Layout title={`${title} | ${subtitle}`} description={description}>
	<AppShell
		activeNav={activeNav}
		activeCertSlug={slug}
		activeCertCode={subtitle}
		breadcrumb={breadcrumb}
		domains={domains}
		footerText="Independent study material · Progress stays in your browser"
	>
		<div id="app" aria-live="polite">
			<slot>
				<h1>{title} practice questions</h1>
				{description && <p>{description}</p>}
				<p class="muted">Enable JavaScript to start the interactive practice session.</p>
			</slot>
		</div>
	</AppShell>

	<dialog
		id="pl-confirm-dialog"
		class="pl-confirm-dialog"
		closedby="any"
		aria-labelledby="pl-confirm-title"
	>
		<h2 id="pl-confirm-title">Confirm action</h2>
		<p id="pl-confirm-message"></p>
		<form method="dialog" class="pl-confirm-actions">
			<button type="submit" value="cancel" class="ghost" autofocus>Cancel</button>
			<button type="submit" value="confirm" id="pl-confirm-ok" class="primary">Continue</button>
		</form>
	</dialog>
</Layout>
