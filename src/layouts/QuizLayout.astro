---
import { base } from "../lib/base";
import Layout from "./Layout.astro";
import "../styles/quiz.css";

interface Props {
	title: string;
	subtitle: string;
	description?: string;
	studyHref?: string;
	theme: {
		brand: string;
		brand2: string;
		brandSoft: string;
	};
}

const { title, subtitle, description, studyHref, theme } = Astro.props;

// Astro does not interpolate expressions inside is:inline scripts, so the
// theme values are injected through define:vars (object form) and applied as
// inline custom properties, which win over the design tokens in quiz.css.
---

<Layout title={`${title} · Practice Lab`} description={description}>
	<script define:vars={{ theme }} is:inline>
	(function () {
		const root = document.documentElement;
		root.style.setProperty("--brand", theme.brand);
		root.style.setProperty("--brand2", theme.brand2);
		root.style.setProperty("--brandSoft", theme.brandSoft);
	})();
	</script>

	<main>
		<header>
			<a class="brand" href={base} data-action="go-to-site-home">
				<div class="mark">C</div>
				<span>
					<strong>{title}</strong>
					<small>{subtitle}</small>
				</span>
			</a>
			<div class="navActions">
				{studyHref && (
					<a class="ghost" href={studyHref}>
						Study notes
					</a>
				)}
				<button
					type="button"
					class="ghost"
					data-action="theme"
					aria-label="Theme: toggle light and dark appearance"
				>
					Theme
				</button>
			</div>
		</header>
		<div id="app" aria-live="polite"></div>
		<footer>Independent study material · Progress stays in your browser</footer>
	</main>
</Layout>
