---
import { base } from "../lib/base";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { title, description = "Practice quiz for certification preparation", ogImage } = Astro.props;

// Build canonical URL preserving the served path (including trailing slash)
const canonicalUrl = `${Astro.url.protocol}//${Astro.url.host}${Astro.url.pathname}`;

// Default OG image resolved against the site origin so og:image and twitter:image
// always carry an absolute URL as required by the Open Graph protocol.
const defaultOgImage = new URL(`${base}og-image.png`, Astro.site).href;
const ogImageUrl = ogImage || defaultOgImage;
const isDefaultImage = !ogImage;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content={description}>
		<link rel="canonical" href={canonicalUrl}>

		<!-- Favicon set -->
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`}>
		<link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`}>
		<link rel="shortcut icon" href={`${base}favicon.ico`}>
		<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`}>
		<link rel="manifest" href={`${base}manifest.json`}>

		<!-- Theme colors -->
		<meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#101827" media="(prefers-color-scheme: dark)">
		<meta name="color-scheme" content="light dark">

		<meta name="generator" content={Astro.generator}>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={ogImageUrl}>
		{isDefaultImage && (
			<>
				<meta property="og:image:width" content="1200">
				<meta property="og:image:height" content="630">
			</>
		)}
		<meta property="og:image:alt" content={isDefaultImage ? "Practice Lab logo" : title}>
		<meta property="og:type" content="website">
		<meta property="og:locale" content="en_US">

		<!-- Twitter/X Card -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={ogImageUrl}>
		<meta name="twitter:image:alt" content={isDefaultImage ? "Practice Lab logo" : title}>

		<!-- Referrer policy hint (server header is preferred) -->
		<meta name="referrer" content="strict-origin-when-cross-origin">
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
html,
body {
	margin: 0;
	width: 100%;
	height: 100%;
}
</style>
