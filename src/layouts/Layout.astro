---
import Analytics from "@vercel/analytics/astro";
import AhrefsAnalytics from "../components/Analytics.astro";
import { base } from "../lib/base";

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { title, description = "Practice quiz for certification preparation", ogImage } = Astro.props;
const isVercelDeployment = process.env.VERCEL === "1";

// Build canonical URL preserving the served path (including trailing slash)
const canonicalUrl = `${Astro.url.protocol}//${Astro.url.host}${Astro.url.pathname}`;

// Default OG image resolved against the site origin so og:image and twitter:image
// always carry an absolute URL as required by the Open Graph protocol.
const defaultOgImage = new URL(`${base}assets/practice-lab-confidence.png`, Astro.site).href;
const ogImageUrl = ogImage || defaultOgImage;
const isDefaultImage = !ogImage;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content={description}>
		<meta
			name="ahrefs-site-verification"
			content="f0878cbe1b451452cc668e612e8330b4023f39c1218d86066ac42c2005970243"
		>
		<link rel="canonical" href={canonicalUrl}>

		<!-- Favicon set -->
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`}>
		<link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`}>
		<link rel="shortcut icon" href={`${base}favicon.ico`}>
		<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`}>
		<link rel="manifest" type="application/manifest+json" href={`${base}manifest.json`}>
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-title" content="Practice Lab">

		<!-- Theme colors -->
		<meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#101827" media="(prefers-color-scheme: dark)">
		<meta name="color-scheme" content="light dark">
		<script is:inline>
		// Restore persisted theme override before first paint to prevent FOUC
		try {
			const stored = localStorage.getItem("practice-lab-theme");
			const meta = document.querySelector('meta[name="color-scheme"]');
			if (meta && (stored === "dark" || stored === "light")) {
				meta.content = stored;
			}
		} catch {}
		</script>

		<meta name="generator" content={Astro.generator}>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={ogImageUrl}>
		{isDefaultImage && (
			<>
				<meta property="og:image:width" content="1734">
				<meta property="og:image:height" content="907">
			</>
		)}
		<meta
			property="og:image:alt"
			content={isDefaultImage ? "Practice Lab — Prepare with confidence" : title}
		>
		<meta property="og:type" content="website">
		<meta property="og:locale" content="en_US">

		<!-- Twitter/X Card -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={ogImageUrl}>
		<meta
			name="twitter:image:alt"
			content={isDefaultImage ? "Practice Lab — Prepare with confidence" : title}
		>

		<!-- Referrer policy hint (server header is preferred) -->
		<meta name="referrer" content="strict-origin-when-cross-origin">
		{isVercelDeployment && <Analytics />}
		<AhrefsAnalytics />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<slot />
		<script is:inline>
		// Unified OS-aware two-state theme toggle + cross-tab storage sync
		(function () {
			const STORAGE_KEY = "practice-lab-theme";
			const getMeta = () => document.querySelector('meta[name="color-scheme"]');

			function applyStoredTheme() {
				const meta = getMeta();
				if (!meta) return;
				try {
					const stored = localStorage.getItem(STORAGE_KEY);
					meta.content = stored === "dark" || stored === "light" ? stored : "light dark";
				} catch {
					meta.content = "light dark";
				}
			}

			document.addEventListener("click", (event) => {
				const el =
					event.target instanceof Element ? event.target.closest('[data-action="theme"]') : null;
				if (!el) return;
				event.preventDefault();
				const meta = getMeta();
				if (!meta) return;

				const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				const currentDark = meta.content === "dark" || (meta.content !== "light" && systemDark);
				const target = currentDark ? "light" : "dark";
				const matchesSystem = (target === "dark") === systemDark;

				if (matchesSystem) {
					meta.content = "light dark";
					try {
						localStorage.removeItem(STORAGE_KEY);
					} catch {}
				} else {
					meta.content = target;
					try {
						localStorage.setItem(STORAGE_KEY, target);
					} catch {}
				}
			});

			window.addEventListener("storage", (event) => {
				if (event.key === STORAGE_KEY) applyStoredTheme();
			});
		})();
		</script>
		<script>
		if (import.meta.env.PROD && "serviceWorker" in navigator) {
			const baseUrl = import.meta.env.BASE_URL.endsWith("/")
				? import.meta.env.BASE_URL
				: `${import.meta.env.BASE_URL}/`;
			window.addEventListener("load", () => {
				void navigator.serviceWorker.register(`${baseUrl}sw.js`).catch((error) => {
					console.error("Service worker registration failed:", error);
				});
			});
		}
		</script>
	</body>
</html>

<style>
html,
body {
	margin: 0;
	width: 100%;
	height: 100%;
}
</style>
