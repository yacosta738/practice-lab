---
import AppShell, { type SidebarDomain } from "../components/AppShell.astro";
import Layout from "./Layout.astro";
import "../styles/tokens.css";
import "../styles/quiz.css";
import "../styles/study.css";

interface Props {
	title: string;
	description?: string;
	activeCertSlug?: string;
	activeCertCode?: string;
	breadcrumb?: string;
	domains?: SidebarDomain[];
}

const {
	title,
	description,
	activeCertSlug = "ccdv-f",
	activeCertCode,
	breadcrumb = title,
	domains = [],
} = Astro.props;
---

<Layout title={`${title} · Study · Practice Lab`} description={description}>
	<AppShell
		activeNav="study"
		activeCertSlug={activeCertSlug}
		activeCertCode={activeCertCode}
		breadcrumb={breadcrumb}
		domains={domains}
		footerText="Personal study notes · Independent study material"
		wide={true}
	>
		<slot />
	</AppShell>
</Layout>
