{
	"name": "practice-lab",
	"type": "module",
	"version": "0.2.0",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "biome check . && astro check",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:a11y": "playwright test",
		"sync:study": "node scripts/sync-study.mjs",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"astro": "^7.4.12"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.8",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@playwright/test": "1.65.1",
		"@types/node": "^26.6.6",
		"lefthook": "^2.2.2",
		"typescript": "^6.0.3",
		"vitest": "5.1.0"
	}
}
