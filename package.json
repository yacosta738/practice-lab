{
	"name": "practice-lab",
	"type": "module",
	"version": "0.7.0",
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"browserslist": [
		"Chrome >= 123",
		"Edge >= 123",
		"Firefox >= 121",
		"Safari >= 17.5",
		"ios_saf >= 17.5",
		"and_chr >= 123",
		"and_ff >= 121"
	],
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"check:study-links": "node scripts/check-study-links.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"check": "biome check . && astro check",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:a11y": "playwright test",
		"test:vercel-smoke": "playwright test --config=playwright.vercel.config.ts",
		"sync:study": "node scripts/sync-study.mjs",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@oddbird/css-anchor-positioning": "0.10.2",
		"@oddbird/popover-polyfill": "0.7.3",
		"@vercel/analytics": "^2.0.1",
		"astro": "^7.4.13",
		"idb": "8.0.4",
		"interestfor": "1.0.14"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/markdown-satteri": "0.4.10",
		"@astrojs/partytown": "2.1.9",
		"@astrojs/sitemap": "3.7.6",
		"@astrojs/vercel": "11.0.22",
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.9",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"acorn": "8.19.0",
		"entities": "9.0.0",
		"esbuild": "0.28.2",
		"fake-indexeddb": "6.2.8",
		"lefthook": "2.2.2",
		"satteri": "0.11.7",
		"typescript": "6.0.3",
		"vitest": "5.1.1"
	}
}
